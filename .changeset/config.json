{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "interfaces-lab/nyte"
    }
  ],
  "commit": false,
  "access": "public",
  "baseBranch": "main",
  "fixed": [
    [
      "@nyte-ai/schema",
      "@nyte-ai/ai",
      "@nyte-ai/core",
      "@nyte-ai/plugin",
      "@nyte-ai/protocol",
      "@nyte-ai/host",
      "@nyte-ai/sdk",
      "nyte-ai",
      "@nyte-ai/tui",
      "@nyte-ai/desktop",
      "@nyte-ai/ios",
      "@nyte-ai/example-cloudflare",
      "@nyte-ai/example-vercel"
    ]
  ],
  "privatePackages": {
    "version": true,
    "tag": false
  },
  "ignore": [
    "@nyte-ai/app",
    "@nyte-ai/bench",
    "@nyte-ai/canvas",
    "@nyte-ai/connect",
    "@nyte-ai/connect-worker",
    "@nyte-ai/lab",
    "@nyte-ai/service",
    "@nyte-ai/ui",
    "@nyte-ai/web",
    "@nyte-ai/example-tui-chat"
  ]
}

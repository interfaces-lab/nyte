{
  "name": "@nyte-ai/vt",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal emulation for Nyte: a typed binding over Ghostty's libghostty-vt WebAssembly build, pinned to one signed tip artifact.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ghostty-vt.wasm": "./ghostty-vt.wasm"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "update": "node scripts/update.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

{
  "name": "@nyte-ai/service",
  "private": true,
  "description": "The local Nyte service: one long-running host per user that every local client connects to, which also owns this machine's Nyte Connect link.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "test": "vitest --run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

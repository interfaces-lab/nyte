{
  "name": "@nyte-ai/service",
  "private": true,
  "description": "Nyte Connect sharing for a local Nyte process: the routes its own host listener serves and the relay election that lets one process at a time carry this machine's relay.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "test": "vitest --run",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

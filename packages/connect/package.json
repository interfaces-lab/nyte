{
  "name": "@nyte-ai/connect",
  "private": true,
  "description": "The Nyte Connect contract: broker and desktop routes, their schemas, relay addresses and framing, and a broker client. Node-free; the signing and relay entries are for the broker and desktop only.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./signing": "./src/signing.ts",
    "./relay": "./src/relay.ts",
    "./enrollment": "./src/enrollment.ts",
    "./account-config": "./src/account-config.ts",
    "./host": "./src/host/index.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "jose": "6.2.12",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}

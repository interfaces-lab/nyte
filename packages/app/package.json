{
  "name": "@nyte-ai/app",
  "private": true,
  "description": "The Nyte interface: React screens over a NyteBridge the host supplies. The desktop carries the bridge over Electron IPC; the web app in src/web carries it over @nyte-ai/client.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dist/*": "./dist/*",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf node_modules .turbo dist",
    "dev": "vite",
    "e2e": "pnpm build && playwright test --config e2e/playwright.config.ts --project web",
    "e2e:desktop": "pnpm build && pnpm --dir ../desktop build && playwright test --config e2e/playwright.config.ts --project desktop",
    "e2e:all": "pnpm build && pnpm --dir ../desktop build && playwright test --config e2e/playwright.config.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lexical/history": "^0.51.0",
    "@lexical/link": "^0.51.0",
    "@lexical/plain-text": "^0.51.0",
    "@lobehub/streamdown": "1.3.1",
    "@nivo/core": "0.99.0",
    "@nivo/line": "0.99.0",
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@pierre/diffs": "1.4.1",
    "@pierre/trees": "1.0.0-beta.4",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.102.5",
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-virtual": "3.14.10",
    "beautiful-mermaid": "1.1.3",
    "central-icons": "npm:@central-icons-react/round-outlined-radius-2-stroke-1.5@^1.1.319",
    "ghostty-web": "github:anomalyco/ghostty-web#83c0a07b8628b748aed073b232cb4b52a6ca11c1",
    "lexical": "^0.51.0",
    "motion": "12.43.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "1.3.0",
    "shiki": "4.4.3",
    "torph": "0.1.3",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@playwright/test": "1.63.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^44.4.3",
    "typescript": "^7.0.2",
    "vite": "7.1.4",
    "vitest": "^5.0.1"
  }
}

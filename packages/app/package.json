    "./sidebar/sidebar-filter.tsx": "./src/sidebar/sidebar-filter.tsx",
    "./sidebar/sidebar-rows.tsx": "./src/sidebar/sidebar-rows.tsx",
    "./sidebar/sidebar.stylex.ts": "./src/sidebar/sidebar.stylex.ts",
    "./tabs/window-tab-strip.tsx": "./src/tabs/window-tab-strip.tsx",
    "./theme/boot.ts": "./src/theme/boot.ts",

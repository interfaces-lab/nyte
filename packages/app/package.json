{
  "name": "@nyte-ai/app",
  "private": true,
  "description": "The Nyte interface: React screens over a NyteBridge the host supplies. The desktop carries the bridge over Electron IPC; the web app in src/web carries it over @nyte-ai/sdk.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract/*": "./src/contract/*",
    "./account/appearance.tsx": "./src/account/appearance.tsx",
    "./chat/markdown/code.deferred.tsx": "./src/chat/markdown/code.deferred.tsx",
    "./chat/transcript/transcript-rows.ts": "./src/chat/transcript/transcript-rows.ts",
    "./chat/transcript/turn-view.tsx": "./src/chat/transcript/turn-view.tsx",
    "./chat/transcript/turns.ts": "./src/chat/transcript/turns.ts",
    "./components/connection-list.tsx": "./src/components/connection-list.tsx",
    "./components/file-type-icon.tsx": "./src/components/file-type-icon.tsx",
    "./components/task-mark.tsx": "./src/components/task-mark.tsx",
    "./data/catalog.ts": "./src/data/catalog.ts",
    "./data/query-client.ts": "./src/data/query-client.ts",
    "./lib/deferred-entries.ts": "./src/lib/deferred-entries.ts",
    "./lib/deferred.tsx": "./src/lib/deferred.tsx",
    "./preferences/index.ts": "./src/preferences/index.ts",
    "./settings/appearance.stylex.ts": "./src/settings/appearance.stylex.ts",
    "./settings/settings.stylex.ts": "./src/settings/settings.stylex.ts",
    "./shell/titlebar.stylex.ts": "./src/shell/titlebar.stylex.ts",
    "./sidebar/sidebar.stylex.ts": "./src/sidebar/sidebar.stylex.ts",
    "./tabs/window-tab-strip.tsx": "./src/tabs/window-tab-strip.tsx",
    "./theme/boot.ts": "./src/theme/boot.ts",
    "./theme/focus-modality.ts": "./src/theme/focus-modality.ts",
    "./theme/global.css": "./src/theme/global.css",
    "./theme/schema.stylex.ts": "./src/theme/schema.stylex.ts",
    "./theme/settings-patterns.stylex.ts": "./src/theme/settings-patterns.stylex.ts",
    "./vite": "./vite.ts",
    "./dist/*": "./dist/*",
    "./e2e/errors": "./e2e/utils/errors.ts",
    "./e2e/scenario-d": "./e2e/web/scenario-d.ts",
    "./e2e/scenario-u-fixture": "./e2e/web/scenario-u-fixture.ts",
    "./e2e/scenario-u-trace": "./e2e/web/scenario-u-trace.ts"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf node_modules .turbo dist",
    "dev": "vite",
    "e2e": "pnpm --dir ../canvas build && pnpm build && playwright test --config e2e/playwright.config.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@clerk/react": "^6.18.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@pierre/diffs": "^1.6.0",
    "@pierre/highlights": "^0.1.3",
    "@pierre/trees": "^1.0.0-beta.6",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-virtual": "^3.14.21",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "beautiful-mermaid": "^1.1.3",
    "ghostty-web": "github:anomalyco/ghostty-web#e91e38a9ceb13c566ddfa15185a9393849f712a9",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "motion": "^14.5.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "torph": "^0.1.3",
    "typebox": "^1.4.2",
    "use-sync-external-store": "^1.7.0"
  },
  "devDependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/bench": "workspace:*",
    "@nyte-ai/canvas": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "oxc-transform-react": "^0.155.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

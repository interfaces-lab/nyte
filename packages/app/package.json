{
  "name": "@nyte-ai/app",
  "private": true,
  "description": "The Nyte interface: React screens over a NyteBridge the host supplies. The desktop carries the bridge over Electron IPC; the web app in src/web carries it over @nyte-ai/sdk.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./vite.ts",
    "./dist/*": "./dist/*",
    "./e2e/errors": "./e2e/utils/errors.ts",
    "./e2e/scenario-d": "./e2e/web/scenario-d.ts",
    "./e2e/scenario-u-fixture": "./e2e/web/scenario-u-fixture.ts",
    "./e2e/scenario-u-trace": "./e2e/web/scenario-u-trace.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf node_modules .turbo dist",
    "dev": "vite",
    "e2e": "pnpm --dir ../canvas build && pnpm build && playwright test --config e2e/playwright.config.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@clerk/react": "6.17.5",
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lobehub/streamdown": "1.3.1",
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@pierre/diffs": "1.4.1",
    "@pierre/trees": "1.0.0-beta.4",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-virtual": "3.14.15",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "beautiful-mermaid": "1.1.3",
    "ghostty-web": "github:anomalyco/ghostty-web#83c0a07b8628b748aed073b232cb4b52a6ca11c1",
    "motion": "12.43.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.4.3",
    "torph": "0.1.3",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/bench": "workspace:*",
    "@nyte-ai/canvas": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "^44.9.0",
    "oxc-transform-react": "0.152.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}

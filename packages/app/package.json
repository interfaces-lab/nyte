    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remend": "1.4.0",
    "streamdown": "^2.7.1",
    "torph": "^0.1.3",
    "typebox": "^1.4.6",
    "use-sync-external-store": "^1.7.0",
    "web-tree-sitter": "0.25.10"

  "scripts": {
    "bench": "node bench/run.ts",
    "build": "vite build",
    "clean": "rm -rf node_modules .turbo dist",
    "dev": "vite",
    "e2e": "pnpm --dir ../canvas build && pnpm build && playwright test --config e2e/playwright.config.ts",
    "test": "vitest --run",
    "test:markdown-sweep": "NYTE_MARKDOWN_CORPUS=repository vitest --run --project unit src/workbench/editor/markdown-roundtrip.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e"
  },
  "dependencies": {

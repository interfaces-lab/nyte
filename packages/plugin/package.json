    "@nyte-ai/protocol": "workspace:*",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "zod": "4.5.4"
  },
  "engines": {
    "node": ">=26.4.0"
  }

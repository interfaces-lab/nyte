{
  "name": "@nyte-ai/plugin",
  "version": "0.0.16-dev.2",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/plugin"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openai-compaction": "./src/openai-compaction.ts",
    "./openai-astra-context": "./src/openai-astra-context.ts",
    "./mcp": "./src/mcp.ts",
    "./codemode": "./src/codemode.ts",
    "./codemode-runtime": "./src/codemode-runtime.ts",
    "./codemode-worker": "./src/codemode-worker.ts",
    "./provider": "./src/provider.ts",
    "./examples/bash-description": "./examples/bash-description.ts",
    "./examples/notifications": "./examples/notifications.ts",
    "./examples/question": "./examples/question.ts",
    "./examples/rename": "./examples/rename.ts",
    "./examples/web-search": "./examples/web-search/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {

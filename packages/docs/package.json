    "@nyte-ai/app": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "algoliasearch": "^5.61.0",
    "beautiful-mermaid": "^1.1.3",
    "cn": "^0.5.2",

{
  "name": "@nyte-ai/client",
  "version": "0.0.16-dev.2",
  "private": false,
  "description": "A typed Nyte client over fetch: the SDK namespaces as JSON calls and watch as an AsyncIterable over SSE. No core, no Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build:package": "bun ../../scripts/sdk-packages.mjs build client"
  },
  "dependencies": {
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "diff": "^9.0.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

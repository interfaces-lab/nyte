    "@remotion/cli": "4.0.535",
    "@remotion/media": "4.0.535",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react-grab": "0.2.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }

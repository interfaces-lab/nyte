{
  "name": "@nyte-ai/lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist .tanstack",
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.node.json",
    "video": "remotion studio video/src/index.ts --public-dir video/public",
    "video:render": "remotion render video/src/index.ts nyte video/out/nyte.mp4 --public-dir video/public --crf=16",
    "video:ending": "remotion render video/src/index.ts ending video/out/ending.mp4 --public-dir video/public --crf=16"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",

    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/geist-pixel": "5.3.0",
    "@nyte-ai/app": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@pierre/diffs": "1.4.1",
    "@remotion/player": "4.0.535",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "@xyflow/react": "12.12.0",
    "dialkit": "2.0.2",
    "motion": "13.4.0",

{
  "name": "@nyte-ai/lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist .tanstack",
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "video": "remotion studio video/src/index.ts --public-dir video/public",
    "video:voice": "node video/voice.ts",
    "video:render": "remotion render video/src/index.ts nyte video/out/nyte.mp4 --public-dir video/public --crf=16",
    "video:ending": "remotion render video/src/index.ts ending video/out/ending.mp4 --public-dir video/public --crf=16"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-pixel": "^5.3.0",
    "@nyte-ai/app": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@pierre/diffs": "^1.6.0",
    "@remotion/player": "^4.0.537",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "@xyflow/react": "^12.12.0",
    "dialkit": "^2.0.2",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@remotion/cli": "^4.0.537",
    "@remotion/media": "^4.0.537",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react-grab": "^0.2.0",
    "vite": "^8.3.5"
  }
}

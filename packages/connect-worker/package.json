{
  "name": "@nyte-ai/connect-worker",
  "private": true,
  "description": "The Nyte Connect broker: a Cloudflare Worker over D1 that links desktops to Clerk accounts, leases device access, and relays phone requests to each desktop through a Durable Object.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules .turbo .wrangler dist",
    "test": "vitest --run",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p test/tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.0",
    "@nyte-ai/connect": "workspace:*",
    "jose": "^6.2.13",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}

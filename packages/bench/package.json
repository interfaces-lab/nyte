{
  "name": "@nyte-ai/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Test bench for Nyte hosts: scripted fake models, recorded provider cassettes, scenario fixtures and a host simulation driven over stdio.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "simulate": "node scripts/simulate.ts",
    "test": "vitest --run",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

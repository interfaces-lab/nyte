{
  "name": "@nyte-ai/ios",
  "version": "0.0.24",
  "private": true,
  "description": "Nyte's native iOS companion for a remote Nyte host.",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "canvas:build": "pnpm --dir ../canvas build",
    "dev": "APP_VARIANT=development expo start --dev-client",
    "predev": "pnpm canvas:build",
    "ios": "APP_VARIANT=development expo run:ios --no-bundler",
    "ios:release": "expo run:ios --configuration Release --no-bundler",
    "preios:release": "pnpm canvas:build",
    "ios:build": "expo run:ios --configuration Release --no-bundler --no-install --output ./build/app",
    "preios:build": "pnpm canvas:build",
    "prebuild": "expo prebuild --platform ios --no-install",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --platform ios --no-install",
    "bundle": "expo export --platform ios --output-dir ./build/export",
    "prebundle": "pnpm canvas:build",
    "build:dev": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform ios --profile preview",
    "build:production": "eas build --platform ios --profile production",
    "eas-build-post-install": "pnpm canvas:build",
    "submit": "eas submit --platform ios --profile production",
    "test": "vitest --run",
    "typecheck": "pnpm icons:sync && pnpm canvas:build && tsc --noEmit",
    "icons:sync": "node scripts/sync-completion-icons.mjs"
  },
  "dependencies": {
    "@clerk/expo": "^4.13.1",
    "@expo/ui": "^58.0.21",
    "@legendapp/list": "^3.6.0",
    "@nyte-ai/canvas": "workspace:*",
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@use-voltra/ios": "^2.4.0",
    "@use-voltra/ios-client": "^2.4.0",
    "core-js": "^3.51.0",
    "expo": "^58.0.16",
    "expo-auth-session": "^58.0.13",
    "expo-blur": "^58.0.5",
    "expo-clipboard": "^58.0.3",
    "expo-constants": "^58.0.12",
    "expo-crypto": "^58.0.7",
    "expo-dev-client": "^58.0.14",
    "expo-glass-effect": "^58.0.4",
    "expo-image-manipulator": "^58.0.15",
    "expo-linking": "^58.0.13",
    "expo-media-library": "^58.0.11",
    "expo-router": "^58.0.24",
    "expo-secure-store": "^58.0.2",
    "expo-speech-recognition": "^58.0.0",
    "expo-status-bar": "^58.0.3",
    "expo-symbols": "^58.0.4",
    "expo-updates": "^58.0.17",
    "expo-web-browser": "^58.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.0",
    "react-native-enriched-markdown": "^1.2.0-nightly-20261019-926ef06f0",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-keyboard-controller": "^1.22.8",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-view-shot": "^6.1.1",
    "react-native-vision-camera": "^5.2.3",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.13.0",
    "react-strict-dom": "^0.0.55",
    "remend": "^1.4.0",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@types/react": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "^58.0.18",
    "central-icons": "npm:@central-icons-react/round-outlined-radius-2-stroke-1.5@^1.2.19",
    "vitest": "^5.0.5"
  },
  "enriched-markdown": {
    "codeHighlightLanguages": [
      "bash",
      "c",
      "c-sharp",
      "cpp",
      "css",
      "go",
      "html",
      "java",
      "javascript",
      "json",
      "markdown",
      "php",
      "python",
      "ruby",
      "rust",
      "swift",
      "tsx",
      "typescript",
      "yaml"
    ]
  }
}

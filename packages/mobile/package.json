{
  "name": "@nyte-ai/ios",
  "version": "0.1.0",
  "private": true,
  "description": "Nyte's native iOS companion for a remote Mac host.",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "APP_VARIANT=development expo start --dev-client",
    "ios": "APP_VARIANT=development expo run:ios --no-bundler",
    "ios:release": "expo run:ios --configuration Release --no-bundler",
    "ios:build": "expo run:ios --configuration Release --no-bundler --no-install --output ./build/app",
    "prebuild": "expo prebuild --platform ios --no-install",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --platform ios --no-install",
    "bundle": "expo export --platform ios --output-dir ./build/export",
    "build:dev": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform ios --profile preview",
    "build:production": "eas build --platform ios --profile production",
    "submit": "eas submit --platform ios --profile production",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/expo": "4.8.0",
    "@expo/ui": "57.0.21",
    "@legendapp/list": "3.3.11",
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@tanstack/react-query": "5.102.5",
    "@use-voltra/ios": "2.3.2",
    "@use-voltra/ios-client": "2.3.2",
    "expo": "57.0.26",
    "expo-auth-session": "57.0.13",
    "expo-blur": "57.0.3",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-glass-effect": "57.0.4",
    "expo-image-manipulator": "57.0.20",
    "expo-linking": "57.0.11",
    "expo-media-library": "57.0.5",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-speech-recognition": "57.1.0",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "expo-updates": "57.0.24",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-worklets": "0.10.1",
    "react-strict-dom": "0.0.55",
    "remend": "1.3.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@types/react": "19.2.18",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-expo": "57.0.13",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "enriched-markdown": {
    "codeHighlightLanguages": [
      "bash",
      "c",
      "c-sharp",
      "cpp",
      "css",
      "go",
      "html",
      "java",
      "javascript",
      "json",
      "markdown",
      "php",
      "python",
      "ruby",
      "rust",
      "swift",
      "tsx",
      "typescript",
      "yaml"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

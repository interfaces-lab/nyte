{
  "name": "@nyte-ai/tui",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build:binary": "rm -rf ../../bin && mkdir -p ../../bin && bun build --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv src/binary.ts --outfile ../../bin/nyte && codesign --force --sign - ../../bin/nyte",
    "clean": "rm -rf node_modules .turbo ../../bin",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@opentui/core": "^0.5.10",
    "@opentui/keymap": "^0.5.10",
    "diff": "9.0.0",
    "fuzzysort": "3.1.0",
    "open": "^11.0.2",
    "semver": "7.8.5",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/semver": "7.7.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}

{
  "name": "@nyte-ai/tui",
  "version": "0.0.20",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-binary.ts",
    "verify:targets": "bun scripts/verify-targets.ts",
    "package": "sh ../../scripts/package.sh",
    "clean": "rm -rf node_modules .turbo ../../bin",
    "dev": "bun --preload ./dev/preload.ts ./src/index.ts",
    "start": "bun src/binary.ts",
    "test": "bun test",
    "test:binary": "pnpm build && bun test ./qa/binary.smoke.ts",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/canvas": "workspace:*",
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "@nyte-ai/service": "workspace:*",
    "@opentui/core": "^0.6.6",
    "@opentui/keymap": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "beautiful-mermaid": "1.1.3",
    "diff": "9.0.0",
    "fuzzysort": "3.1.0",
    "marked": "17.0.1",
    "open": "^11.0.4",
    "semver": "7.8.5",
    "solid-js": "1.9.12",
    "string-width": "7.2.0",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@nyte-ai/bench": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@types/babel__core": "7.20.5",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/semver": "7.7.1",
    "babel-preset-solid": "1.9.12",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=26"
  }
}

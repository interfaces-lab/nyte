{
  "name": "@nyte-ai/tui",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-binary.ts",
    "verify:targets": "bun scripts/verify-targets.ts",
    "package": "sh ../../scripts/package.sh",
    "clean": "rm -rf node_modules .turbo ../../bin",
    "dev": "bun --watch src/binary.ts",
    "start": "bun src/binary.ts",
    "test": "pnpm build && node qa/run.mjs",
    "test:unit": "bun test test",
    "test:show": "pnpm build && node qa/run.mjs --show",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "@opentui/core": "^0.6.1",
    "@opentui/keymap": "^0.6.1",
    "@opentui/solid": "^0.6.1",
    "beautiful-mermaid": "1.1.3",
    "diff": "9.0.0",
    "fuzzysort": "3.1.0",
    "open": "^11.0.4",
    "opentui-spinner": "0.0.7",
    "semver": "7.8.5",
    "solid-js": "1.9.12",
    "string-width": "7.2.0",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/semver": "7.7.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26"
  }
}

{
  "name": "@nyte-ai/tui",
  "version": "0.0.9-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-binary.ts",
    "verify:targets": "bun scripts/verify-targets.ts",
    "package": "sh ../../scripts/package.sh",
    "clean": "rm -rf node_modules .turbo ../../bin",
    "dev": "bun --watch src/binary.ts",
    "start": "bun src/binary.ts",
    "test": "bun test src && pnpm build && node qa/run.mjs",
    "test:show": "pnpm build && node qa/run.mjs --show",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/telemetry": "workspace:*",
    "@opentui/core": "^0.5.11",
    "@opentui/keymap": "^0.5.11",
    "@opentui/solid": "0.5.11",
    "beautiful-mermaid": "1.1.3",
    "diff": "9.0.0",
    "fuzzysort": "3.1.0",
    "open": "^11.0.3",
    "opentui-spinner": "0.0.7",
    "semver": "7.8.5",
    "solid-js": "1.9.12",
    "string-width": "7.2.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "@types/semver": "7.7.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}

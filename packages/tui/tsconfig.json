{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2025"],
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "dev/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "qa/**/*.ts",
    "scripts/**/*.ts"
  ]
}

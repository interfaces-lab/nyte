{
  "expo": {
    "name": "Nyte",
    "slug": "nyte-ios",
    "version": "0.1.0",
    "icon": "../desktop/build/icon-ios.png",
    "orientation": "portrait",
    "scheme": "nyte",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "dev.nyte.ios",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Connect to the Nyte host on your Mac, over your local network or tailnet.",
        "NSCameraUsageDescription": "Take a photo to attach to a Nyte message.",
        "NSMicrophoneUsageDescription": "Use the microphone to dictate a Nyte task.",
        "NSSpeechRecognitionUsageDescription": "Use speech recognition to transcribe a Nyte task.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["nyte"]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "userInterfaceStyle": "automatic"
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "./plugins/with-scene-lifecycle.cjs",
      [
        "expo-media-library",
        {
          "photosPermission": "Show your latest photos in the composer so you can attach one.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-router",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Use the microphone to dictate a Nyte task.",
          "speechRecognitionPermission": "Use speech recognition to transcribe a Nyte task."
        }
      ],
      [
        "@use-voltra/ios-client",
        {
          "groupIdentifier": "group.dev.nyte.ios",
          "enablePushNotifications": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/5f78a9e7-057f-490e-ae2a-1dcdb12827d9"
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "NyteLiveActivity",
                  "bundleIdentifier": "dev.nyte.ios.NyteLiveActivity",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.dev.nyte.ios"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "5f78a9e7-057f-490e-ae2a-1dcdb12827d9"
      }
    },
    "owner": "nameisdaniel"
  }
}

{
  "name": "@nyte-ai/ios",
  "version": "0.1.0",
  "private": true,
  "description": "Nyte's native iOS companion for a remote Mac host.",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "expo run:ios --no-bundler",
    "ios:release": "expo run:ios --configuration Release --no-bundler",
    "ios:build": "expo run:ios --configuration Release --no-bundler --no-install --output ./build/app",
    "prebuild": "expo prebuild --platform ios --no-install",
    "bundle": "expo export --platform ios --output-dir ./build/export",
    "build:dev": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform ios --profile preview",
    "build:production": "eas build --platform ios --profile production",
    "submit": "eas submit --platform ios --profile production",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@legendapp/list": "3.3.11",
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@use-voltra/ios": "^2.2.0",
    "@use-voltra/ios-client": "^2.2.0",
    "expo": "57.0.22",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-glass-effect": "~57.0.3",
    "expo-image-manipulator": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-media-library": "^57.0.5",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-speech-recognition": "^57.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-worklets": "0.10.1",
    "react-strict-dom": "0.0.55",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@types/react": "~19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-expo": "~57.0.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

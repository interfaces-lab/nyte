{
  "name": "@nyte-ai/desktop",
  "version": "0.0.6",
  "private": true,
  "description": "The Nyte desktop app: an Electron host over @nyte-ai/core's SDK.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist out",
    "adblock": "node scripts/build-adblock.mjs",
    "build": "node scripts/build.mjs",
    "bench": "pnpm build && playwright test --config benchmark/playwright.config.ts",
    "dev": "install-electron && node scripts/build-adblock.mjs && node scripts/dev.mjs",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "update:appcast": "node scripts/update-appcast.mjs",
    "update:local": "node scripts/sparkle-test/prepare.mjs",
    "update:serve": "node scripts/sparkle-test/serve.mjs",
    "package": "node scripts/build.mjs --package --publish never",
    "package:app": "node scripts/build.mjs --package --dir",
    "package:mac": "pnpm package -- --mac --arm64",
    "package:mac:dmg": "pnpm package -- --mac dmg --arm64",
    "package:mac:zip": "pnpm package -- --mac zip --arm64",
    "package:linux": "pnpm package -- --linux",
    "package:linux:appimage": "pnpm package -- --linux AppImage",
    "package:win": "pnpm package -- --win",
    "package:win:nsis": "pnpm package -- --win nsis"
  },
  "dependencies": {
    "@cf-wasm/photon": "0.4.0",
    "@chenglou/pretext": "0.0.8",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@ghostery/adblocker": "2.18.2",
    "@hono/node-server": "2.1.0",
    "@lexical/history": "^0.50.0",
    "@lexical/link": "0.50.0",
    "@lexical/plain-text": "^0.50.0",
    "@lobehub/streamdown": "1.3.1",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/server": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@pierre/diffs": "1.4.1",
    "@pierre/trees": "1.0.0-beta.4",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.102.5",
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-virtual": "3.14.10",
    "beautiful-mermaid": "1.1.3",
    "central-icons": "npm:@central-icons-react/round-outlined-radius-2-stroke-1.5@^1.1.319",
    "central-icons-filled": "npm:@central-icons-react/round-filled-radius-2-stroke-1.5@^1.1.319",
    "diff": "9.0.0",
    "electron-sparkle": "0.2.0",
    "electron-updater": "^6.8.9",
    "ghostty-web": "github:anomalyco/ghostty-web#83c0a07b8628b748aed073b232cb4b52a6ca11c1",
    "hono": "4.13.1",
    "lexical": "^0.50.0",
    "motion": "12.43.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "1.3.0",
    "shiki": "4.4.3",
    "torph": "0.1.3",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stylexjs/unplugin": "0.19.0",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dialkit": "2.0.2",
    "electron": "^44.3.0",
    "electron-builder": "26.15.2",
    "electron-vite": "5.0.0",
    "react-grab": "^0.2.0",
    "typescript": "^7.0.2",
    "vite": "7.1.4",
    "vitest": "^5.0.0"
  }
}

{
  "name": "@nyte-ai/desktop",
  "version": "0.0.29",
  "private": true,
  "description": "The Nyte desktop app: an Electron host over @nyte-ai/core's SDK.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist out",
    "adblock": "node scripts/build-adblock.mjs",
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "e2e": "pnpm --dir ../canvas build && pnpm --dir ../app build && pnpm --dir ../tui build && pnpm build && pnpm build:e2e && playwright test --config e2e/playwright.config.ts",
    "dev": "install-electron && node scripts/build-adblock.mjs && node scripts/dev.mjs",
    "test": "install-electron && vitest --run",
    "update:test": "node scripts/update-test.mjs",
    "install:local": "node scripts/install-local.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "grid": "playwright test --config e2e/playwright.config.ts e2e/grid.spec.ts --workers=1 --retries=0 --reporter=list",
    "grid:diff": "node e2e/grid/diff.ts",
    "package": "node scripts/build.mjs --package --publish never",
    "package:app": "node scripts/build.mjs --package --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "@ghostery/adblocker": "^2.20.3",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "electron-updater": "^6.8.11",
    "sucrase": "^3.35.1",
    "typebox": "^1.4.6"
  },
  "devDependencies": {
    "@clerk/electron": "^0.1.8",
    "@electron/osx-sign": "^2.7.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/app": "workspace:*",
    "@nyte-ai/bench": "workspace:*",
    "@nyte-ai/canvas": "workspace:*",
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "@nyte-ai/service": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "dialkit": "^2.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "oxc-transform-react": "^0.156.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grab": "^0.2.0",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}

{
  "name": "@nyte-ai/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "The Nyte desktop app: an Electron host over @nyte-ai/core's SDK.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist out",
    "adblock": "node scripts/build-adblock.mjs",
    "build": "node scripts/build-adblock.mjs && electron-vite build && node scripts/check-startup-bundle.mjs",
    "dev": "install-electron && node scripts/build-adblock.mjs && electron-vite dev",
    "package": "pnpm build && electron-builder --dir --config electron-builder.config.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@ghostery/adblocker": "2.18.2",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@pierre/diffs": "1.3.1",
    "@pierre/trees": "1.0.0-beta.4",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.102.5",
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-virtual": "3.14.10",
    "central-icons": "npm:@central-icons-react/round-outlined-radius-2-stroke-1.5@^1.1.318",
    "central-icons-filled": "npm:@central-icons-react/round-filled-radius-2-stroke-1.5@^1.1.318",
    "diff": "9.0.0",
    "ghostty-web": "github:anomalyco/ghostty-web#83c0a07b8628b748aed073b232cb4b52a6ca11c1",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grab": "^0.2.0",
    "shiki": "4.4.3",
    "streamdown": "2.6.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^44.1.1",
    "electron-builder": "26.15.2",
    "electron-vite": "5.0.0",
    "typescript": "^7.0.2",
    "vite": "7.1.4",
    "vitest": "^5.0.0"
  }
}

{
  "name": "@nyte-ai/desktop",
  "version": "0.0.16-dev.4",
  "private": true,
  "description": "The Nyte desktop app: an Electron host over @nyte-ai/core's SDK.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist out",
    "adblock": "node scripts/build-adblock.mjs",
    "build": "node scripts/build.mjs",
    "bench": "pnpm build && playwright test --config benchmark/playwright.config.ts",
    "dev": "install-electron && node scripts/build-adblock.mjs && node scripts/dev.mjs",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "update:appcast": "node scripts/update-appcast.mjs",
    "update:local": "node scripts/sparkle-test/prepare.mjs",
    "update:serve": "node scripts/sparkle-test/serve.mjs",
    "package": "node scripts/build.mjs --package --publish never",
    "package:app": "node scripts/build.mjs --package --dir",
    "package:mac": "pnpm package -- --mac --arm64",
    "package:mac:dmg": "pnpm package -- --mac dmg --arm64",
    "package:mac:zip": "pnpm package -- --mac zip --arm64",
    "package:linux": "pnpm package -- --linux",
    "package:linux:appimage": "pnpm package -- --linux AppImage",
    "package:win": "pnpm package -- --win",
    "package:win:nsis": "pnpm package -- --win nsis"
  },
  "dependencies": {
    "@cf-wasm/photon": "0.4.0",
    "@clerk/electron": "0.0.50",
    "@ghostery/adblocker": "2.18.2",
    "@lydell/node-pty": "1.2.0-beta.15",
    "diff": "9.0.0",
    "electron-sparkle": "0.2.0",
    "electron-updater": "^6.8.9",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/app": "workspace:*",
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/serve": "workspace:*",
    "@nyte-ai/server": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@playwright/test": "1.63.0",
    "@stylexjs/stylex": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "dialkit": "2.0.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.7",
    "electron-vite": "6.0.0-beta.5",
    "oxc-transform-react": "0.145.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-grab": "^0.2.0",
    "typescript": "^7.0.2",
    "vite": "8.3.2",
    "vitest": "^5.0.2",
    "ws": "8.21.3"
  }
}

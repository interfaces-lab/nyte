{
  "name": "@nyte-ai/server",
  "version": "0.0.16-dev.2",
  "private": false,
  "description": "Serve a Nyte SDK over Web Request/Response: JSON calls and SSE watches, token or callback auth, no listener of its own.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/sdk-packages.mjs build server"
  },
  "dependencies": {
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

{
  "name": "@nyte-ai/ai",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth/context": "./src/auth/context.ts",
    "./auth/helpers": "./src/auth/helpers.ts",
    "./auth/types": "./src/auth/types.ts",
    "./auth/credential-store": "./src/auth/credential-store.ts",
    "./auth/oauth/github-copilot": "./src/auth/oauth/github-copilot.ts",
    "./auth/oauth/openai-codex": "./src/auth/oauth/openai-codex.ts",
    "./auth/store": "./src/auth/store.ts",
    "./bun-oauth": "./src/bun-oauth.ts",
    "./models": "./src/models.ts",
    "./providers/github-copilot": "./src/providers/github-copilot.ts",
    "./providers/openai-codex": "./src/providers/openai-codex.ts",
    "./session-resources": "./src/session-resources.ts",
    "./types": "./src/types.ts",
    "./utils/event-stream": "./src/utils/event-stream.ts",
    "./utils/overflow": "./src/utils/overflow.ts",

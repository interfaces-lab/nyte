{
  "name": "@nyte-ai/protocol",
  "version": "0.0.28",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./frame-checks": "./src/frame-checks.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js"
      },
      "./frame-checks": {
        "types": "./dist/src/frame-checks.d.ts",
        "import": "./dist/src/frame-checks.js"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "bench:gate": "node bench/changes.bench.ts",
    "build:package": "bun ../../scripts/sdk-packages.mjs build protocol"
  },
  "dependencies": {
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "fflate": "^0.8.3",
    "typebox": "^1.4.6"
  },
  "devDependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@types/node": "^26.6.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

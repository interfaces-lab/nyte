{
  "name": "@nyte-ai/protocol",
  "version": "0.0.20",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "typecheck": "tsrs --noEmit",
    "test": "vitest --run",
    "build:package": "bun ../../scripts/sdk-packages.mjs build protocol"
  },
  "dependencies": {
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "fflate": "^0.8.3",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

    "build:package": "bun ../../scripts/sdk-packages.mjs build schema"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=26.4.0"
  }

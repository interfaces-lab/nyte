{
  "name": "@nyte-ai/schema",
  "version": "0.0.28",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/schema"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/index.ts",
    "./origin": "./src/origin.ts",
    "./serial": "./src/serial.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js"
      },
      "./model": {
        "types": "./dist/src/model/index.d.ts",
        "import": "./dist/src/model/index.js"
      },
      "./origin": {
        "types": "./dist/src/origin.d.ts",
        "import": "./dist/src/origin.js"
      },
      "./serial": {
        "types": "./dist/src/serial.d.ts",
        "import": "./dist/src/serial.js"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "build:package": "bun ../../scripts/sdk-packages.mjs build schema"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "typebox": "^1.4.6"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.4",
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

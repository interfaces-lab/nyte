{
  "name": "@nyte-ai/schema",
  "version": "0.0.16-dev.2",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/schema"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/index.ts",
    "./serial": "./src/serial.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",

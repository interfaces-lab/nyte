{
  "name": "@nyte-ai/core",
  "version": "0.0.16-dev.2",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./plugin-source": "./src/plugins/source.ts",
    "./store": "./src/store.ts",
    "./postgres": "./src/postgres.ts",
    "./store-worker": "./src/kernel/store-worker.ts",
    "./image-resize-worker": "./src/tools/support/image-resize-worker.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "test": "vitest --run && NYTE_TEST_STORE=worker vitest --run test/kernel/store.test.ts test/kernel/objects-chain.test.ts test/kernel/sqlite-replay.test.ts test/kernel/sqlite-boundary.test.ts test/kernel/queue.test.ts test/kernel/sdk-watch.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p benchmark/tsconfig.json",
    "build:package": "bun ../../scripts/sdk-packages.mjs build core"
  },
  "dependencies": {
    "@cf-wasm/photon": "0.4.0",
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/telemetry": "workspace:*",
    "@types/pg": "8.23.1",
    "diff": "^9.0.0",
    "exifr": "7.1.3",
    "ignore": "5.3.2",
    "pg": "8.23.0",
    "typebox": "1.3.34",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

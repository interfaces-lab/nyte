{
  "name": "@nyte-ai/core",
  "version": "0.0.27",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./store": "./src/store.ts",
    "./testing": "./src/testing.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js"
      },
      "./server": {
        "types": "./dist/src/server.d.ts",
        "import": "./dist/src/server.js"
      },
      "./store": {
        "types": "./dist/src/store.d.ts",
        "import": "./dist/src/store.js"
      },
      "./testing": {
        "types": "./dist/src/testing.d.ts",
        "import": "./dist/src/testing.js"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "build:package": "bun ../../scripts/sdk-packages.mjs build core"
  },
  "dependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "typebox": "^1.4.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.4",
    "@types/node": "^26.6.6",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

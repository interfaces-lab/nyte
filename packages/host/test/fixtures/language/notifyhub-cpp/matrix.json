{
  "language": "c",
  "servers": [
    "clangd"
  ],
  "vscode": {
    "extension": "llvm-vs-code-extensions.vscode-clangd",
    "source": "https://github.com/clangd/vscode-clangd/blob/master/package.json"
  },
  "features": {
    "completion": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "auto summary = hub.",
          "says": "stats"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "hover": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "auto summary = hub.sta",
          "says": "Counts"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "definition": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "after": "totals_ = bump_",
          "says": "src/hub.cpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "typeDefinition": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "auto sum",
          "says": "include/notifyhub/hub.hpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "references": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "after": "Counts bump_c",
          "says": "src/hub.cpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "symbols": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "says": "bump_counts"
        },
        {
          "file": "src/checksum.c",
          "says": "notifyhub_checksum"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "codeActions": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "  au",
          "says": "Replace with deduced type"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "format": {
      "probes": [
        {
          "file": "src/main.cpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "formatRange": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "int   total"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "rename": {
      "probes": [
        {
          "file": "include/notifyhub/hub.hpp",
          "after": "struct Cou",
          "says": "src/hub.cpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "diagnostics": {
      "probes": [
        {
          "file": "src/channels.cpp",
          "says": "Unused variable"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    }
  }
}

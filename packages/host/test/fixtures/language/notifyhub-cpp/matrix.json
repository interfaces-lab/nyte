{
  "language": "c",
  "servers": [
    "clangd"
  ],
  "vscode": {
    "extension": "llvm-vs-code-extensions.vscode-clangd",
    "source": "https://github.com/clangd/vscode-clangd/blob/master/package.json"
  },
  "features": {
    "completion": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "auto summary = hub.",
          "says": "stats"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "hover": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "auto summary = hub.sta",
          "says": "Counts"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "signatureHelp": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "hub.submit(alert, ",
          "says": "urgent"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "definition": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "after": "totals_ = bump_",
          "says": "src/hub.cpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "typeDefinition": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "auto sum",
          "says": "include/notifyhub/hub.hpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "implementation": {
      "probes": [
        {
          "file": "include/notifyhub/hub.hpp",
          "after": "virtual bool se",
          "says": "include/notifyhub/hub.hpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "declaration": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "after": "totals_ = bump_",
          "says": "include/notifyhub/hub.hpp"
        },
        {
          "file": "src/checksum.c",
          "after": "unsigned int notifyhub_ch",
          "says": "include/notifyhub/checksum.h"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "references": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "after": "Counts bump_c",
          "says": "src/hub.cpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "documentHighlights": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "after": "Counts bump_c"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "symbols": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "says": "bump_counts"
        },
        {
          "file": "src/checksum.c",
          "says": "notifyhub_checksum"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "workspaceSymbols": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "query": "bump_counts",
          "says": "bump_counts"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "codeActions": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "  au",
          "says": "Replace with deduced type"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "format": {
      "probes": [
        {
          "file": "src/main.cpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "formatRange": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "int   total"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "rename": {
      "probes": [
        {
          "file": "include/notifyhub/hub.hpp",
          "after": "struct Cou",
          "says": "src/hub.cpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "renameFiles": {
      "probes": [
        {
          "file": "src/hub.cpp"
        }
      ],
      "servers": [],
      "answers": false,
      "vscode": false
    },
    "documentLinks": {
      "probes": [
        {
          "file": "src/main.cpp",
          "says": "hub.hpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "documentColors": {
      "probes": [
        {
          "file": "src/main.cpp"
        }
      ],
      "servers": [],
      "answers": false,
      "vscode": false
    },
    "linkedEditingRanges": {
      "probes": [
        {
          "file": "src/main.cpp",
          "after": "hub.sub"
        }
      ],
      "servers": [],
      "answers": false,
      "vscode": false
    },
    "foldingRanges": {
      "probes": [
        {
          "file": "src/hub.cpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "selectionRanges": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "after": "Counts bump_c"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "semanticTokens": {
      "probes": [
        {
          "file": "src/main.cpp",
          "says": "function"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "inlayHints": {
      "probes": [
        {
          "file": "src/main.cpp"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "callHierarchy": {
      "probes": [
        {
          "file": "src/hub.cpp",
          "after": "Counts bump_c",
          "says": "record"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "typeHierarchy": {
      "probes": [
        {
          "file": "include/notifyhub/hub.hpp",
          "after": "class Chan",
          "says": "EmailChannel"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    },
    "diagnostics": {
      "probes": [
        {
          "file": "src/channels.cpp",
          "says": "Unused variable"
        }
      ],
      "servers": [
        "clangd"
      ],
      "answers": true,
      "vscode": true
    }
  }
}

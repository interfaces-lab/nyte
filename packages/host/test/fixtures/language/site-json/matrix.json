{
  "language": "json",
  "servers": ["vscode-json-language-server"],
  "vscode": {
    "extension": "vscode.json-language-features",
    "source": "https://github.com/microsoft/vscode/blob/main/extensions/json-language-features/package.json"
  },
  "features": {
    "completion": {
      "probes": [
        {
          "file": "package.json",
          "after": "\"lic",
          "says": "license"
        }
      ],
      "servers": ["vscode-json-language-server"],
      "answers": true,
      "vscode": true,
      "note": "Probes package.json against the SchemaStore catalog over HTTPS (requires network)."
    },
    "hover": {
      "probes": [
        {
          "file": "theme.json",
          "after": "\"acc",
          "says": "Primary brand accent color"
        }
      ],
      "servers": ["vscode-json-language-server"],
      "answers": true,
      "vscode": true
    },
    "definition": {
      "probes": [
        {
          "file": "theme.json",
          "after": "\"acc"
        }
      ],
      "servers": [],
      "answers": false,
      "vscode": false
    },
    "typeDefinition": {
      "probes": [
        {
          "file": "theme.json",
          "after": "\"acc"
        }
      ],
      "servers": [],
      "answers": false,
      "vscode": false
    },
    "references": {
      "probes": [
        {
          "file": "theme.json",
          "after": "\"acc"
        }
      ],
      "servers": [],
      "answers": false,
      "vscode": false
    },
    "symbols": {
      "probes": [
        {
          "file": "theme.json",
          "says": "accent"
        }
      ],
      "servers": ["vscode-json-language-server"],
      "answers": true,
      "vscode": true
    },
    "codeActions": {
      "probes": [
        {
          "file": "theme.json",
          "after": "\"acc",
          "says": "Sort JSON"
        }
      ],
      "servers": ["vscode-json-language-server"],
      "answers": true,
      "vscode": true,
      "note": "Server returns the Sort JSON source action, whose command json.sort is handled client-side in VS Code via the custom json/sort request rather than workspace/executeCommand."
    },
    "format": {
      "probes": [
        {
          "file": "package.json"
        }
      ],
      "servers": ["vscode-json-language-server"],
      "answers": true,
      "vscode": true
    },
    "formatRange": {
      "probes": [
        {
          "file": "package.json",
          "after": "\"scripts\":{\"build\":\"echo ok\"}"
        }
      ],
      "servers": ["vscode-json-language-server"],
      "answers": true,
      "vscode": true
    },
    "rename": {
      "probes": [
        {
          "file": "theme.json",
          "after": "\"acc"
        }
      ],
      "servers": [],
      "answers": false,
      "vscode": false
    },
    "diagnostics": {
      "probes": [
        {
          "file": "package.json",
          "says": "boolean"
        }
      ],
      "servers": ["vscode-json-language-server"],
      "answers": true,
      "vscode": true,
      "note": "Validates package.json against the SchemaStore catalog over HTTPS (requires network)."
    }
  }
}

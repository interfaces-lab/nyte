{
  "language": "css",
  "servers": ["vscode-css-language-server"],
  "vscode": {
    "extension": "vscode.css-language-features",
    "source": "https://github.com/microsoft/vscode/blob/main/extensions/css-language-features/package.json"
  },
  "features": {
    "completion": {
      "probes": [
        {
          "file": "styles.css",
          "after": "display: fl",
          "says": "flex"
        }
      ],
      "servers": ["vscode-css-language-server"],
      "answers": true,
      "vscode": true
    },
    "hover": {
      "probes": [
        {
          "file": "styles.css",
          "after": "disp",
          "says": "display"
        }
      ],
      "servers": ["vscode-css-language-server"],
      "answers": true,
      "vscode": true
    },
    "definition": {
      "probes": [
        {
          "file": "styles.css",
          "after": "gap: var(--pan",
          "says": "styles.css"
        }
      ],
      "servers": ["vscode-css-language-server"],
      "answers": true,
      "vscode": true
    },
    "typeDefinition": {
      "probes": [
        {
          "file": "styles.css",
          "after": "gap: var(--pan"
        }
      ],
      "servers": [],
      "answers": false,
      "vscode": false
    },
    "references": {
      "probes": [
        {
          "file": "styles.css",
          "after": "--pan",
          "says": "styles.css"
        }
      ],
      "servers": ["vscode-css-language-server"],
      "answers": true,
      "vscode": true
    },
    "symbols": {
      "probes": [
        {
          "file": "styles.css",
          "says": ".card-shell"
        }
      ],
      "servers": ["vscode-css-language-server"],
      "answers": true,
      "vscode": true
    },
    "codeActions": {
      "probes": [
        {
          "file": "styles.css",
          "after": "col",
          "says": "Rename to 'color'"
        }
      ],
      "servers": ["vscode-css-language-server"],
      "answers": true,
      "vscode": true
    },
    "format": {
      "probes": [
        {
          "file": "styles.css"
        }
      ],
      "servers": ["vscode-css-language-server"],
      "answers": true,
      "vscode": true
    },
    "formatRange": {
      "probes": [
        {
          "file": "styles.css",
          "after": ".badge{color:#0f172a;background-color:rgb(226,232,240);padding:4px 8px;}"
        }
      ],
      "servers": ["vscode-css-language-server"],
      "answers": true,
      "vscode": true
    },
    "rename": {
      "probes": [
        {
          "file": "styles.css",
          "after": "--pan",
          "says": "styles.css"
        }
      ],
      "servers": ["vscode-css-language-server"],
      "answers": true,
      "vscode": true
    },
    "diagnostics": {
      "probes": [
        {
          "file": "styles.css",
          "says": "Unknown property: 'colr'"
        }
      ],
      "servers": ["vscode-css-language-server"],
      "answers": true,
      "vscode": true
    }
  }
}

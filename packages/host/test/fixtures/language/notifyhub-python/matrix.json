{
  "language": "python",
  "servers": [
    "ty",
    "ruff"
  ],
  "vscode": {
    "extension": "ms-python.vscode-pylance + charliermarsh.ruff",
    "source": "https://github.com/microsoft/pylance-release/blob/main/README.md"
  },
  "features": {
    "completion": {
      "probes": [
        {
          "file": "notifyhub/__main__.py",
          "after": "stats = hub.stats",
          "says": "stats"
        }
      ],
      "servers": [
        "ty"
      ],
      "answers": true,
      "vscode": true
    },
    "hover": {
      "probes": [
        {
          "file": "notifyhub/__main__.py",
          "after": "stats = hub.st",
          "says": "Stats"
        },
        {
          "file": "notifyhub/webhook.py",
          "after": "noqa: F40",
          "says": "unused-import"
        }
      ],
      "servers": [
        "ty",
        "ruff"
      ],
      "answers": true,
      "vscode": true,
      "note": "ty contributes symbol types and docstrings; ruff contributes lint rule documentation on noqa comments."
    },
    "definition": {
      "probes": [
        {
          "file": "notifyhub/__main__.py",
          "after": "hub=H",
          "says": "notifyhub/hub.py"
        }
      ],
      "servers": [
        "ty"
      ],
      "answers": true,
      "vscode": true
    },
    "typeDefinition": {
      "probes": [
        {
          "file": "notifyhub/__main__.py",
          "after": "for mess",
          "says": "notifyhub/hub.py"
        }
      ],
      "servers": [
        "ty"
      ],
      "answers": true,
      "vscode": true
    },
    "references": {
      "probes": [
        {
          "file": "notifyhub/stats.py",
          "after": "def bu",
          "says": "notifyhub/stats.py"
        }
      ],
      "servers": [
        "ty"
      ],
      "answers": true,
      "vscode": true
    },
    "symbols": {
      "probes": [
        {
          "file": "notifyhub/stats.py",
          "says": "Counts"
        }
      ],
      "servers": [
        "ty"
      ],
      "answers": true,
      "vscode": true
    },
    "codeActions": {
      "probes": [
        {
          "file": "notifyhub/webhook.py",
          "after": "import js",
          "says": "Remove unused import"
        },
        {
          "file": "notifyhub/webhook.py",
          "after": "retries: int = \"",
          "says": "invalid-assignment"
        }
      ],
      "servers": [
        "ty",
        "ruff"
      ],
      "answers": true,
      "vscode": true,
      "note": "ty contributes quick fixes for type diagnostics (such as suppression comments); ruff contributes lint quick fixes, disable-rule comments, fix-all, and organize imports."
    },
    "format": {
      "probes": [
        {
          "file": "notifyhub/__main__.py"
        }
      ],
      "servers": [
        "ruff"
      ],
      "answers": true,
      "vscode": true
    },
    "formatRange": {
      "probes": [
        {
          "file": "notifyhub/hub.py",
          "after": "class Hub"
        }
      ],
      "servers": [
        "ruff"
      ],
      "answers": true,
      "vscode": true
    },
    "rename": {
      "probes": [
        {
          "file": "notifyhub/stats.py",
          "after": "class Cou",
          "says": "notifyhub/stats.py"
        }
      ],
      "servers": [
        "ty"
      ],
      "answers": true,
      "vscode": true
    },
    "diagnostics": {
      "probes": [
        {
          "file": "notifyhub/webhook.py",
          "says": "not assignable to"
        },
        {
          "file": "notifyhub/webhook.py",
          "says": "imported but unused"
        }
      ],
      "servers": [
        "ty",
        "ruff"
      ],
      "answers": true,
      "vscode": true,
      "note": "ty reports type diagnostics; ruff reports lint diagnostics. Both merge into webhook.py's diagnostics list."
    }
  }
}

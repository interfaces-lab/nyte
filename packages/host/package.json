{
  "name": "@nyte-ai/host",
  "version": "0.0.16-dev.2",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/host"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bench": "./src/bench/index.ts",
    "./durable-object": "./src/durable-object.ts",
    "./listen-fetch": "./src/listen-fetch.ts",
    "./providers": "./src/providers.ts",
    "./deploy/cloudflare": "./src/deploy/cloudflare/worker.ts",
    "./deploy/vercel": "./src/deploy/vercel/nitro.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/deploy/vercel",
    "test": "vitest --run",
    "build:package": "bun ../../scripts/sdk-packages.mjs build host"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "ignore": "7.0.9",
    "pg": "8.23.0",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.6.3",
    "@types/pg": "8.23.1",
    "@vercel/sandbox": "3.1.0",
    "esbuild": "0.28.2",
    "h3": "2.0.1-rc.32",
    "miniflare": "5.20261001.0-alpha",
    "nitro": "3.0.260903-beta",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "workflow": "4.8.8"
  },
  "peerDependencies": {
    "@vercel/sandbox": "3.1.0",
    "h3": "2.0.1-rc.32",
    "nitro": "3.0.260903-beta",
    "workflow": "4.8.8"
  },
  "peerDependenciesMeta": {
    "@vercel/sandbox": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "workflow": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

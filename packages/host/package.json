{
  "name": "@nyte-ai/host",
  "version": "0.0.16-dev.2",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/host"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bench": "./src/bench/index.ts",
    "./canvas-preview": "./src/canvas-preview.ts",
    "./credentials": "./src/credentials.ts",
    "./durable-object": "./src/durable-object.ts",
    "./identity": "./src/identity.ts",
    "./listen-fetch": "./src/listen-fetch.ts",
    "./providers": "./src/providers.ts",
    "./secrets": "./src/secrets.ts",
    "./shell-env": "./src/shell-env.ts",
    "./usage": "./src/usage.ts",
    "./store-usage": "./src/store-usage.ts",
    "./usage-service": "./src/usage-service.ts",
    "./usage-scan": "./src/usage-scan.ts",
    "./usage-worker": "./src/usage-worker.ts",
    "./deploy/cloudflare": "./src/deploy/cloudflare/worker.ts",
    "./deploy/vercel": "./src/deploy/vercel/nitro.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p src/deploy/vercel",
    "test": "vitest --run",
    "check:store": "node scripts/check-store.ts",
    "build:package": "bun ../../scripts/sdk-packages.mjs build host"
  },
  "dependencies": {
    "@earendil-works/pi-mcp": "1.3.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "ignore": "7.0.9",
    "pg": "8.23.0",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@nyte-ai/canvas": "workspace:*",
    "@nyte-ai/connect": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "nitro": "3.0.260903-beta",
    "typescript": "6.0.3",
    "vitest": "^5.0.4",
    "workflow": "4.8.8"
  },
  "peerDependencies": {
    "nitro": "3.0.260903-beta",
    "workflow": "4.8.8"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    },
    "workflow": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.4.0"
  }

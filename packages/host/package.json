{
  "name": "@nyte-ai/host",
  "version": "0.0.23",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/host"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"

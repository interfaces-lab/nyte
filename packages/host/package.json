    "@nyte-ai/schema": "workspace:*",
    "ignore": "7.0.9",
    "pg": "8.23.0",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.6.3",
    "@types/pg": "8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26.4.0"
  }

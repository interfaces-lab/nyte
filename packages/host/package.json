        "types": "./dist/src/listen-fetch.d.ts",
        "import": "./dist/src/listen-fetch.js"
      },
      "./providers": {
        "types": "./dist/src/providers.d.ts",
        "import": "./dist/src/providers.js"
      },
      "./secrets": {
        "types": "./dist/src/secrets.d.ts",
        "import": "./dist/src/secrets.js"
      },
      "./shell-env": {
        "types": "./dist/src/shell-env.d.ts",
        "import": "./dist/src/shell-env.js"
      },
      "./usage": {
        "types": "./dist/src/usage.d.ts",
        "import": "./dist/src/usage.js"
      },
      "./store-usage": {
        "types": "./dist/src/store-usage.d.ts",
        "import": "./dist/src/store-usage.js"
      },
      "./usage-service": {
        "types": "./dist/src/usage-service.d.ts",
        "import": "./dist/src/usage-service.js"
      },
      "./usage-scan": {
        "types": "./dist/src/usage-scan.d.ts",
        "import": "./dist/src/usage-scan.js"
      },
      "./usage-worker": {
        "types": "./dist/src/usage-worker.d.ts",
        "import": "./dist/src/usage-worker.js"
      }

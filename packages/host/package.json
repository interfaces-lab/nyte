      "./images": {
        "types": "./dist/src/images/node.d.ts",
        "import": "./dist/src/images/node.js"
      },
      "./image-worker": {
        "types": "./dist/src/images/worker.d.ts",
        "import": "./dist/src/images/worker.js"
      },

{
  "name": "@nyte-ai/host",
  "version": "0.3.3",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/host"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./canvas-preview": "./src/canvas-preview.ts",
    "./credentials": "./src/keys/credentials.ts",
    "./durable-object": "./src/store/durable-object.ts",
    "./identity": "./src/keys/identity.ts",
    "./images": "./src/images/node.ts",
    "./image-worker": "./src/images/worker.ts",
    "./listen-fetch": "./src/serve/listen-fetch.ts",
    "./open": "./src/open.ts",
    "./providers": "./src/providers.ts",
    "./secrets": "./src/keys/secrets.ts",
    "./shell-env": "./src/shell-env.ts",
    "./usage": "./src/usage/local-history.ts",
    "./store-usage": "./src/usage/store.ts",
    "./usage-service": "./src/usage/scanner.ts",
    "./usage-scan": "./src/usage/scan-worker.ts",
    "./usage-worker": "./src/usage/worker.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js"
      },
      "./canvas-preview": {
        "types": "./dist/src/canvas-preview.d.ts",
        "import": "./dist/src/canvas-preview.js"
      },
      "./credentials": {
        "types": "./dist/src/keys/credentials.d.ts",
        "import": "./dist/src/keys/credentials.js"
      },
      "./durable-object": {
        "types": "./dist/src/store/durable-object.d.ts",
        "import": "./dist/src/store/durable-object.js"
      },
      "./identity": {
        "types": "./dist/src/keys/identity.d.ts",
        "import": "./dist/src/keys/identity.js"
      },
      "./images": {
        "types": "./dist/src/images/node.d.ts",
        "import": "./dist/src/images/node.js"
      },
      "./image-worker": {
        "types": "./dist/src/images/worker.d.ts",
        "import": "./dist/src/images/worker.js"
      },
      "./listen-fetch": {
        "types": "./dist/src/serve/listen-fetch.d.ts",
        "import": "./dist/src/serve/listen-fetch.js"
      },
      "./open": {
        "types": "./dist/src/open.d.ts",
        "import": "./dist/src/open.js"
      },
      "./providers": {
        "types": "./dist/src/providers.d.ts",
        "import": "./dist/src/providers.js"
      },
      "./secrets": {
        "types": "./dist/src/keys/secrets.d.ts",
        "import": "./dist/src/keys/secrets.js"
      },
      "./shell-env": {
        "types": "./dist/src/shell-env.d.ts",
        "import": "./dist/src/shell-env.js"
      },
      "./usage": {
        "types": "./dist/src/usage/local-history.d.ts",
        "import": "./dist/src/usage/local-history.js"
      },
      "./store-usage": {
        "types": "./dist/src/usage/store.d.ts",
        "import": "./dist/src/usage/store.js"
      },
      "./usage-service": {
        "types": "./dist/src/usage/scanner.d.ts",
        "import": "./dist/src/usage/scanner.js"
      },
      "./usage-scan": {
        "types": "./dist/src/usage/scan-worker.d.ts",
        "import": "./dist/src/usage/scan-worker.js"
      },
      "./usage-worker": {
        "types": "./dist/src/usage/worker.d.ts",
        "import": "./dist/src/usage/worker.js"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "check:store": "node scripts/check-store.ts",
    "build:package": "bun ../../scripts/sdk-packages.mjs build host"
  },
  "dependencies": {
    "@earendil-works/pi-mcp": "^1.5.2",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@silvia-odwyer/photon": "^0.3.3",
    "fflate": "^0.8.3",
    "ignore": "^7.0.14",
    "pg": "^8.23.1",
    "typebox": "^1.4.7",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@nyte-ai/canvas": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "fast-check": "^4.10.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@silvia-odwyer/photon": "^0.3.3",
    "fflate": "^0.8.3",
    "ignore": "^7.0.13",
    "pg": "^8.23.1",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",

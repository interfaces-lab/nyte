{
  "name": "@nyte-ai/host",
  "version": "0.0.16-dev.2",
  "private": false,
  "description": "Compose a Nyte host with models, storage, trusted plugins, and optional local telemetry export.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/host"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog.ts",
    "./environment": "./src/environment.ts",
    "./plugins": "./src/plugins.ts",
    "./settings": "./src/settings/index.ts",
    "./otel": "./src/otel.ts",
    "./store-usage": "./src/store-usage.ts",
    "./usage": "./src/usage.ts",
    "./usage-scan": "./src/usage-scan.ts",
    "./usage-worker": "./src/usage-worker.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/sdk-packages.mjs build host"
  },
  "dependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/telemetry": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "diff": "^9.0.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

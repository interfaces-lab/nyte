{
  "name": "@nyte-ai/canvas",
  "version": "0.0.0",
  "private": true,
  "description": "Inline canvases: the nyte/canvas kit the agent writes TSX against, and the runtime shell every client loads it in.",
  "type": "module",
  "exports": {
    "./fixtures": "./test/read-canvas-fixture.ts",
    "./kit": "./src/kit/index.ts",
    "./kit/scheme": "./src/kit/scheme.ts",
    "./shell-inline": {
      "types": "./dist/shell-inline.d.ts",
      "default": "./dist/shell-inline.js"
    },
    "./shell-files": {
      "types": "./dist/shell-files.d.ts",
      "default": "./dist/shell-files.js"
    }
  },
  "scripts": {
    "build": "vite build && vite build -c vite.libraries.config.ts && node scripts/inline.mjs",
    "clean": "rm -rf node_modules .turbo dist",
    "libraries": "node scripts/library-exports.mjs",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/fixtures && node scripts/library-exports.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nivo/bar": "0.99.0",
    "@nivo/boxplot": "0.99.0",
    "@nivo/bullet": "0.99.0",
    "@nivo/bump": "0.99.0",
    "@nivo/calendar": "0.99.0",
    "@nivo/chord": "0.99.0",
    "@nivo/circle-packing": "0.99.0",
    "@nivo/funnel": "0.99.0",
    "@nivo/geo": "0.99.0",
    "@nivo/heatmap": "0.99.0",
    "@nivo/icicle": "0.99.0",
    "@nivo/line": "0.99.0",
    "@nivo/marimekko": "0.99.0",
    "@nivo/network": "0.99.0",
    "@nivo/parallel-coordinates": "0.99.0",
    "@nivo/pie": "0.99.0",
    "@nivo/polar-bar": "0.99.0",
    "@nivo/radar": "0.99.0",
    "@nivo/radial-bar": "0.99.0",
    "@nivo/sankey": "0.99.0",
    "@nivo/scatterplot": "0.99.0",
    "@nivo/stream": "0.99.0",
    "@nivo/sunburst": "0.99.0",
    "@nivo/swarmplot": "0.99.0",
    "@nivo/tree": "0.99.0",
    "@nivo/treemap": "0.99.0",
    "@nivo/voronoi": "0.99.0",
    "@nivo/waffle": "0.99.0",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@stylexjs/stylex": "^0.19.1",
    "d3-array": "3.2.4",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}

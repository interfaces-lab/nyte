{
  "name": "@nyte-ai/canvas",
  "version": "0.0.0",
  "private": true,
  "description": "Inline canvases: the nyte/canvas kit the agent writes TSX against, and the runtime shell every client loads it in.",
  "type": "module",
  "exports": {
    "./kit": "./src/kit/index.ts",
    "./shell-inline": {
      "types": "./dist/shell-inline.d.ts",
      "default": "./dist/shell-inline.js"
    }
  },
  "scripts": {
    "build": "vite build && node scripts/inline.mjs",
    "clean": "rm -rf node_modules .turbo dist",
    "test": "vitest --run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@nivo/bar": "0.99.0",
    "@nivo/line": "0.99.0",
    "@nivo/pie": "0.99.0",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@stylexjs/stylex": "0.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "^5.0.4"
  }
}

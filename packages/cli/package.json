{
  "name": "nyte-ai",
  "version": "0.0.18",
  "private": false,
  "description": "Headless agent runner and terminal client for Nyte",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "coding-agent",
    "headless"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/cli"
  },
  "bin": {
    "nyte": "bin/nyte.js"
  },
  "files": [
    "bin",
    "docs",
    "src",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist",
    "package": "pnpm pack --pack-destination dist",
    "test": "vitest --run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/plugin": "workspace:*",
    "@nyte-ai/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=26"
  }
}

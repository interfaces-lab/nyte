{
  "name": "@nyte-ai/ui",
  "private": true,
  "description": "Raw-source Base UI primitives styled with StyleX and themed by consumers.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./alert-dialog": "./src/alert-dialog.ts",
    "./autocomplete": "./src/autocomplete.ts",
    "./button": "./src/button.ts",
    "./collapsible": "./src/collapsible.ts",
    "./context-menu": "./src/context-menu.ts",
    "./dialog": "./src/dialog.ts",
    "./menu": "./src/menu.ts",
    "./number-field": "./src/number-field.ts",
    "./popover": "./src/popover.ts",
    "./preview-card": "./src/preview-card.ts",
    "./select": "./src/select.ts",
    "./slider": "./src/slider.ts",
    "./sonner": "./src/sonner.ts",
    "./switch": "./src/switch.ts",
    "./tabs": "./src/tabs.ts",
    "./toggle": "./src/toggle.ts",
    "./toggle-group": "./src/toggle-group.ts",
    "./toolbar": "./src/toolbar.ts",
    "./tooltip": "./src/tooltip.ts",
    "./platform-colors": "./src/platform-colors.ts",
    "./platform-tokens.css": "./src/platform-tokens.css",
    "./tailwind.css": "./src/tailwind.css",
    "./styles.css": "./src/index.css"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "check:tokens": "node scripts/sync-platform-tokens.mjs --check",
    "sync:tokens": "node scripts/sync-platform-tokens.mjs",
    "typecheck": "pnpm check:tokens && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@stylexjs/stylex": "0.19.0",
    "central-icons": "npm:@central-icons-react/round-outlined-radius-1-stroke-1.5@^1.1.319",
    "cn": "^0.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}

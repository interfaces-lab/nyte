{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "paths": {
      "@nyte-ai/ui": ["./src"],
      "@nyte-ai/ui/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/glyphs/central.tsx"]
}

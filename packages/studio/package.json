{
  "name": "@nyte-ai/studio",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:debug": "node build.mjs --debug",
    "dev:host": "node dev/host.ts",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "check:tokens": "node scripts/sync-tokens.mjs --check",
    "typecheck": "tsc --noEmit && node scripts/sync-tokens.mjs --check",
    "clean": "rm -rf .build dist node_modules .turbo"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/bench": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/sdk": "workspace:*",
    "@nyte-ai/ui": "workspace:*",
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

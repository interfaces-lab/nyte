<use src="./tokens.lune" />

<component name="Button" label="Continue" fill="$accent" color="$on.accent">
  <row h="52" pad="0 22" gap="8" radius="$radius.control" fill="{fill}" align="center" justify="center">
    <text style="$label" size="15" color="{color}">{label}</text>
  </row>
</component>

<component name="Chip" label="Waxing" icon="moon.stars.fill">
  <row h="30" pad="0 12 0 10" gap="6" radius="15" fill="$plate.raised" stroke="$line" align="center">
    <icon name="{icon}" size="12" color="$moon" />
    <text style="$label" color="$ink.soft">{label}</text>
  </row>
</component>

<component name="Stat" label="Moonrise" value="18:42" icon="sunrise.fill">
  <col w="fill" pad="16" gap="10" radius="$radius.tile" fill="$plate" stroke="$line">
    <icon name="{icon}" size="16" color="$moon" />
    <col gap="2">
      <text style="$caption" color="$ink.faint">{label}</text>
      <text style="$title" color="$ink">{value}</text>
    </col>
  </col>
</component>

<frame name="Controls" x="0" y="0" w="390" pad="24" gap="16" radius="24" fill="$sky">
  <text style="$caption" color="$ink.faint">CONTROLS</text>
  <Button w="fill" />
  <Button w="fill" label="Not tonight" fill="$plate.raised" color="$ink" />
  <row gap="8">
    <Chip />
    <Chip label="Clear sky" icon="sparkles" />
    <Chip label="High tide" icon="water.waves" />
  </row>
  <row gap="12" w="fill">
    <Stat />
    <Stat label="Moonset" value="06:15" icon="sunset.fill" />
  </row>
</frame>

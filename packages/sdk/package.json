{
  "name": "@nyte-ai/sdk",
  "version": "0.0.23",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "react-native": "./src/index.web.ts",
      "browser": "./src/index.web.ts",
      "default": "./src/index.ts"
    },
    "./client": "./src/index.client.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "react-native": {
          "types": "./dist/src/index.web.d.ts",
          "import": "./dist/src/index.web.js"
        },
        "browser": {
          "types": "./dist/src/index.web.d.ts",
          "import": "./dist/src/index.web.js"
        },
        "default": {
          "types": "./dist/src/index.d.ts",
          "import": "./dist/src/index.js"
        }
      },
      "./client": {
        "types": "./dist/src/index.client.d.ts",
        "import": "./dist/src/index.client.js"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p tsconfig.web.json",
    "test": "vitest --run",
    "build:package": "bun ../../scripts/sdk-packages.mjs build sdk"
  },
  "dependencies": {
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*"
  },
  "devDependencies": {
    "@nyte-ai/bench": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

{
  "name": "@nyte-ai/sdk",
  "version": "0.0.16-dev.2",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfaces-lab/nyte.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "react-native": "./src/index.web.ts",
      "browser": "./src/index.web.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.web.json",
    "test": "vitest --run",
    "build:package": "bun ../../scripts/sdk-packages.mjs build sdk"
  },
  "dependencies": {
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}

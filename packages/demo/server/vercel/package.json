{
  "name": "@nyte-ai/demo-server-vercel",
  "version": "0.0.0",
  "private": true,
  "description": "A Nyte host as one Vercel Function: sessions in the instance's SQLite, runs driven in place, the wire served by @nyte-ai/server.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "clean": "rm -rf node_modules .turbo dist",
    "deploy": "pnpm build && vercel deploy --cwd dist --prod",
    "dev": "pnpm build && vercel dev --cwd dist --listen 127.0.0.1:3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/demo-server-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "vercel": "^56.5.0"
  }
}

{
  "$schema": "https://www.unpkg.com/wrangler/config-schema.json",
  "name": "nyte-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "durable_objects": {
    "bindings": [{ "name": "NYTE", "class_name": "NyteHost" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NyteHost"] }],
  "vars": {
    "NYTE_MODEL": "anthropic/claude-opus-5",
  },
}

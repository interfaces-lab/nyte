{
  "name": "@nyte-ai/demo-server-cloudflare",
  "version": "0.0.0",
  "private": true,
  "description": "A local Nyte host on a SQLite-backed Cloudflare Durable Object.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "pnpm types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "sync:codex": "node scripts/sync-codex.ts",
    "check": "node scripts/check.ts",
    "test:provider": "node scripts/check.ts --prompt"
  },
  "dependencies": {
    "@cf-wasm/photon": "0.4.0",
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/cloudflare": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@nyte-ai/server": "workspace:*",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@nyte-ai/client": "workspace:*",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "wrangler": "4.146.0"
  }
}

{
  "name": "@nyte-ai/demo-server-cloudflare",
  "version": "0.0.0",
  "private": true,
  "description": "A Nyte host as one Durable Object: sessions in its SQLite, runs driven in place, the wire served by @nyte-ai/server.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules .turbo .wrangler",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/demo-server-host": "workspace:*",
    "@nyte-ai/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "wrangler": "4.130.0"
  }
}

{
  "name": "@nyte-ai/serve",
  "version": "0.0.0",
  "private": true,
  "description": "Serve a composed Nyte SDK, and optionally the web app, from one address.",
  "bin": {
    "nyte-serve": "./bin/nyte-serve.js"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./headless": "./src/headless.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "start": "node bin/nyte-serve.js",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nyte-ai/ai": "workspace:*",
    "@nyte-ai/app": "workspace:*",
    "@nyte-ai/connect": "workspace:*",
    "@nyte-ai/core": "workspace:*",
    "@nyte-ai/host": "workspace:*",
    "@nyte-ai/protocol": "workspace:*",
    "@nyte-ai/server": "workspace:*",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@nyte-ai/client": "workspace:*",
    "@nyte-ai/schema": "workspace:*",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "boundaries": {
    "tags": {
      "lab": { "dependents": { "allow": ["lab"] } }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["CENTRAL_LICENSE_KEY"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**", "out/**"]
    },
    "@nyte-ai/ui#build": {
      "dependsOn": ["^build"],
      "env": ["NYTE_ICONS"],
      "passThroughEnv": ["CENTRAL_LICENSE_KEY"],
      "inputs": ["$TURBO_DEFAULT$", "src/glyphs/selected.generated.ts", "$TURBO_ROOT$/scripts/icons.mjs"],
      "outputs": ["dist/**"]
    },
    "@nyte-ai/web#build": {
      "dependsOn": ["^build"],
      "env": ["NYTE_ICONS"],
      "passThroughEnv": ["CENTRAL_LICENSE_KEY"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "src/lib/icon-set/selected.generated.ts",
        "$TURBO_ROOT$/scripts/icons.mjs"
      ],
      "outputs": [".output/**", "dist/**"]
    },
    "@nyte-ai/tui#build": {
      "dependsOn": ["^build"],
      "env": ["NYTE_CONNECT_ORIGIN", "NYTE_RELEASE_VERSION"],
      "outputs": ["dist/nyte", "dist/nyte.exe", "dist/nyte.version"]
    },
    "@nyte-ai/desktop#build": {
      "dependsOn": ["^build"],
      "env": ["NYTE_RELEASE_VERSION"],
      "outputs": ["out/**"]
    },
    "build:package": {
      "dependsOn": ["^build:package"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/sdk-packages.mjs",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/THIRD-PARTY-NOTICES.md"
      ],
      "outputs": ["dist/**", "LICENSE", "THIRD-PARTY-NOTICES.md"]
    },
    "package": {
      "dependsOn": ["build"],
      "env": ["NYTE_RELEASE_VERSION"],
      "cache": false
    },
    "@nyte-ai/desktop#package": {
      "dependsOn": ["build", "@nyte-ai/tui#build"],
      "env": ["NYTE_RELEASE_VERSION"],
      "cache": false
    },
    "@nyte-ai/ai#models:generate": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["transit", "^build"],
      "passThroughEnv": ["DISPLAY", "XAUTHORITY"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "@nyte-ai/web#typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "@nyte-ai/tui#typecheck": {
      "dependsOn": ["^typecheck", "@nyte-ai/canvas#build"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    }
  },
  "agentGuidance": false
}

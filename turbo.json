{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["CENTRAL_LICENSE_KEY"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**", "out/**"]
    },
    "@nyte-ai/tui#build": {
      "env": ["NYTE_CONNECT_ORIGIN"],
      "outputs": ["../../bin/nyte", "../../bin/nyte.exe"]
    },
    "package": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@nyte-ai/ai#models:generate": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "@nyte-ai/web#typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "@nyte-ai/tui#typecheck": {
      "dependsOn": ["^typecheck", "@nyte-ai/canvas#build"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    }
  },
  "agentGuidance": false
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["scripts/oxlint/anti-slop/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/oxlint/report-violations.mjs"],
      "ignoreBinaries": ["playwright"],
    },
    "packages/ai": {
      "ignoreBinaries": ["wrangler"],
    },
    "packages/app": {
      "entry": ["lint/*.js", "lint/fixtures/*.{ts,tsx}"],
      "ignoreBinaries": ["electron-vite"],
    },
    "packages/bench": {
      "entry": ["src/scenarios/*.mjs"],
    },
    "packages/canvas": {
      "entry": [
        "scripts/check-shell.mjs",
        "scripts/compile.mjs",
        "scripts/library-exports.mjs",
        "test/fixtures/*.tsx",
        "test/fixtures/*/main.tsx",
        "test/probes/*/main.tsx",
      ],
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/jetbrains-mono",
        "d3-array",
        "d3-hierarchy",
        "d3-scale",
        "d3-shape",
        "@types/d3-array",
        "@types/d3-hierarchy",
        "@types/d3-scale",
        "@types/d3-shape",
      ],
    },
    "packages/cli": {
      "ignoreBinaries": ["shasum"],
    },
    "packages/connect": {
      "ignoreIssues": { "src/schemas.ts": ["duplicates"] },
    },
    "packages/connect-worker": {
      "ignoreDependencies": ["cloudflare"],
    },
    "packages/desktop": {
      "entry": [
        "src/main/{host-entry,usage-worker,codemode-worker,codemode-runtime}.ts",
        "src/preload/{browser-page,canvas-preview}.ts",
        "src/renderer/src/devtools.tsx",
        "src/main/fixtures/*.{ts,tsx}",
        "electron-builder.config.ts",
        "scripts/check-startup-bundle.mjs",
      ],
      "ignoreDependencies": ["@anthropic-ai/claude-agent-sdk", "@lydell/node-pty", "sucrase"],
    },
    "packages/docs": {
      "ignoreDependencies": ["use-sync-external-store"],
    },
    "packages/host": {
      "entry": ["scripts/*.ts", "src/deploy/vercel/server/{routes,workflows}/**/*.ts"],
    },
    "packages/lab": {
      "entry": ["src/devtools.ts", "video/src/index.ts"],
    },
    "packages/mobile": {
      "entry": ["plugins/*.cjs"],
      "ignoreBinaries": ["eas", "build"],
      "ignoreDependencies": ["babel-plugin-react-compiler"],
    },
    "packages/tui": {
      "entry": ["src/codemode-worker.ts"],
    },
    "packages/ui": {
      "entry": ["src/styles/*.stylex.ts"],
      "ignoreDependencies": ["@babel/core", "@stylexjs/babel-plugin"],
    },
  },
}

turnsRow = frame {
  title: "One, turned (Night)",
  left: 0px,
  top: 11392px,
  width: .auto,
  height: .auto,
  layout: {stack: {item-gap: 200px}},
  children: [turn0, turn45, turn90, turn135, turn180, turn225, turn270, turn315],

  turn0 = frame : plates.appIcon {
    caption: "0°",

    plate {
      art {
        moonA {
          transform: [1, 0, 208, 0, 1, 136]
        }
      }
    }
  }

  turn45 = frame : plates.appIcon {
    caption: "45°",

    plate {
      art {
        moonA {
          transform: [0.7071, -0.7071, 462.91, 0.7071, 0.7071, 72.5887]
        }
      }
    }
  }

  turn90 = frame : plates.appIcon {
    caption: "90°",

    plate {
      art {
        moonA {
          transform: [0, -1, 688, 1, 0, 208]
        }
      }
    }
  }

  turn135 = frame : plates.appIcon {
    caption: "135°",

    plate {
      art {
        moonA {
          transform: [-0.7071, -0.7071, 751.41, 0.7071, -0.7071, 462.91]
        }
      }
    }
  }

  turn180 = frame : plates.appIcon {
    caption: "180°",

    plate {
      art {
        moonA {
          transform: [-1, 0, 616, 0, -1, 688]
        }
      }
    }
  }

  turn225 = frame : plates.appIcon {
    caption: "225°",

    plate {
      art {
        moonA {
          transform: [-0.7071, 0.7071, 361.0883, -0.7071, -0.7071, 751.41]
        }
      }
    }
  }

  turn270 = frame : plates.appIcon {
    caption: "270°",

    plate {
      art {
        moonA {
          transform: [0, 1, 136, -1, 0, 616]
        }
      }
    }
  }

  turn315 = frame : plates.appIcon {
    caption: "315°",

    plate {
      art {
        moonA {
          transform: [0.7071, 0.7071, 72.5887, -0.7071, 0.7071, 361.0883]
        }
      }
    }
  }
}

import "./app-icon.elyx" as plates
import "./arrangements.elyx" as arr

// Every arrangement on every plate, one row per arrangement, plus one crescent turned in 45° steps.
// Retune a plate in app-icon.elyx, a placement in arrangements.elyx, or the crescent in moon.elyx.
singleRow = frame {
  title: "One",
  left: 0px,
  top: 0px,
  width: .auto,
  height: .auto,
  layout: {stack: {item-gap: 200px}},
  children: [
    singleNight,
    singleDusk,
    singleTwilight,
    singleHaze,
    singleInk,
    singleIndigo,
    singleMist,
    singlePaper
  ],

  singleNight = frame : plates.appIcon {
    caption: "Night"
  }

  singleDusk = frame : plates.dusk {
    caption: "Dusk"
  }

  singleTwilight = frame : plates.twilight {
    caption: "Twilight"
  }

  singleHaze = frame : plates.haze {
    caption: "Haze"
  }

  singleInk = frame : plates.ink {
    caption: "Ink"
  }

  singleIndigo = frame : plates.indigo {
    caption: "Indigo"
  }

  singleMist = frame : plates.mist {
    caption: "Mist"
  }

  singlePaper = frame : plates.paper {
    caption: "Paper"
  }
}


import "./moon.elyx" as m

// How crescents sit on the plate: each arrangement places instances of the moon on the 824px plate.
// Pick one on an icon with @with-variant on its `art` layer. Every moon's transform is scale, turn and
// position in one matrix, so a turn or nudge is one edit.
@variants(pair, trio, quad, quadOut, cross, pinwheel, ring)
export single = frame {
  title: "One",
  left: 0px,
  top: 0px,
  width: 824px,
  height: 824px,
  children: moonA,

  moonA = frame : m.moon {
    left: 0px,
    top: 0px,
    transform: [1, 0, 208, 0, 1, 136]
  }
}

export pair = frame : single {
  title: "Two, facing",
  left: 1024px,
  top: 0px,
  overrides: [insert(moonB, after = single.moonA)],

  moonA {
    transform: [0.42, -0.42, 207, 0.42, 0.42, 208.35]
  }

  moonB = frame : m.moon {
    left: 0px,
    top: 0px,
    transform: [-0.42, 0.42, 617, -0.42, -0.42, 615.6468]
  }
}

export trio = frame : single {
  title: "Three, facing",
  left: 2048px,
  top: 0px,
  overrides: [insert(moonB, after = single.moonA), insert(moonC, after = moonB)],

  moonA {
    transform: [-0.3677, -0.3677, 588.49, 0.3677, -0.3677, 207]
  }

  moonB = frame : m.moon {
    left: 0px,
    top: 0px,
    transform: [-0.13, 0.5, 501.2883, -0.5, -0.13, 667.3482]
  }

  moonC = frame : m.moon {
    left: 0px,
    top: 0px,
    transform: [0.5, -0.13, 146.2179, 0.13, 0.5, 361.65]
  }
}

export quad = frame : single {
  title: "Four corners, facing",
  left: 3072px,
  top: 0px,
  overrides: [
    insert(moonB, after = single.moonA),
    insert(moonC, after = moonB),
    insert(moonD, after = moonC)
  ],

  moonA {
    transform: [0, -0.56, 369.62, 0.56, 0, 100.82]
  }

  moonB = frame : m.moon {
    left: 0px,
    top: 0px,
    transform: [-0.56, 0, 723.1767, 0, -0.56, 369.62]
  }

  moonC = frame : m.moon {
    left: 0px,
    top: 0px,
    transform: [0, 0.56, 454.3767, -0.56, 0, 723.1767]
  }

  moonD = frame : m.moon {
    left: 0px,
    top: 0px,
    transform: [0.56, 0, 100.82, 0, 0.56, 454.3767]
  }
}

export quadOut = frame : single {
  title: "Four corners, turned out",
  left: 4096px,
  top: 0px,
  overrides: [
    insert(moonB, after = single.moonA),
    insert(moonC, after = moonB),
    insert(moonD, after = moonC)
  ],

  moonA {
    transform: [0, 0.56, 100.82, -0.56, 0, 369.62]
  }

  moonB = frame : m.moon {
    left: 0px,
    top: 0px,
    transform: [0.56, 0, 454.3767, 0, 0.56, 100.82]
  }

  moonC = frame : m.moon {
    left: 0px,
    top: 0px,
    transform: [0, -0.56, 723.1767, 0.56, 0, 454.3767]
  }

  moonD = frame : m.moon {
    left: 0px,
    top: 0px,
    transform: [-0.56, 0, 369.62, 0, -0.56, 723.1767]
  }
}

export cross = frame : single {

// Shadow colours for the elevation steps: near and mid are the tight and soft layers, far is the deep layer of shadowXl.
@variants(dark.shadow)
export shadow = tokens {
  near: #42230308,
  mid: #2a1c0012,
  far: #1b150030,
  workbench: #00000014

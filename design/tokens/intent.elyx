// Generated from @nyte-ai/ui (platform-colors and the compiled roles). Regenerate instead of editing.
import "./intent-dark.elyx" as dark

// Intent scopes (surface-theme intent): primary is blue with the accent button fill, success green, warning yellow, danger red with accent secondary ink.
// Each carries only the roles a hue scope recolours; read every other colour from color.role.

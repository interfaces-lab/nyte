use ".local/proof/editor-gaps/folding/renderer-budget/without-worker-hook/assets/inter-latin-opsz-normal-BwkfbSeq.woff2"
use "node_modules/.pnpm/node_modules/@nyte-ai/lab/dist/client/assets/inter-cyrillic-ext-opsz-normal-CfYZpDVp.woff2"
use "node_modules/.pnpm/node_modules/@nyte-ai/web/node_modules/.nitro/vite/services/ssr/assets/inter-vietnamese-wght-normal-CBcvBZtf.woff2"
use "scripts/brand/fonts/Inter-Medium.ttf"
use "node_modules/.pnpm/node_modules/@nyte-ai/lab/.local/models-film/dist-vscode/assets/inter-vietnamese-opsz-normal-Ci9T9ieq.woff2"

import "./nyte-mark.svg" as mark
import "../icons/arrow-right.svg" as arrowRight
import "../icons/provider-opencode.svg" as iconOpencode
import "../icons/server.svg" as iconServer
import "../icons/laptop.svg" as iconLaptop
import "../icons/provider-vercel.svg" as iconVercel
import "../icons/copy.svg" as iconCopy
import "../icons/github.svg" as iconGithub
import "../icons/model-anthropic.svg" as iconAnthropic
import "../icons/model-openai.svg" as iconOpenai
import "../icons/provider-copilot.svg" as iconCopilot
import "../icons/provider-openrouter.svg" as iconOpenrouter
import "../tokens/color.elyx" as c
import "../tokens/intent.elyx" as intent
import "../icons/panel-left.svg" as iconPanelLeft
import "../icons/panel-right.svg" as iconPanelRight
import "../icons/split-right.svg" as iconSplitRight
import "../icons/split-down.svg" as iconSplitDown
import "../icons/bell.svg" as iconBell
import "../icons/new-chat.svg" as iconNewChat
import "../icons/search.svg" as iconSearch
import "../icons/customize.svg" as iconCustomize
import "../icons/settings.svg" as iconSettings
import "../icons/chevron-right.svg" as iconChevronRight
import "../icons/chevron-down.svg" as iconChevronDown
import "../icons/folder.svg" as iconFolder
import "../icons/filters.svg" as iconFilters
import "../icons/folder-add.svg" as iconFolderAdd
import "../icons/fork.svg" as iconFork
import "../icons/console.svg" as iconConsole
import "../icons/plus.svg" as iconPlus
import "../icons/arrow-up.svg" as iconArrowUp
import "../icons/speed-low.svg" as iconSpeed
import "../icons/ruler.svg" as iconRuler
import "../icons/diff.svg" as iconDiff
import "../icons/git-branch.svg" as iconBranch
import "../icons/arrow-down.svg" as iconArrowDown
import "../icons/loader.svg" as iconLoader
import "../icons/bubble-question-filled.svg" as iconWaiting
import "../icons/pin.svg" as iconPin
import "../icons/archive.svg" as iconArchive

// nyte.sh home, after butter.video: floating nav pills, a sculpted object over a huge headline,
// a sentence with objects between its words, a product panel, split features and a grey footer.
// The desktop app is the product: the hero sells the download, the window is the real light shell, and the CLI is a footnote.
// Dream palette: the moon's periwinkle ramp (#A9BCEC → #7A93D6 → #23294A), a pink glow (#FFB3D1), and one sharp electric blue (#2F45FF) for what to click.
home = frame {
  doc: "Scroll: Lenis smooth scroll (lerp ~0.1) on the whole page; every scrubbed effect reads Lenis progress. Under prefers-reduced-motion: no smooth scroll, no scrubbing, text and objects show in their end state, marquees stop.",
  width: 1440px,
  height: .auto,
  layout: {stack: {direction: .column}},
  fill: rgb(92.549%, 92.549%, 92.549%),
  children: [page, footer],

  page = frame {
    width: 100%,
    height: .auto,
    layout: {stack: {direction: .column, align-items: .center}},
    fill: rgb(98.0392%, 98.0392%, 98.0392%),
    corner-radius: [0px, 0px, 48px, 48px],
    overflow: .clip,
    padding-bottom: 180px,
    children: [
      hero,
      providers,
      statement,
      desktop,
      fork,
      deploy,
      clients,
      install,
      nav
    ],

    // Two pills over the page, like butter's: brand and links left, actions right.
    nav = frame {
      doc: "Motion: fades in with the hero (opacity 0→1, 400ms ease-out, 200ms after the headline starts). After ~600px of scroll the left pill collapses: links fade out (150ms) and the pill eases to brand + a ⋮ button (300ms cubic-bezier(0.16,1,0.3,1)); it expands again at the top. The right pill never changes.",
      left: 96px,
      top: 24px,
      width: 1248px,
      height: 64px,
      ignore-stack: .true,
      layout: {stack: {justify-content: .space-between, align-items: .center}},
      children: [navLeft, navRight],

      navLeft = frame {
        width: .auto,
        height: 64px,
        layout: {stack: {align-items: .center, item-gap: 32px}},
        fill: rgb(92.94%, 92.94%, 92.94%, 90.1961%),
        filter: {type: .background-blur, radius: 24px},
        corner-radius: 16px,
        padding: [0px, 26px, 0px, 20px],
        children: [brand, navLinks],

        brand = frame {
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 7px}},
          children: [brandMark, brandName],

          brandMark = asset {
            width: 22px,
            height: 22px,
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: mark
          }

          brandName = text {
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: "nyte",
            font-size: 23,
            font-family: "Inter Variable",
            font-style: "SemiBold",
            letter-spacing: -5%
          }
        }

        navLinks = frame {
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 26px}},
          children: [linkDocs, linkSdk, linkDesktop, linkDesign],

          linkDocs = text {
            fill: rgb(11.76%, 11.76%, 11.76%),
            contents: "Docs",
            font-size: 17,
            font-family: "Inter Variable"
          }

          linkSdk = text {
            fill: rgb(11.76%, 11.76%, 11.76%),
            contents: "SDK",
            font-size: 17,
            font-family: "Inter Variable"
          }

          linkDesktop = text {
            fill: rgb(11.76%, 11.76%, 11.76%),
            contents: "Desktop",
            font-size: 17,
            font-family: "Inter Variable"
          }

          linkDesign = text {
            fill: rgb(11.76%, 11.76%, 11.76%),
            contents: "Design",
            font-size: 17,
            font-family: "Inter Variable"
          }
        }
      }

      navRight = frame {
        width: .auto,
        height: 60px,
        layout: {stack: {align-items: .center, item-gap: 18px}},
        fill: rgb(92.94%, 92.94%, 92.94%, 90.1961%),
        filter: {type: .background-blur, radius: 24px},
        corner-radius: 16px,
        padding: [0px, 12px, 0px, 18px],
        children: [navGithub, navDownload],

        navGithub = frame {
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 7px}},
          children: [navGithubIcon, navGithubLabel],

          navGithubIcon = asset {
            width: 18px,
            height: 18px,
            fill: rgb(11.76%, 11.76%, 11.76%),
            contents: iconGithub
          }

          navGithubLabel = text {
            fill: rgb(11.76%, 11.76%, 11.76%),
            contents: "GitHub",
            font-size: 17,
            font-family: "Inter Variable"
          }
        }

        navDownload = frame {
          width: .auto,
          height: 36px,
          layout: {stack: {align-items: .center, item-gap: 7px}},
          fill: rgb(11.76%, 11.76%, 11.76%),
          corner-radius: 8px,
          padding: [0px, 16px, 0px, 13px],
          children: [navDownloadIcon, navDownloadLabel],

          navDownloadIcon = asset {
            width: 16px,
            height: 16px,
            fill: rgb(98.0392%, 98.0392%, 98.0392%),
            contents: iconArrowDown
          }

          navDownloadLabel = text {
            fill: rgb(98.0392%, 98.0392%, 98.0392%),
            contents: "Download",
            font-size: 17,
            font-family: "Inter Variable"
          }
        }
      }
    }

    // The crescent, lit like the app icon, with the facts of one live session orbiting it.
    hero = frame {
      doc: "Intro, time-based, ~1.6s: the wash (#D9D9D9→#FAFAFA) fades in over 400ms. The headline resolves: blur 12px→0 with a cyan→pink gradient ink easing to #0F0F0F, 800ms ease-out. The moon rises 24px→0 and scales 0.94→1 on a spring (stiffness 120, damping 14), then its glow breathes (opacity 0.45↔0.6, 4s loop). The four desktop pieces settle onto their tilts one by one, 80ms apart, each from 16px lower and untilted. Subline and actions line-reveal last (600ms).",
      width: 100%,
      height: .auto,
      layout: {stack: {direction: .column, align-items: .center}},
      fill: {
        linear-gradient: {
          angle: 180deg,
          stops: [
            stop(0%, rgb(85.098%, 85.098%, 85.098%)),
            stop(100%, rgb(98.0392%, 98.0392%, 98.0392%))
          ]
        }
      },
      padding: [112px, 0px],
      children: [
        sculpture,
        headline,
        sublineGap,
        subline,
        actionsGap,
        heroActions
      ],

      sculpture = frame {
        width: 860px,
        height: 320px,
        children: [
          glow,
          moon,
          chipHostPicker,
          chipSteer,
          chipApproval,
          chipActions
        ],

        glow = shape {
          left: 300px,
          top: 44px,
          width: 260px,
          height: 260px,
          opacity: 0.55,
          fill: rgb(47.84%, 57.6471%, 83.92%),
          filter: {type: .gaussian-blur, radius: 64px},
          type: .ellipse
        }

        moon = boolean {
          left: 310px,
          top: 28px,
          width: 240px,
          height: 240px,
          fill: {
            radial-gradient: {
              at: point(72%, 38%),
              angle: 0deg,
              radius: 110%,
              stops: [
                stop(0%, rgb(86.27%, 89.8%, 98.43%)),
                stop(45%, rgb(66.27%, 73.7255%, 92.549%)),
                stop(100%, rgb(30.5882%, 40%, 70.98%))
              ]
            }
          },
          shadow: [
            {
              drop-shadow: {
                color: rgb(16.47%, 18.82%, 88.6274%, 20%),
                offset: point(0px, 30px),
                blur-radius: 60px
              }
            },
            {
              inner-shadow: {
                color: rgb(100%, 100%, 100%, 60%),
                offset: point(-6px, 6px),
                blur-radius: 14px
              }
            }
          ],
          operation: .subtract,
          children: [moonDisc, moonBite],

          moonDisc = shape {
            left: 0px,
            top: 0px,
            width: 240px,
            height: 240px,
            fill: .black,
            type: .ellipse
          }

          moonBite = shape {
            left: 98px,
            top: -22px,
            width: 162px,
            height: 162px,
            fill: .black,
            type: .ellipse
          }
        }

        // Real desktop pieces, floating: the host picker, the composer mid-run, an approval, a reply's actions.
        chipHostPicker = frame {
          left: 84px,
          top: 70px,
          width: .auto,
          height: 36px,
          transform: [0.996, -0.087, 0, 0.087, 0.996, 0],
          layout: {stack: {align-items: .center, item-gap: 7px}},
          fill: c.role.bg-elevated,
          border: c.role.stroke-tertiary,
          shadow: {
            drop-shadow: {
              color: rgb(5.88%, 5.88%, 5.88%, 10.1961%),
              offset: point(0px, 12px),
              blur-radius: 24px
            }
          },
          corner-radius: 18px,
          padding: [0px, 14px, 0px, 12px],
          children: [chipHostDot, chipHostIcon, chipHostLabel, chipHostChevron],

          chipHostDot = shape {
            width: 8px,
            height: 8px,
            fill: rgb(13.33%, 82.7451%, 41.96%),
            shadow: {
              drop-shadow: {
                color: rgb(13.33%, 82.7451%, 41.96%, 60%),
                offset: point(0px, 0px),
                blur-radius: 6px
              }
            },
            type: .ellipse
          }

          chipHostIcon = asset {
            width: 15px,
            height: 15px,
            fill: c.role.content-primary,
            contents: iconLaptop
          }

          chipHostLabel = text {
            fill: c.role.content-primary,
            contents: "This Mac",
            font-size: 14,
            font-family: "Inter Variable",
            font-style: "Medium"
          }

          chipHostChevron = asset {
            width: 11px,
            height: 11px,
            fill: c.role.content-tertiary,
            contents: iconChevronDown
          }
        }

        chipSteer = frame {
          left: 560px,
          top: 40px,
          width: 270px,
          height: 44px,
          transform: [0.99, 0.12, 0, -0.12, 0.99, 0],
          layout: {
            stack: {justify-content: .space-between, align-items: .center}
          },
          fill: c.role.bg-elevated,
          border: c.role.stroke-tertiary,
          shadow: {
            drop-shadow: {
              color: rgb(5.88%, 5.88%, 5.88%, 10.1961%),
              offset: point(0px, 14px),
              blur-radius: 28px
            }
          },
          corner-radius: 22px,
          padding: [0px, 6px],
          children: [chipSteerLead, chipSteerStop],

          chipSteerLead = frame {
            width: .auto,
            height: .auto,
            layout: {stack: {align-items: .center, item-gap: 10px}},
            children: [chipSteerPlus, chipSteerText],

            chipSteerPlus = frame {
              width: 32px,
              height: 32px,
              layout: {stack: {justify-content: .center, align-items: .center}},
              fill: c.role.fill-tertiary,
              corner-radius: 16px,
              children: chipSteerPlusIcon,

              chipSteerPlusIcon = asset {
                width: 13px,
                height: 13px,
                fill: c.role.content-secondary,
                contents: iconPlus
              }
            }

            chipSteerText = text {
              fill: c.role.content-tertiary,
              contents: "Steer without stopping",
              font-size: 14,
              font-family: "Inter Variable"
            }
          }

          chipSteerStop = frame {
            width: 32px,
            height: 32px,
            layout: {stack: {justify-content: .center, align-items: .center}},
            fill: {
              linear-gradient: {
                angle: 180deg,
                stops: [
                  stop(0%, rgb(41.5686%, 50.1961%, 100%)),
                  stop(100%, rgb(18.43%, 27.0588%, 100%))
                ]
              }
            },
            shadow: [
              {
                drop-shadow: {
                  color: rgb(18.43%, 27.0588%, 100%, 45.098%),
                  offset: point(0px, 4px),
                  blur-radius: 12px
                }
              },
              {
                inner-shadow: {
                  color: rgb(100%, 100%, 100%, 45.098%),
                  offset: point(0px, 1px),
                  blur-radius: 1px
                }
              }
            ],
            corner-radius: 16px,
            children: chipSteerStopSquare,

            chipSteerStopSquare = shape {
              width: 11px,
              height: 11px,
              fill: .white,
              type: .rect,
              corner-radius: 2.5px
            }
          }
        }

        chipApproval = frame {
          left: 96px,
          top: 214px,
          width: .auto,
          height: .auto,
          transform: [0.996, 0.087, 0, -0.087, 0.996, 0],
          layout: {stack: {align-items: .center, item-gap: 6px}},
          fill: c.role.bg-elevated,
          border: c.role.stroke-tertiary,
          shadow: {
            drop-shadow: {
              color: rgb(5.88%, 5.88%, 5.88%, 10.1961%),
              offset: point(0px, 14px),
              blur-radius: 28px
            }
          },
          corner-radius: 14px,
          padding: 10px,
          children: [chipAllow, chipDeny],

          chipAllow = frame {
            width: .auto,
            height: 28px,
            layout: {stack: {align-items: .center}},
            fill: {
              linear-gradient: {
                angle: 180deg,
                stops: [
                  stop(0%, rgb(41.5686%, 50.1961%, 100%)),
                  stop(100%, rgb(18.43%, 27.0588%, 100%))
                ]
              }
            },
            shadow: [
              {
                drop-shadow: {
                  color: rgb(18.43%, 27.0588%, 100%, 34.9%),
                  offset: point(0px, 3px),
                  blur-radius: 8px
                }
              },
              {
                inner-shadow: {
                  color: rgb(100%, 100%, 100%, 34.9%),
                  offset: point(0px, 1px),
                  blur-radius: 1px
                }
              }
            ],
            corner-radius: 8px,
            padding: [0px, 10px],
            children: chipAllowText,

            chipAllowText = text {
              fill: .white,
              contents: "Allow once",
              font-size: 13,
              font-family: "Inter Variable",
              font-style: "Medium"
            }
          }

          chipDeny = frame {
            width: .auto,
            height: 28px,
            layout: {stack: {align-items: .center}},
            border: c.role.stroke-tertiary,
            corner-radius: 8px,
            padding: [0px, 10px],
            children: chipDenyText,

            chipDenyText = text {
              fill: c.role.content-secondary,
              contents: "Deny",
              font-size: 13,
              font-family: "Inter Variable",
              font-style: "Medium"
            }
          }
        }

        chipActions = frame {
          left: 600px,
          top: 214px,
          width: .auto,
          height: 36px,
          transform: [0.99, -0.139, 0, 0.139, 0.99, 0],
          layout: {stack: {align-items: .center, item-gap: 12px}},
          fill: c.role.bg-elevated,
          border: c.role.stroke-tertiary,
          shadow: {
            drop-shadow: {
              color: rgb(5.88%, 5.88%, 5.88%, 10.1961%),
              offset: point(0px, 12px),
              blur-radius: 24px
            }
          },
          corner-radius: 18px,
          padding: [0px, 14px],
          children: [chipActionsCopy, chipActionsFork, chipActionsTime],

          chipActionsCopy = asset {
            width: 14px,
            height: 14px,
            fill: c.role.content-tertiary,
            contents: iconCopy
          }

          chipActionsFork = asset {
            width: 14px,
            height: 14px,
            fill: c.role.content-tertiary,
            contents: iconFork
          }

          chipActionsTime = text {
            fill: c.role.content-tertiary,
            contents: "4m ago",
            font-size: 13,
            font-family: "Inter Variable"
          }
        }
      }

      headline = text {
        fill: rgb(5.88%, 5.88%, 5.88%),
        contents: "Engineered for durability",
        font-size: 124,
        font-family: "Inter Variable",
        font-style: "Medium",
        line-height: 1.05,
        letter-spacing: -5%
      }

      sublineGap = frame {
        width: 10px,
        height: 22px
      }

      subline = text {
        fill: rgb(5.88%, 5.88%, 5.88%),
        contents: "The Mac app for agents, on every AI provider",
        font-size: 25,
        font-family: "Inter Variable",
        letter-spacing: -1.5%
      }

      actionsGap = frame {
        width: 10px,
        height: 36px
      }

      // Desktop first: one bright button to download the app; the CLI is a quiet line under it.
      heroActions = frame {
        width: .auto,
        height: .auto,
        layout: {
          stack: {direction: .column, align-items: .center, item-gap: 20px}
        },
        children: [heroButtons, heroCli],

        heroButtons = frame {
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 12px}},
          children: [heroDownload, heroDocs],

          heroDownload = frame {
            doc: "Hover: lifts 1px and the glow grows (blur 28→36px, 200ms ease-out). Press: scale 0.97. Detects the platform; on Linux the label reads 'Download for Linux'.",
            width: .auto,
            height: 56px,
            layout: {stack: {align-items: .center, item-gap: 10px}},
            fill: {
              linear-gradient: {
                angle: 180deg,
                stops: [
                  stop(0%, rgb(41.5686%, 50.1961%, 100%)),
                  stop(100%, rgb(18.43%, 27.0588%, 100%))
                ]
              }
            },
            shadow: [
              {
                drop-shadow: {
                  color: rgb(18.43%, 27.0588%, 100%, 40%),
                  offset: point(0px, 12px),
                  blur-radius: 28px
                }
              },
              {
                inner-shadow: {
                  color: rgb(100%, 100%, 100%, 40%),
                  offset: point(0px, 1.5px),
                  blur-radius: 1px
                }
              },
              {
                inner-shadow: {
                  color: rgb(5.098%, 9.41%, 65.098%, 30.1961%),
                  offset: point(0px, -2px),
                  blur-radius: 4px
                }
              }
            ],
            corner-radius: 16px,
            padding: [0px, 26px, 0px, 22px],
            children: [heroDownloadIcon, heroDownloadLabel],

            heroDownloadIcon = asset {
              width: 20px,
              height: 20px,
              fill: .white,
              contents: iconArrowDown
            }

            heroDownloadLabel = text {
              fill: .white,
              contents: "Download for Mac",
              font-size: 18,
              font-family: "Inter Variable",
              font-style: "Medium",
              letter-spacing: -1%
            }
          }

          heroDocs = frame {
            width: .auto,
            height: 56px,
            layout: {stack: {align-items: .center, item-gap: 10px}},
            fill: rgb(100%, 100%, 100%, 70.1961%),
            border: rgb(5.88%, 5.88%, 5.88%, 7.0588%),
            corner-radius: 16px,
            padding: [0px, 20px, 0px, 22px],
            children: [heroDocsLabel, heroDocsArrow],

            heroDocsLabel = text {
              fill: rgb(11.76%, 11.76%, 11.76%),
              contents: "Docs",
              font-size: 17,
              font-family: "Inter Variable"
            }

            heroDocsArrow = asset {
              width: 18px,
              height: 18px,
              fill: rgb(11.76%, 11.76%, 11.76%),
              contents: arrowRight
            }
          }
        }

        heroCli = frame {
          doc: "Click copies the command; the copy glyph swaps to a check for 1.2s.",
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 8px}},
          children: [heroCliLead, heroCliCommand, heroCliCopy],

          heroCliLead = text {
            fill: rgb(5.88%, 5.88%, 5.88%, 45.098%),
            contents: "Prefer the terminal?",
            font-size: 14,
            font-family: "Inter Variable"
          }

          heroCliCommand = text {
            fill: rgb(5.88%, 5.88%, 5.88%, 65.098%),
            contents: "curl -fsSL nyte.sh/install | sh",
            font-size: 13,
            font-family: "Menlo"
          }

          heroCliCopy = asset {
            width: 13px,
            height: 13px,
            fill: rgb(5.88%, 5.88%, 5.88%, 45.098%),
            contents: iconCopy
          }
        }
      }
    }

    // Provider strip: the sign-ins Nyte ships (packages/ai providers), in butter's logo-ticker slot.
    providers = frame {
      doc: "Motion: marquee. The row repeats and moves left at a constant ~120 px/s, forever; hover does not pause it. On first view each logo rises 30px→0 over 800ms cubic-bezier(0,0,0,1) with opacity 0→1 over 528ms linear, staggered 100ms left to right.",
      width: 100%,
      height: .auto,
      layout: {
        stack: {direction: .column, align-items: .center, item-gap: 40px}
      },
      children: [providersLead, providerRow],

      providersLead = text {
        fill: rgb(5.88%, 5.88%, 5.88%, 40%),
        contents: "Use the plan you already pay for",
        font-size: 21,
        font-family: "Inter Variable",
        letter-spacing: -1%
      }

      providerRow = frame {
        width: .auto,
        height: .auto,
        layout: {stack: {align-items: .center, item-gap: 64px}},
        children: [pClaude, pChatgpt, pCopilot, pOpenrouter, pOpencode, pVercel],

        pClaude = frame {
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 10px}},
          children: [pClaudeIcon, pClaudeName],

          pClaudeIcon = asset {
            width: 28px,
            height: 28px,
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: iconAnthropic
          }

          pClaudeName = text {
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: "Claude Pro/Max",
            font-size: 24,
            font-family: "Inter Variable",
            font-style: "SemiBold",
            letter-spacing: -4%
          }
        }

        pChatgpt = frame {
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 10px}},
          children: [pChatgptIcon, pChatgptName],

          pChatgptIcon = asset {
            width: 28px,
            height: 28px,
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: iconOpenai
          }

          pChatgptName = text {
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: "ChatGPT Plus/Pro",
            font-size: 24,
            font-family: "Inter Variable",
            font-style: "SemiBold",
            letter-spacing: -4%
          }
        }

        pCopilot = frame {
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 10px}},
          children: [pCopilotIcon, pCopilotName],

          pCopilotIcon = asset {
            width: 28px,
            height: 28px,
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: iconCopilot
          }

          pCopilotName = text {
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: "GitHub Copilot",
            font-size: 24,
            font-family: "Inter Variable",
            font-style: "SemiBold",
            letter-spacing: -4%
          }
        }

        pOpenrouter = frame {
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 10px}},
          children: [pOpenrouterIcon, pOpenrouterName],

          pOpenrouterIcon = asset {
            width: 28px,
            height: 28px,
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: iconOpenrouter
          }

          pOpenrouterName = text {
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: "OpenRouter",
            font-size: 24,
            font-family: "Inter Variable",
            font-style: "SemiBold",
            letter-spacing: -4%
          }
        }

        pOpencode = frame {
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 10px}},
          children: [pOpencodeIcon, pOpencodeName],

          pOpencodeIcon = asset {
            width: 28px,
            height: 28px,
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: iconOpencode
          }

          pOpencodeName = text {
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: "OpenCode",
            font-size: 24,
            font-family: "Inter Variable",
            font-style: "SemiBold",
            letter-spacing: -4%
          }
        }

        pVercel = frame {
          width: .auto,
          height: .auto,
          layout: {stack: {align-items: .center, item-gap: 10px}},
          children: [pVercelIcon, pVercelName],

          pVercelIcon = asset {
            width: 26px,
            height: 26px,
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: iconVercel
          }

          pVercelName = text {
            fill: rgb(5.88%, 5.88%, 5.88%),
            contents: "AI Gateway",
            font-size: 24,
            font-family: "Inter Variable",
            font-style: "SemiBold",
            letter-spacing: -4%
          }
        }
      }
    }

    // The statement. Each inline object is a real piece of the desktop window below; on scroll they fly into it.
    statement = frame {
      doc: "Motion 1, words: each word is scrubbed by scroll over ~250px as it enters: opacity 0→1, blur 8px→0, a cyan→pink gradient ink that hue-rotates 0→160deg and settles to #0F0F0F. Words stagger in reading order. Motion 2, shared elements: once the sentence is read, the two inline objects scale from their inline size (~0.29) to full size and travel to their places in the desktop window (the send button into the composer, the host picker under it), scrubbed over ~900px of scroll, staggered ~100px each. The window rises behind them from scale 0.92.",
      width: 100%,
      height: .auto,
      layout: {stack: {direction: .column, align-items: .center, item-gap: 8px}},
      padding: [210px, 0px, 200px],
      children: [lineOne, lineTwo],

      lineOne = frame {
        width: .auto,
        height: .auto,
        layout: {stack: {align-items: .center, item-gap: 24px}},
        children: [lineOneA, inlineSend, lineOneB],

        lineOneA = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Every message",
          font-size: 68,
          font-family: "Inter Variable",
          line-height: 1.14,
          letter-spacing: -5%
        }

        // Sculpted like butter's inline objects: a glossy electric-blue key that is the composer's send button.
        inlineSend = frame {
          doc: "Hover: tilts -6deg and lifts 4px on a spring (stiffness 300, damping 18); the arrow nudges up 2px. On scroll this key shrinks into the composer's send button.",
          width: 84px,
          height: 84px,
          layout: {stack: {justify-content: .center, align-items: .center}},
          fill: {
            radial-gradient: {
              at: point(30%, 18%),
              angle: 0deg,
              radius: 120%,
              stops: [
                stop(0%, rgb(65.88%, 72.1569%, 100%)),
                stop(42%, rgb(23.92%, 33.33%, 100%)),
                stop(100%, rgb(9.41%, 12.549%, 76.86%))
              ]
            }
          },
          shadow: [
            {
              drop-shadow: {
                color: rgb(18.43%, 27.0588%, 100%, 43.92%),
                offset: point(0px, 18px),
                blur-radius: 34px
              }
            },
            {
              drop-shadow: {
                color: rgb(9.41%, 12.549%, 76.86%, 25.098%),
                offset: point(0px, 3px),
                blur-radius: 6px
              }
            },
            {
              inner-shadow: {
                color: rgb(100%, 100%, 100%, 65.098%),
                offset: point(0px, 2px),
                blur-radius: 2px
              }
            },
            {
              inner-shadow: {
                color: rgb(3.92%, 6.27%, 47.84%, 45.098%),
                offset: point(0px, -6px),
                blur-radius: 12px
              }
            }
          ],
          corner-radius: 26px,
          children: inlineSendIcon,

          inlineSendIcon = asset {
            width: 40px,
            height: 40px,
            fill: .white,
            shadow: {
              drop-shadow: {
                color: rgb(3.92%, 6.27%, 47.84%, 50.1961%),
                offset: point(0px, 2px),
                blur-radius: 4px
              }
            },
            contents: iconArrowUp
          }
        }

        lineOneB = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "is a commit.",
          font-size: 68,
          font-family: "Inter Variable",
          line-height: 1.14,
          letter-spacing: -5%
        }
      }

      lineTwo = frame {
        width: .auto,
        height: .auto,
        layout: {stack: {align-items: .center, item-gap: 24px}},
        children: [lineTwoA, inlineHost, lineTwoB],

        lineTwoA = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "If the process dies,",
          font-size: 68,
          font-family: "Inter Variable",
          line-height: 1.14,
          letter-spacing: -5%
        }

        // The host picker as a black lacquer tile with a live green light: the run is on this Mac.
        inlineHost = frame {
          doc: "Hover: lifts 4px and the green light pulses once (scale 1→1.4→1, glow 10→18px, 600ms). On scroll it shrinks into the host picker under the composer.",
          width: .auto,
          height: 84px,
          layout: {stack: {align-items: .center, item-gap: 10px}},
          fill: {
            linear-gradient: {
              angle: 180deg,
              stops: [
                stop(0%, rgb(18.82%, 18.82%, 21.1765%)),
                stop(100%, rgb(2.7451%, 2.7451%, 3.5294%))
              ]
            }
          },
          shadow: [
            {
              drop-shadow: {
                color: rgb(0%, 0%, 0%, 32.1569%),
                offset: point(0px, 18px),
                blur-radius: 34px
              }
            },
            {
              inner-shadow: {
                color: rgb(100%, 100%, 100%, 27.84%),
                offset: point(0px, 1.5px),
                blur-radius: 1px
              }
            },
            {
              inner-shadow: {
                color: rgb(0%, 0%, 0%, 60%),
                offset: point(0px, -5px),
                blur-radius: 10px
              }
            }
          ],
          corner-radius: 26px,
          padding: [0px, 22px, 0px, 20px],
          children: [inlineHostDot, inlineHostIcon, inlineHostLabel],

          inlineHostDot = shape {
            width: 11px,
            height: 11px,
            fill: rgb(16.86%, 94.9%, 48.6275%),
            shadow: {
              drop-shadow: {
                color: rgb(16.86%, 94.9%, 48.6275%, 80%),
                offset: point(0px, 0px),
                blur-radius: 10px
              }
            },
            type: .ellipse
          }

          inlineHostIcon = asset {
            width: 24px,
            height: 24px,
            fill: .white,
            contents: iconLaptop
          }

          inlineHostLabel = text {
            fill: .white,
            contents: "This Mac",
            font-size: 19,
            font-family: "Inter Variable",
            font-style: "Medium",
            letter-spacing: -1%
          }
        }

        lineTwoB = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "the run carries on.",
          font-size: 68,
          font-family: "Inter Variable",
          line-height: 1.14,
          letter-spacing: -5%
        }
      }
    }

    // The desktop app, light, at its real size: sidebar, title bar, one finished turn, the composer and the context rail.
    // Colours are the kit's roles; geometry is the app's (256px sidebar, 28px rows, 40px composer, 214px rail).
    desktop = frame {
      doc: "Motion: rises from scale 0.92 and 80px lower to 1/0, scrubbed together with the statement's shared-element move so the send button and host picker land in their slots as the window settles. Once in view the turn plays once: the reply streams (32 characters per 40ms), tool rows appear 120ms apart, the shell output types in. No loop.",
      width: 1310px,
      height: 680px,
      layout: {stack: {}},
      fill: c.role.bg-base,
      border: c.role.stroke-tertiary,
      shadow: [
        {
          drop-shadow: {
            color: rgb(5.88%, 5.88%, 5.88%, 12.1569%),
            offset: point(0px, 40px),
            blur-radius: 90px
          }
        },
        {
          drop-shadow: {
            color: rgb(5.88%, 5.88%, 5.88%, 5.88%),
            offset: point(0px, 4px),
            blur-radius: 12px
          }
        }
      ],
      corner-radius: 14px,
      overflow: .clip,
      children: [sidebar, main],

      // The app's sidebar, measured from its StyleX (sidebarStyles and the --nyte-sidebar-* tokens), not drawn by eye.
      // 256px wide. The top 40px is the title bar: traffic lights, then the sidebar toggle at x=77. Nav rows start 6px below it.
      // Every row: 28px tall, 2px apart, 6px inline padding, a 20px leading slot holding a 14px glyph, a 6px gap, then 13/18 Inter.
      // Section headers sit 9px in, in content-secondary. Sections are 8px apart. The footer has 8px of padding all round.
      sidebar = frame {
        doc: "Interactive on the site, behaving as the app does. Rows: hover fills fill-tertiary (no transition), press is instant; click selects (fill-secondary + an inset 1px stroke-quaternary ring, label to content-primary) and swaps the window's turn for that chat. A chat row on hover shows Pin and Archive (24px buttons, 14px glyphs) just left of the time. Search shows its shortcut in a Kbd on hover. The Chats header shows its collapse chevron on hover; clicking it folds the list (height to 0, 250ms cubic-bezier(0.22,1,0.36,1)). The toggle hides the sidebar: it slides out by its width over 250ms cubic-bezier(0.25,0.46,0.45,0.94) while the main area widens. Focus rings are inset 2px #2783de. Under prefers-reduced-motion every change is instant.",
        width: 256px,
        height: 100%,
        layout: {stack: {direction: .column, justify-content: .space-between}},
        fill: c.role.bg-chrome,
        border: {color: c.role.stroke-quaternary, sides: .right},
        children: [sideTop, sideFooter],

        sideTop = frame {
          width: 100%,
          height: .auto,
          layout: {stack: {direction: .column}},
          children: [sideChrome, sideActions, sideScroll],

          sideChrome = frame {
            width: 100%,
            height: 40px,
            layout: {stack: {align-items: .center, item-gap: 9px}},
            padding-left: 16px,
            children: [lights, sideToggle],

            lights = frame {
              width: .auto,
              height: .auto,
              layout: {stack: {item-gap: 8px}},
              children: [lightRed, lightYellow, lightGreen],

              lightRed = shape {
                width: 12px,
                height: 12px,
                fill: rgb(100%, 37.25%, 34.1176%),
                border: {color: rgb(0%, 0%, 0%, 10.1961%), width: 0.5px},
                type: .ellipse
              }

              lightYellow = shape {
                width: 12px,
                height: 12px,
                fill: rgb(99.6078%, 73.7255%, 18.0392%),
                border: {color: rgb(0%, 0%, 0%, 10.1961%), width: 0.5px},
                type: .ellipse
              }

              lightGreen = shape {
                width: 12px,
                height: 12px,
                fill: rgb(15.6863%, 78.43%, 25.098%),
                border: {color: rgb(0%, 0%, 0%, 10.1961%), width: 0.5px},
                type: .ellipse
              }
            }

            sideToggle = frame {
              width: 28px,
              height: 28px,
              layout: {stack: {justify-content: .center, align-items: .center}},
              corner-radius: 8px,
              children: sideToggleIcon,

              sideToggleIcon = asset {
                width: 16px,
                height: 16px,
                fill: c.role.content-secondary,
                contents: iconPanelLeft
              }
            }
          }

          sideActions = frame {
            width: 100%,
            height: .auto,
            layout: {stack: {direction: .column, item-gap: 2px}},
            padding: [6px, 8px, 0px],
            children: [rowNew, rowSearch, rowCustomize, rowSettings],

            rowNew = frame {
              width: 100%,
              height: 28px,
              layout: {stack: {align-items: .center, item-gap: 6px}},
              corner-radius: 8px,
              padding: [0px, 6px],
              children: [rowNewSlot, rowNewLabel],

              rowNewSlot = frame {
                width: 20px,
                height: 20px,
                layout: {
                  stack: {justify-content: .center, align-items: .center}
                },
                children: rowNewIcon,

                rowNewIcon = asset {
                  width: 14px,
                  height: 14px,
                  fill: c.role.content-secondary,
                  contents: iconNewChat
                }
              }

              rowNewLabel = text {
                fill: c.role.content-secondary,
                contents: "New Chat",
                font-size: 13,
                font-family: "Inter Variable",
                line-height: 1.38
              }
            }

            rowSearch = frame {
              width: 100%,
              height: 28px,
              layout: {stack: {align-items: .center, item-gap: 6px}},
              corner-radius: 8px,
              padding: [0px, 6px],
              children: [rowSearchSlot, rowSearchLabel],

              rowSearchSlot = frame {
                width: 20px,
                height: 20px,
                layout: {
                  stack: {justify-content: .center, align-items: .center}
                },
                children: rowSearchIcon,

                rowSearchIcon = asset {
                  width: 14px,
                  height: 14px,
                  fill: c.role.content-secondary,
                  contents: iconSearch
                }
              }

              rowSearchLabel = text {
                fill: c.role.content-secondary,
                contents: "Search",
                font-size: 13,
                font-family: "Inter Variable",
                line-height: 1.38
              }
            }

            rowCustomize = frame {
              width: 100%,
              height: 28px,
              layout: {stack: {align-items: .center, item-gap: 6px}},
              corner-radius: 8px,
              padding: [0px, 6px],
              children: [rowCustomizeSlot, rowCustomizeLabel],

              rowCustomizeSlot = frame {
                width: 20px,
                height: 20px,
                layout: {
                  stack: {justify-content: .center, align-items: .center}
                },
                children: rowCustomizeIcon,

                rowCustomizeIcon = asset {
                  width: 14px,
                  height: 14px,
                  fill: c.role.content-secondary,
                  contents: iconCustomize
                }
              }

              rowCustomizeLabel = text {
                fill: c.role.content-secondary,
                contents: "Customize",
                font-size: 13,
                font-family: "Inter Variable",
                line-height: 1.38
              }
            }

            rowSettings = frame {
              width: 100%,
              height: 28px,
              layout: {
                stack: {justify-content: .space-between, align-items: .center}
              },
              corner-radius: 8px,
              padding: [0px, 6px],
              children: [rowSettingsLead, rowSettingsChevron],

              rowSettingsLead = frame {
                width: .auto,
                height: .auto,
                layout: {stack: {align-items: .center, item-gap: 6px}},
                children: [rowSettingsSlot, rowSettingsLabel],

                rowSettingsSlot = frame {
                  width: 20px,
                  height: 20px,
                  layout: {
                    stack: {justify-content: .center, align-items: .center}
                  },
                  children: rowSettingsIcon,

                  rowSettingsIcon = asset {
                    width: 14px,
                    height: 14px,
                    fill: c.role.content-secondary,
                    contents: iconSettings
                  }
                }

                rowSettingsLabel = text {
                  fill: c.role.content-secondary,
                  contents: "Settings",
                  font-size: 13,
                  font-family: "Inter Variable",
                  line-height: 1.38
                }
              }

              rowSettingsChevron = asset {
                width: 14px,
                height: 14px,
                fill: c.role.content-secondary,
                contents: iconChevronRight
              }
            }
          }

          sideScroll = frame {
            width: 100%,
            height: .auto,
            layout: {stack: {direction: .column, item-gap: 8px}},
            padding: 8px,
            children: [sectionProjects, sectionChats],

            sectionProjects = frame {
              width: 100%,
              height: .auto,
              layout: {stack: {direction: .column, item-gap: 2px}},
              children: [headProjects, rowProject],

              headProjects = frame {
                width: 100%,
                height: 28px,
                layout: {stack: {align-items: .center}},
                padding: [0px, 6px, 0px, 9px],
                children: headProjectsLabel,

                headProjectsLabel = text {
                  fill: c.role.content-secondary,
                  contents: "Projects",
                  font-size: 13,
                  font-family: "Inter Variable",
                  line-height: 1.38
                }
              }

              rowProject = frame {
                width: 100%,
                height: 28px,
                layout: {stack: {align-items: .center, item-gap: 6px}},
                corner-radius: 8px,
                padding: [0px, 6px],
                children: [rowProjectSlot, rowProjectLabel],

                rowProjectSlot = frame {
                  width: 20px,
                  height: 20px,
                  layout: {
                    stack: {justify-content: .center, align-items: .center}
                  },
                  children: rowProjectIcon,

                  rowProjectIcon = asset {
                    width: 14px,
                    height: 14px,
                    fill: c.role.content-secondary,
                    contents: iconFolder
                  }
                }

                rowProjectLabel = text {
                  fill: c.role.content-secondary,
                  contents: "shop",
                  font-size: 13,
                  font-family: "Inter Variable",
                  line-height: 1.38
                }
              }
            }

            sectionChats = frame {
              width: 100%,
              height: .auto,
              layout: {stack: {direction: .column, item-gap: 2px}},
              children: [headChats, chatA, chatB, chatC, chatD, chatE],

              headChats = frame {
                width: 100%,
                height: 28px,
                layout: {
                  stack: {justify-content: .space-between, align-items: .center}
                },
                padding: [0px, 6px, 0px, 9px],
                children: [headChatsLabel, headChatsActions],

                headChatsLabel = text {
                  fill: c.role.content-secondary,
                  contents: "Chats",
                  font-size: 13,
                  font-family: "Inter Variable",
                  line-height: 1.38
                }

                headChatsActions = frame {
                  width: .auto,
                  height: .auto,
                  layout: {stack: {align-items: .center, item-gap: 8px}},
                  children: [headChatsFilter, headChatsFolder],

                  headChatsFilter = frame {
                    width: 24px,
                    height: 24px,
                    layout: {
                      stack: {justify-content: .center, align-items: .center}
                    },
                    corner-radius: 8px,
                    children: headChatsFilterIcon,

                    headChatsFilterIcon = asset {
                      width: 14px,
                      height: 14px,
                      fill: c.role.content-secondary,
                      contents: iconFilters
                    }
                  }

                  headChatsFolder = frame {
                    width: 24px,
                    height: 24px,
                    layout: {
                      stack: {justify-content: .center, align-items: .center}
                    },
                    corner-radius: 8px,
                    children: headChatsFolderIcon,

                    headChatsFolderIcon = asset {
                      width: 14px,
                      height: 14px,
                      fill: c.role.content-secondary,
                      contents: iconFolderAdd
                    }
                  }
                }
              }

              // Selected: fill-secondary under an inset hairline, label in content-primary. The finished chat has no mark.
              chatA = frame {
                width: 100%,
                height: 28px,
                layout: {
                  stack: {justify-content: .space-between, align-items: .center}
                },
                fill: c.role.fill-secondary,
                border: c.role.stroke-quaternary,
                corner-radius: 8px,
                padding: [0px, 6px],
                children: [chatALead, chatAMeta],

                chatALead = frame {
                  width: .auto,
                  height: .auto,
                  layout: {stack: {align-items: .center, item-gap: 6px}},
                  children: [chatASlot, chatALabel],

                  chatASlot = frame {
                    width: 20px,
                    height: 20px
                  }

                  chatALabel = text {
                    fill: c.role.content-primary,
                    contents: "Fix the flaky checkout test",
                    font-size: 13,
                    font-family: "Inter Variable",
                    line-height: 1.38
                  }
                }

                chatAMeta = text {
                  fill: c.role.content-secondary,
                  contents: "now",
                  font-size: 11,
                  font-family: "Inter Variable",
                  line-height: 1.27,
                  letter-spacing: 0.6%
                }
              }

              // Hovered: fill-tertiary, and Pin and Archive appear left of the time.
              chatB = frame {
                width: 100%,
                height: 28px,
                layout: {
                  stack: {justify-content: .space-between, align-items: .center}
                },
                fill: c.role.fill-tertiary,
                corner-radius: 8px,
                padding: [0px, 6px],
                children: [chatBLead, chatBTrail],

                chatBLead = frame {
                  width: .auto,
                  height: .auto,
                  layout: {stack: {align-items: .center, item-gap: 6px}},
                  children: [chatBSlot, chatBLabel],

                  chatBSlot = frame {
                    width: 20px,
                    height: 20px
                  }

                  chatBLabel = text {
                    fill: c.role.content-secondary,
                    contents: "Try a fake timer",
                    font-size: 13,
                    font-family: "Inter Variable",
                    line-height: 1.38
                  }
                }

                chatBTrail = frame {
                  width: .auto,
                  height: .auto,
                  layout: {stack: {align-items: .center, item-gap: 6px}},
                  children: [chatBPin, chatBArchive, chatBMeta],

                  chatBPin = frame {
                    width: 24px,
                    height: 24px,
                    layout: {
                      stack: {justify-content: .center, align-items: .center}
                    },
                    corner-radius: 8px,
                    children: chatBPinIcon,

                    chatBPinIcon = asset {
                      width: 14px,
                      height: 14px,
                      fill: c.role.content-secondary,
                      contents: iconPin
                    }
                  }

                  chatBArchive = frame {
                    width: 24px,
                    height: 24px,
                    layout: {
                      stack: {justify-content: .center, align-items: .center}
                    },
                    corner-radius: 8px,
                    children: chatBArchiveIcon,

                    chatBArchiveIcon = asset {
                      width: 12px,
                      height: 12px,
                      fill: c.role.content-secondary,
                      contents: iconArchive
                    }
                  }

                  chatBMeta = text {
                    fill: c.role.content-secondary,
                    contents: "4m",
                    font-size: 11,
                    font-family: "Inter Variable",
                    line-height: 1.27,
                    letter-spacing: 0.6%
                  }
                }
              }

              // Working: the spinner sits in the leading slot, tinted by the primary intent.
              chatC = frame {
                width: 100%,
                height: 28px,
                layout: {
                  stack: {justify-content: .space-between, align-items: .center}
                },
                corner-radius: 8px,
                padding: [0px, 6px],
                children: [chatCLead, chatCMeta],

                chatCLead = frame {
                  width: .auto,
                  height: .auto,
                  layout: {stack: {align-items: .center, item-gap: 6px}},
                  children: [chatCSlot, chatCLabel],

                  chatCSlot = frame {
                    width: 20px,
                    height: 20px,
                    layout: {
                      stack: {justify-content: .center, align-items: .center}
                    },
                    children: chatCSpinner,

                    chatCSpinner = asset {
                      doc: "Spins forever, 800ms per turn, linear.",
                      width: 16px,
                      height: 16px,
                      fill: intent.primary.content-quaternary,
                      contents: iconLoader
                    }
                  }

                  chatCLabel = text {
                    fill: c.role.content-secondary,
                    contents: "Release notes for 0.9",
                    font-size: 13,
                    font-family: "Inter Variable",
                    line-height: 1.38
                  }
                }

                chatCMeta = text {
                  fill: c.role.content-secondary,
                  contents: "1h",
                  font-size: 11,
                  font-family: "Inter Variable",
                  line-height: 1.27,
                  letter-spacing: 0.6%
                }
              }

              // Waiting on you: the filled question bubble in the warning intent.
              chatD = frame {
                width: 100%,
                height: 28px,
                layout: {
                  stack: {justify-content: .space-between, align-items: .center}
                },
                corner-radius: 8px,
                padding: [0px, 6px],
                children: [chatDLead, chatDMeta],

                chatDLead = frame {
                  width: .auto,
                  height: .auto,
                  layout: {stack: {align-items: .center, item-gap: 6px}},
                  children: [chatDSlot, chatDLabel],

                  chatDSlot = frame {
                    width: 20px,
                    height: 20px,
                    layout: {
                      stack: {justify-content: .center, align-items: .center}
                    },

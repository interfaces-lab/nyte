      main = frame {
        width: 1054px,
        height: 100%,
        layout: {stack: {direction: .column}},
        children: [titlebar, body],

        titlebar = frame {
          width: 100%,
          height: 40px,
          layout: {
            stack: {justify-content: .space-between, align-items: .center}
          },
          padding: [0px, 12px, 0px, 16px],

          border: c.role.stroke-quaternary,
          shadow: {
            drop-shadow: {
              color: rgb(5.88%, 5.88%, 5.88%, 12.1569%),
              offset: point(0px, 18px),
              blur-radius: 40px
            }
          },
          corner-radius: 16px,
          padding: [10px, 8px],
          children: [forkChatsHead, forkChatA, forkChatB, forkChatC],

          forkChatsHead = frame {
            width: 100%,
            height: 28px,
            layout: {stack: {align-items: .center}},
            padding: [0px, 7px],
            children: forkChatsHeadLabel,

            forkChatsHeadLabel = text {
              fill: c.role.content-tertiary,
              contents: "Chats",
              font-size: 13,
              font-family: "Inter Variable"
            }
          }

          forkChatA = frame {
            width: 100%,
            height: 28px,
            layout: {
              stack: {justify-content: .space-between, align-items: .center}
            },
            corner-radius: 8px,
            padding: [0px, 8px],
            children: [forkChatALabel, forkChatAMeta],

            forkChatALabel = text {
              fill: c.role.content-secondary,
              contents: "Fix the flaky checkout test",
              font-size: 13,
              font-family: "Inter Variable"
            }

            forkChatAMeta = text {
              fill: c.role.content-tertiary,
              contents: "4m",
              font-size: 11,
              font-family: "Inter Variable"
            }
          }

          forkChatB = frame {
            width: 100%,
            height: 28px,
            layout: {
              stack: {justify-content: .space-between, align-items: .center}
            },
            fill: c.role.fill-secondary,
            corner-radius: 8px,
            padding: [0px, 8px, 0px, 22px],
            children: [forkChatBLead, forkChatBMeta],

            forkChatBLead = frame {
              width: .auto,
              height: .auto,
              layout: {stack: {align-items: .center, item-gap: 6px}},
              children: [forkChatBIcon, forkChatBLabel],

              forkChatBIcon = asset {
                width: 13px,
                height: 13px,

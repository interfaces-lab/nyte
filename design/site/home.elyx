    // Where the host runs, with butter's stacked headings: the active one in ink, the others grey.
    deploy = frame {
      doc: "Motion: the section pins for ~1200px of scroll. Progress picks the active row: 0–33% This Mac, 33–66% Your server, 66–100% The cloud. The active heading goes #0F0F0F4D→#0F0F0F and its line rises in (translateY 0.6em→0, opacity 0→1); the matching host card gets the blue ring and lifts 4px, the others drop to 60% opacity. Crossfades take 300ms ease-out, triggered by progress, not scrubbed.",
      width: 1310px,
      height: .auto,
      layout: {stack: {align-items: .center, item-gap: 136px}},
      padding-top: 210px,
      children: [deployCard, deployCopy],

      deployCard = frame {
        width: 640px,
        height: 460px,
        layout: {
          stack: {
            direction: .column,
            justify-content: .center,
            align-items: .center
          }
        },
        fill: rgb(92.94%, 92.94%, 92.94%),
        corner-radius: 32px,
        children: [hostMac, linkOne, hostServer, linkTwo, hostCloud],

        hostMac = frame {
          width: 440px,
          height: 88px,
          opacity: 0.6,
          layout: {stack: {align-items: .center, item-gap: 16px}},
          fill: c.role.bg-base,
          shadow: {
            drop-shadow: {
              color: rgb(5.88%, 5.88%, 5.88%, 7.84%),
              offset: point(0px, 12px),
              blur-radius: 28px
            }
          },
          corner-radius: 22px,
          padding: [0px, 20px],
          children: [hostMacIcon, hostMacText],

          hostMacIcon = frame {
            width: 48px,
            height: 48px,
            layout: {stack: {justify-content: .center, align-items: .center}},
            fill: rgb(11.76%, 11.76%, 11.76%),
            corner-radius: 13px,
            children: hostMacGlyph,

            hostMacGlyph = asset {
              width: 24px,
              height: 24px,
              fill: rgb(98.0392%, 98.0392%, 98.0392%),
              contents: iconLaptop
            }
          }

          hostMacText = frame {
            width: .auto,
            height: .auto,
            layout: {stack: {direction: .column, item-gap: 3px}},
            children: [hostMacName, hostMacMeta],

            hostMacName = text {
              fill: rgb(5.88%, 5.88%, 5.88%),
              contents: "This Mac",
              font-size: 19,
              font-family: "Inter Variable",
              font-style: "Medium",
              letter-spacing: -2%
            }

            hostMacMeta = text {
              fill: rgb(5.88%, 5.88%, 5.88%, 50.1961%),
              contents: "SQLite · runs in process",
              font-size: 13,
              font-family: "Menlo"
            }
          }
        }

        linkOne = shape {
          width: 2px,
          height: 36px,
          fill: rgb(5.88%, 5.88%, 5.88%, 14.9%),
          type: .rect
        }

        hostServer = frame {
          width: 440px,
          height: .auto,
          layout: {stack: {direction: .column, item-gap: 14px}},
          fill: c.role.bg-base,
          border: {color: intent.primary.button-fill, width: 2px},
          shadow: {
            drop-shadow: {
              color: rgb(16.47%, 18.82%, 88.6274%, 14.1176%),
              offset: point(0px, 16px),
              blur-radius: 34px
            }
          },
          corner-radius: 22px,
          padding: [18px, 20px],
          children: [hostServerHead, hostServerProcesses],

          hostServerHead = frame {
            width: 100%,
            height: .auto,
            layout: {stack: {align-items: .center, item-gap: 16px}},
            children: [hostServerIcon, hostServerText],

            hostServerIcon = frame {
              width: 48px,
              height: 48px,
              layout: {stack: {justify-content: .center, align-items: .center}},
              fill: intent.primary.button-fill,
              corner-radius: 13px,
              children: hostServerGlyph,

              hostServerGlyph = asset {
                width: 24px,
                height: 24px,
                fill: .white,
                contents: iconServer
              }
            }

            hostServerText = frame {
              width: .auto,
              height: .auto,
              layout: {stack: {direction: .column, item-gap: 3px}},
              children: [hostServerName, hostServerMeta],

              hostServerName = text {
                fill: rgb(5.88%, 5.88%, 5.88%),
                contents: "Your server",
                font-size: 19,
                font-family: "Inter Variable",
                font-style: "Medium",
                letter-spacing: -2%
              }

              hostServerMeta = text {
                fill: rgb(5.88%, 5.88%, 5.88%, 50.1961%),
                contents: "Postgres · shared by every process",
                font-size: 13,
                font-family: "Menlo"
              }
            }
          }

          hostServerProcesses = frame {
            width: 100%,
            height: .auto,
            layout: {stack: {direction: .column, item-gap: 8px}},
            fill: c.role.bg-muted,
            corner-radius: 12px,
            padding: [10px, 14px],
            children: [processA, processB],

            processA = frame {
              width: 100%,
              height: .auto,
              layout: {
                stack: {justify-content: .space-between, align-items: .center}
              },
              children: [processAName, processAState],

              processAName = text {
                fill: c.role.content-tertiary,
                contents: "process 1",
                font-size: 13,
                font-family: "Menlo"
              }

              processAState = text {
                fill: intent.danger.content-tertiary,
                contents: "died at turn 14",
                font-size: 13,
                font-family: "Menlo"
              }
            }

            processB = frame {
              width: 100%,
              height: .auto,
              layout: {
                stack: {justify-content: .space-between, align-items: .center}
              },
              children: [processBName, processBState],

              processBName = text {
                fill: c.role.content-secondary,
                contents: "process 2",
                font-size: 13,
                font-family: "Menlo"
              }

              processBState = frame {
                width: .auto,
                height: .auto,
                layout: {stack: {align-items: .center, item-gap: 7px}},
                children: [processBDot, processBText],

                processBDot = shape {
                  width: 7px,
                  height: 7px,
                  fill: intent.success.content-quaternary,
                  type: .ellipse
                }

                processBText = text {
                  fill: intent.success.content-tertiary,
                  contents: "took over · running",
                  font-size: 13,
                  font-family: "Menlo"
                }
              }
            }
          }
        }

        linkTwo = shape {
          width: 2px,
          height: 36px,
          fill: rgb(5.88%, 5.88%, 5.88%, 14.9%),
          type: .rect
        }

        hostCloud = frame {
          width: 440px,
          height: 88px,
          opacity: 0.6,
          layout: {stack: {align-items: .center, item-gap: 16px}},
          fill: c.role.bg-base,
          shadow: {
            drop-shadow: {
              color: rgb(5.88%, 5.88%, 5.88%, 7.84%),
              offset: point(0px, 12px),
              blur-radius: 28px
            }
          },
          corner-radius: 22px,
          padding: [0px, 20px],
          children: [hostCloudIcon, hostCloudText],

          hostCloudIcon = frame {
            width: 48px,
            height: 48px,
            layout: {stack: {justify-content: .center, align-items: .center}},
            fill: .black,
            corner-radius: 13px,
            children: hostCloudGlyph,

            hostCloudGlyph = asset {
              width: 22px,
              height: 22px,
              fill: .white,
              contents: iconVercel
            }
          }

          hostCloudText = frame {
            width: .auto,
            height: .auto,
            layout: {stack: {direction: .column, item-gap: 3px}},
            children: [hostCloudName, hostCloudMeta],

            hostCloudName = text {
              fill: rgb(5.88%, 5.88%, 5.88%),
              contents: "The cloud",
              font-size: 19,
              font-family: "Inter Variable",
              font-style: "Medium",
              letter-spacing: -2%
            }

            hostCloudMeta = text {
              fill: rgb(5.88%, 5.88%, 5.88%, 50.1961%),
              contents: "Vercel · a workflow per branch",
              font-size: 13,
              font-family: "Menlo"
            }
          }
        }
      }

      deployCopy = frame {
        width: 500px,
        height: .auto,
        layout: {stack: {direction: .column, item-gap: 6px}},
        children: [
          deployEyebrow,
          deployEyebrowGap,
          deployMac,
          deployServer,
          deployServerBody,
          deployCloud
        ],

        deployEyebrow = text {
          fill: rgb(5.88%, 5.88%, 5.88%, 40%),
          contents: "Where the host runs",
          font-size: 14,
          font-family: "Menlo",
          letter-spacing: 2%
        }

        deployEyebrowGap = frame {
          width: 10px,
          height: 20px
        }

        deployMac = text {
          fill: rgb(5.88%, 5.88%, 5.88%, 30.1961%),
          contents: "This Mac",
          font-size: 60,
          font-family: "Inter Variable",
          line-height: 1.15,
          letter-spacing: -4.5%
        }

        deployServer = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Your server",
          font-size: 60,
          font-family: "Inter Variable",
          line-height: 1.15,
          letter-spacing: -4.5%
        }

        deployServerBody = text {
          width: 430px,
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "If a process dies, another takes the run over in about 20 seconds.",
          font-size: 21,
          font-family: "Inter Variable",
          line-height: 1.3,
          letter-spacing: -1%
        }

        deployCloud = text {
          fill: rgb(5.88%, 5.88%, 5.88%, 30.1961%),
          contents: "The cloud",
          font-size: 60,
          font-family: "Inter Variable",
          line-height: 1.15,
          letter-spacing: -4.5%
        }
      }
    }

    // Four clients on one core. Each card shows the thing itself.
    clients = frame {
      doc: "Motion: the four cards rise 40px→0 with opacity 0→1, scrubbed over ~400px, 60px of scroll apart. On hover a card's object lifts 6px and its shadow deepens (200ms ease-out).",
      width: 1310px,
      height: .auto,
      layout: {
        stack: {direction: .column, align-items: .center, item-gap: 56px}
      },
      padding-top: 220px,
      children: [clientsTitle, clientRow],

      clientsTitle = text {
        fill: rgb(5.88%, 5.88%, 5.88%),
        contents: "One core. Every client.",
        font-size: 60,
        font-family: "Inter Variable",
        line-height: 1.1,
        letter-spacing: -4.5%
      }

      clientRow = frame {
        width: 100%,
        height: .auto,
        layout: {stack: {item-gap: 18px}},
        children: [clientTerminal, clientDesktop, clientApp, clientMobile],

        clientTerminal = frame {
          width: 314px,
          height: 420px,
          layout: {stack: {direction: .column, justify-content: .space-between}},
          fill: rgb(9.0196%, 9.0196%, 9.0196%),
          corner-radius: 32px,
          padding: 26px,
          children: [miniDock, clientTerminalText],

          miniDock = frame {
            width: 100%,
            height: 54px,
            children: [miniPrompt, miniRule, miniStatus],

            miniPrompt = frame {
              left: 0px,
              top: 0px,
              width: 100%,
              height: 44px,
              layout: {stack: {align-items: .center, item-gap: 9px}},
              border: {
                color: rgb(32.1569%, 32.1569%, 32.1569%),
                width: 1.5px,
                sides: [.top, .left, .right]
              },
              corner-radius: [8px, 8px, 0px, 0px],
              padding: [0px, 14px],
              children: [miniCaret, miniPlaceholder],

              miniCaret = text {
                fill: rgb(98.0392%, 98.0392%, 98.0392%),
                contents: "❯",
                font-size: 13,
                font-family: "Menlo"
              }

              miniPlaceholder = text {
                fill: rgb(32.1569%, 32.1569%, 32.1569%),
                contents: "Plan, search, build…",
                font-size: 13,
                font-family: "Menlo"
              }
            }

            miniRule = shape {
              left: 0px,
              top: 43px,
              width: 100%,
              height: 1.5px,
              fill: rgb(32.1569%, 32.1569%, 32.1569%),
              type: .rect
            }

            miniStatus = frame {
              left: 12px,
              top: 34px,
              width: .auto,
              height: 20px,
              layout: {stack: {align-items: .center}},
              fill: rgb(9.0196%, 9.0196%, 9.0196%),
              padding: [0px, 5px],
              children: miniStatusText,

              miniStatusText = text {
                fill: rgb(32.1569%, 32.1569%, 32.1569%),
                subrange: [
                  {range: [0, 9], fill: rgb(100%, 63.92%, 34.9%)},
                  {range: [12, 18], fill: rgb(61.5686%, 41.5686%, 98.43%)}
                ],
                contents: "workspace │ medium",
                font-size: 13,
                font-family: "Menlo"
              }
            }
          }

          clientTerminalText = frame {
            width: 100%,
            height: .auto,
            layout: {stack: {direction: .column, item-gap: 6px}},
            children: [clientTerminalTitle, clientTerminalBody],

            clientTerminalTitle = text {
              fill: rgb(98.0392%, 98.0392%, 98.0392%),
              contents: "Terminal",
              font-size: 30,
              font-family: "Inter Variable",
              font-style: "Medium",
              letter-spacing: -3%
            }

            clientTerminalBody = text {
              fill: rgb(98.0392%, 98.0392%, 98.0392%, 60%),
              contents: "macOS and Linux",
              font-size: 17,
              font-family: "Inter Variable"
            }
          }
        }

        clientDesktop = frame {
          width: 314px,
          height: 420px,
          layout: {stack: {direction: .column, justify-content: .space-between}},
          fill: {
            radial-gradient: {
              at: point(80%, 10%),
              angle: 0deg,
              radius: 150%,
              stops: [
                stop(0%, rgb(75.6863%, 81.5686%, 96.47%)),
                stop(55%, rgb(47.84%, 57.6471%, 83.92%)),
                stop(100%, rgb(13.7255%, 16.47%, 26.6667%))
              ]
            }
          },
          corner-radius: 32px,
          padding: 26px,
          children: [appIcon, clientDesktopText],

          // The Dock icon: the moon on its navy plate.
          appIcon = frame {
            width: 96px,
            height: 96px,
            layout: {stack: {justify-content: .center, align-items: .center}},
            fill: {
              linear-gradient: {
                angle: 180deg,
                stops: [
                  stop(0%, rgb(13.7255%, 16.47%, 26.6667%)),
                  stop(100%, rgb(4.7059%, 6.27%, 12.549%))
                ]
              }
            },
            border: rgb(100%, 100%, 100%, 20%),
            shadow: {
              drop-shadow: {
                color: rgb(4.7059%, 6.27%, 12.549%, 40%),
                offset: point(0px, 16px),
                blur-radius: 28px
              }
            },
            corner-radius: 26px,
            children: appIconMoon,

            appIconMoon = asset {
              width: 56px,
              height: 56px,
              fill: rgb(66.27%, 73.7255%, 92.549%),
              contents: mark
            }
          }

          clientDesktopText = frame {
            width: 100%,
            height: .auto,
            layout: {stack: {direction: .column, item-gap: 6px}},
            children: [clientDesktopTitle, clientDesktopBody],

            clientDesktopTitle = text {
              fill: .white,
              contents: "Desktop",
              font-size: 30,
              font-family: "Inter Variable",
              font-style: "Medium",
              letter-spacing: -3%
            }

            clientDesktopBody = text {
              fill: rgb(100%, 100%, 100%, 80%),
              contents: "Apple Silicon",
              font-size: 17,
              font-family: "Inter Variable"
            }
          }
        }

        clientApp = frame {
          width: 314px,
          height: 420px,
          layout: {stack: {direction: .column, justify-content: .space-between}},
          fill: .white,
          border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
          corner-radius: 32px,
          padding: 26px,
          children: [sdkSnippet, clientAppText],

          sdkSnippet = frame {
            width: 100%,
            height: .auto,
            layout: {stack: {direction: .column}},
            fill: .whitesmoke,
            corner-radius: 14px,
            padding: 16px,
            children: sdkCode,

            sdkCode = text {
              fill: rgb(3.92%, 3.92%, 3.92%),
              subrange: [
                {range: [0, 5], fill: rgb(65.098%, 19.2157%, 74.5098%)},
                {range: [13, 18], fill: rgb(65.098%, 19.2157%, 74.5098%)},
                {range: [30, 35], fill: rgb(65.098%, 19.2157%, 74.5098%)},
                {range: [69, 78], fill: rgb(5.49%, 40%, 16.47%)}
              ],
              contents: "const host = await sdk.open()\nawait host.sessions.start({\n  content: \"Ship it\"\n})",
              font-size: 12.5,
              font-family: "Menlo",
              line-height: 1.6
            }
          }

          clientAppText = frame {
            width: 100%,
            height: .auto,
            layout: {stack: {direction: .column, item-gap: 6px}},
            children: [clientAppTitle, clientAppBody],

            clientAppTitle = text {
              fill: rgb(5.88%, 5.88%, 5.88%),
              contents: "Your app",
              font-size: 30,
              font-family: "Inter Variable",
              font-style: "Medium",
              letter-spacing: -3%
            }

            clientAppBody = text {
              fill: rgb(5.88%, 5.88%, 5.88%, 60%),
              contents: "JSON and SSE",
              font-size: 17,
              font-family: "Inter Variable"
            }
          }
        }

        clientMobile = frame {
          width: 314px,
          height: 420px,
          fill: rgb(92.94%, 92.94%, 92.94%),
          corner-radius: 32px,
          overflow: .clip,
          children: [phone, clientMobileText],

          phone = frame {
            left: 72px,
            top: 34px,
            width: 170px,
            height: 300px,
            layout: {stack: {direction: .column, item-gap: 10px}},
            fill: c.role.bg-base,
            border: {color: rgb(11.76%, 11.76%, 11.76%), width: 5px},
            shadow: {
              drop-shadow: {
                color: rgb(5.88%, 5.88%, 5.88%, 20%),
                offset: point(0px, 18px),
                blur-radius: 30px
              }
            },
            corner-radius: 34px,
            padding: [34px, 14px],
            children: [phoneUser, phoneAnswer, phoneActions],

            phoneUser = frame {
              width: 100%,
              height: .auto,
              layout: {stack: {direction: .column}},
              border: c.role.stroke-tertiary,
              corner-radius: 10px,
              padding: [7px, 9px],
              children: phoneUserText,

              phoneUserText = text {
                width: 100%,
                fill: c.role.content-primary,
                contents: "Did the tests pass?",
                font-size: 11,
                font-family: "Inter Variable"
              }
            }

            phoneAnswer = text {
              width: 100%,
              fill: c.role.content-primary,
              contents: "Yes, 42 of 42. The PR is open.",
              font-size: 11,
              font-family: "Inter Variable",
              line-height: 1.5
            }

            phoneActions = frame {
              width: .auto,
              height: 16px,
              layout: {stack: {align-items: .center, item-gap: 8px}},
              children: [phoneActionCopy, phoneActionTime],

              phoneActionCopy = asset {
                width: 11px,
                height: 11px,
                fill: c.role.content-tertiary,
                contents: iconCopy
              }

              phoneActionTime = text {
                fill: c.role.content-tertiary,
                contents: "just now",
                font-size: 10,
                font-family: "Inter Variable"
              }
            }
          }

          clientMobileText = frame {
            left: 26px,
            top: 302px,
            width: 262px,
            height: 92px,
            layout: {
              stack: {direction: .column, justify-content: .end, item-gap: 6px}
            },
            fill: rgb(92.94%, 92.94%, 92.94%),
            children: [clientMobileTitle, clientMobileBody],

            clientMobileTitle = text {
              fill: rgb(5.88%, 5.88%, 5.88%),
              contents: "Mobile",
              font-size: 30,
              font-family: "Inter Variable",
              font-style: "Medium",
              letter-spacing: -3%
            }

            clientMobileBody = text {
              fill: rgb(5.88%, 5.88%, 5.88%, 60%),
              contents: "Your Mac does the work",
              font-size: 17,
              font-family: "Inter Variable"
            }
          }
        }
      }
    }

    // Install: butter's closing split, as three commands.
    install = frame {
      doc: "Motion: line reveals on the copy. In the command card each line types once when 60% is in view (20ms per character, 300ms between lines); the caret then blinks on the last line.",
      width: 1310px,
      height: .auto,
      layout: {stack: {align-items: .center, item-gap: 136px}},
      padding-top: 220px,
      children: [installCopy, installCard],

      installCopy = frame {
        width: 500px,
        height: .auto,
        layout: {stack: {direction: .column, item-gap: 30px}},
        children: [installEyebrow, installTitle, installGithub],

        installEyebrow = text {
          fill: rgb(5.88%, 5.88%, 5.88%, 40%),
          contents: "Open source · MIT",
          font-size: 14,
          font-family: "Menlo",
          letter-spacing: 2%
        }

        installTitle = text {
          width: 100%,
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Install in one line.",
          font-size: 60,
          font-family: "Inter Variable",
          line-height: 1.05,
          letter-spacing: -4.5%
        }

        installGithub = frame {
          width: .auto,
          height: 48px,
          layout: {stack: {align-items: .center, item-gap: 10px}},
          fill: rgb(92.94%, 92.94%, 92.94%),
          corner-radius: 24px,
          padding: [0px, 22px, 0px, 18px],
          children: [installGithubIcon, installGithubLabel, installGithubArrow],

          installGithubIcon = asset {
            width: 20px,
            height: 20px,
            fill: rgb(11.76%, 11.76%, 11.76%),
            contents: iconGithub
          }

          installGithubLabel = text {
            fill: rgb(11.76%, 11.76%, 11.76%),
            contents: "GitHub",
            font-size: 17,
            font-family: "Inter Variable"
          }

          installGithubArrow = asset {
            width: 18px,
            height: 18px,
            fill: rgb(11.76%, 11.76%, 11.76%),
            contents: arrowRight
          }
        }
      }

      installCard = frame {
        width: 640px,
        height: .auto,
        layout: {stack: {direction: .column, item-gap: 30px}},
        fill: rgb(3.92%, 3.92%, 3.92%),
        corner-radius: 32px,
        padding: [30px, 34px],
        children: [installTabs, installLines],

        installTabs = frame {
          width: .auto,
          height: 34px,
          layout: {stack: {align-items: .center, item-gap: 14px}},
          fill: rgb(14.9%, 14.9%, 14.9%),
          corner-radius: 9px,
          padding: [0px, 14px],
          children: [installTabLabel, installTabCopy],

          installTabLabel = text {
            fill: rgb(63.92%, 63.92%, 63.92%),
            contents: "macOS · Linux",
            font-size: 13,
            font-family: "Menlo"
          }

          installTabCopy = asset {
            width: 14px,
            height: 14px,
            fill: rgb(50.98%, 50.98%, 50.98%),
            contents: iconCopy
          }
        }

        installLines = frame {
          width: 100%,
          height: .auto,
          layout: {stack: {direction: .column, item-gap: 20px}},
          children: [
            installLineOne,
            installLineTwo,
            installLineThree,
            installLineFour
          ],

          installLineOne = text {
            fill: rgb(98.0392%, 98.0392%, 98.0392%),
            subrange: [
              {range: [0, 1], fill: rgb(32.1569%, 32.1569%, 32.1569%)},
              {range: [2, 6], fill: rgb(75.6863%, 81.5686%, 96.47%)}
            ],
            contents: "$ curl -fsSL https://nyte.sh/install | sh",
            font-size: 17,
            font-family: "Menlo"
          }

          installLineTwo = text {
            fill: rgb(98.0392%, 98.0392%, 98.0392%),
            subrange: [
              {range: [0, 1], fill: rgb(32.1569%, 32.1569%, 32.1569%)},
              {range: [2, 6], fill: rgb(75.6863%, 81.5686%, 96.47%)}
            ],
            contents: "$ nyte login",
            font-size: 17,
            font-family: "Menlo"
          }

          installLineThree = text {
            fill: rgb(98.0392%, 98.0392%, 98.0392%),
            subrange: [
              {range: [0, 1], fill: rgb(32.1569%, 32.1569%, 32.1569%)},
              {range: [2, 6], fill: rgb(75.6863%, 81.5686%, 96.47%)}
            ],
            contents: "$ nyte",
            font-size: 17,
            font-family: "Menlo"
          }

          installLineFour = text {
            fill: rgb(32.1569%, 32.1569%, 32.1569%),
            subrange: {range: [0, 1], fill: rgb(98.0392%, 98.0392%, 98.0392%)},
            contents: "❯ Plan, search, build anything",
            font-size: 17,
            font-family: "Menlo"
          }
        }
      }
    }
  }

  footer = frame {
    doc: "Motion: curtain. The footer is fixed behind the page, and the page panel with its 48px bottom corners scrolls up off it. The glow ellipses under the wordmark drift ±20px on their own 8–11s loops.",
    width: 100%,
    height: .auto,
    layout: {stack: {direction: .column}},
    padding: [100px, 66px, 64px],
    children: [footerColumns, wordmark, footerBase],

    footerColumns = frame {
      width: 100%,
      height: .auto,
      layout: {stack: {}},
      children: [colProduct, colBuild, colOpen, colLegal],

      colProduct = frame {
        width: 327px,
        height: .auto,
        layout: {stack: {direction: .column, item-gap: 6px}},
        children: [
          colProductHead,
          colProductGap,
          colProductA,
          colProductB,
          colProductC
        ],

        colProductHead = text {
          fill: rgb(5.88%, 5.88%, 5.88%, 40%),
          contents: "Product",
          font-size: 13,
          font-family: "Menlo",
          letter-spacing: 2%
        }

        colProductGap = frame {
          width: 10px,
          height: 18px
        }

        colProductA = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Terminal",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }

        colProductB = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Desktop",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }

        colProductC = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Mobile",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }
      }

      colBuild = frame {
        width: 327px,
        height: .auto,
        layout: {stack: {direction: .column, item-gap: 6px}},
        children: [colBuildHead, colBuildGap, colBuildA, colBuildB, colBuildC],

        colBuildHead = text {
          fill: rgb(5.88%, 5.88%, 5.88%, 40%),
          contents: "Build",
          font-size: 13,
          font-family: "Menlo",
          letter-spacing: 2%
        }

        colBuildGap = frame {
          width: 10px,
          height: 18px
        }

        colBuildA = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Docs",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }

        colBuildB = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "SDK",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }

        colBuildC = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "llms.txt",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }
      }

      colOpen = frame {
        width: 327px,
        height: .auto,
        layout: {stack: {direction: .column, item-gap: 6px}},
        children: [colOpenHead, colOpenGap, colOpenA, colOpenB, colOpenC],

        colOpenHead = text {
          fill: rgb(5.88%, 5.88%, 5.88%, 40%),
          contents: "Open source",
          font-size: 13,
          font-family: "Menlo",
          letter-spacing: 2%
        }

        colOpenGap = frame {
          width: 10px,
          height: 18px
        }

        colOpenA = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "GitHub",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }

        colOpenB = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Releases",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }

        colOpenC = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Design",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }
      }

      colLegal = frame {
        width: 327px,
        height: .auto,
        layout: {stack: {direction: .column, item-gap: 6px}},
        children: [colLegalHead, colLegalGap, colLegalA, colLegalB],

        colLegalHead = text {
          fill: rgb(5.88%, 5.88%, 5.88%, 40%),
          contents: "Legal",
          font-size: 13,
          font-family: "Menlo",
          letter-spacing: 2%
        }

        colLegalGap = frame {
          width: 10px,
          height: 18px
        }

        colLegalA = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Privacy",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }

        colLegalB = text {
          fill: rgb(5.88%, 5.88%, 5.88%),
          contents: "Terms",
          font-size: 21,
          font-family: "Inter Variable",
          letter-spacing: -1%
        }
      }
    }

    // The giant wordmark, the moon ramp bleeding out under it like butter's logo.
    wordmark = frame {
      width: 100%,
      height: 640px,
      children: [
        wordmarkGlowA,
        wordmarkGlowB,
        wordmarkGlowC,
        wordmarkMoon,
        wordmarkText
      ],

      wordmarkGlowA = shape {
        left: 80px,
        top: 390px,
        width: 560px,
        height: 190px,
        opacity: 0.8,
        fill: rgb(47.84%, 57.6471%, 83.92%),
        filter: {type: .gaussian-blur, radius: 70px},
        type: .ellipse
      }

      wordmarkGlowB = shape {
        left: 560px,
        top: 410px,
        width: 520px,
        height: 180px,
        opacity: 0.8,
        fill: rgb(100%, 70.1961%, 81.96%),
        filter: {type: .gaussian-blur, radius: 70px},
        type: .ellipse
      }

      wordmarkGlowC = shape {
        left: 960px,
        top: 380px,
        width: 380px,
        height: 190px,
        opacity: 0.6,
        fill: rgb(20%, 25.49%, 91.76%),
        filter: {type: .gaussian-blur, radius: 70px},
        type: .ellipse
      }

      wordmarkMoon = asset {
        left: -12px,
        top: 190px,
        width: 270px,
        height: 270px,
        fill: rgb(5.88%, 5.88%, 5.88%),
        contents: mark
      }

      wordmarkText = text {
        left: 290px,
        top: 30px,
        fill: rgb(5.88%, 5.88%, 5.88%),
        contents: "nyte",
        font-size: 520,
        font-family: "Inter Variable",
        font-style: "SemiBold",
        line-height: 1,
        letter-spacing: -7%
      }
    }

    footerBase = frame {
      width: 100%,
      height: .auto,
      layout: {stack: {justify-content: .space-between}},
      children: [copyright, footerRights],

      copyright = text {
        fill: rgb(5.88%, 5.88%, 5.88%, 40%),
        contents: "© 2026 Nyte",
        font-size: 21,
        font-family: "Inter Variable",
        letter-spacing: -1%
      }

      footerRights = text {
        fill: rgb(5.88%, 5.88%, 5.88%, 40%),
        contents: "MIT licensed",
        font-size: 21,
        font-family: "Inter Variable",
        letter-spacing: -1%
      }
    }
  }
}

// Motion storyboard: butter's motion system on Nyte's page, as key frames at half scale.
// Each row is one effect; each frame is a 1440×900 viewport at a moment, captioned with its time or scroll position.
motion = frame {
  left: 1640px,
  top: 0px,
  width: 2340px,
  height: .auto,
  layout: {stack: {direction: .column, item-gap: 80px}},
  fill: rgb(95.6863%, 95.6863%, 95.6863%),
  padding: 60px,
  children: [motionTitle, rowIntro, rowNav, rowFlip, rowPin, rowCurtain],

  motionTitle = text {
    fill: rgb(5.88%, 5.88%, 5.88%),
    contents: "Motion, after butter.video",
    font-size: 40,
    font-family: "Inter Variable",
    font-style: "Medium",
    letter-spacing: -3%
  }

  // 1. Intro: wash, chromatic headline resolve, moon spring, pieces settle.
  rowIntro = frame {
    title: "Intro · time-based, 1.6s",
    width: .auto,
    height: .auto,
    layout: {stack: {item-gap: 40px}},
    children: [introA, introB, introC],

    introA = frame {
      title: "0 ms",
      caption: "White while the page loads",
      width: 720px,
      height: 450px,
      fill: .white,
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip
    }

    introB = frame {
      title: "600 ms",
      caption: "Wash in, headline blurred and tinted, moon rising",
      width: 720px,
      height: 450px,
      fill: rgb(98.0392%, 98.0392%, 98.0392%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: introBHero,

      introBHero = frame : home.page.hero {
        left: 0px,
        top: 0px,
        width: 1440px,
        transform: [0.5, 0, 0, 0, 0.5, 0],

        headline {
          filter[0].type: .gaussian-blur,
          fill[0].linear-gradient.from: [0%, 50%],
          fill[0].linear-gradient.stops[2].position: 100%,
          fill[0].linear-gradient.stops[1].position: 55%,
          fill[0].linear-gradient.stops[0].position: 0%,
          filter[0].radius: 10px,
          fill[0].linear-gradient.to: [100%, 50%],
          fill[0].linear-gradient.stops[2].color: rgb(96.0784%, 65.88%, 78.43%),
          fill[0].linear-gradient.stops[1].color: rgb(72.549%, 65.88%, 94.1176%),
          fill[0].linear-gradient.stops[0].color: rgb(49.8%, 82.7451%, 96.0784%)
        }

        sculpture {
          moon {
            top: 52px,
            opacity: 0.7
          }

          chipActions {
            opacity: 0
          }

          chipApproval {
            opacity: 0
          }

          chipSteer {
            opacity: 0
          }

          chipHostPicker {
            opacity: 0
          }

          glow {
            opacity: 0.25
          }
        }

        heroActions {
          opacity: 0
        }

        subline {
          opacity: 0
        }
      }
    }

    introC = frame {
      title: "1600 ms",
      caption: "Ink settled, pieces landed 80ms apart",
      width: 720px,
      height: 450px,
      fill: rgb(98.0392%, 98.0392%, 98.0392%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: introCHero,

      introCHero = frame : home.page.hero {
        left: 0px,
        top: 0px,
        width: 1440px,
        transform: [0.5, 0, 0, 0, 0.5, 0]
      }
    }
  }

  // 2. Nav: the left pill collapses to brand + ⋮ after the hero.
  rowNav = frame {
    title: "Nav · past 600px of scroll",
    width: .auto,
    height: .auto,
    layout: {stack: {item-gap: 40px}},
    children: [navA, navB],

    navA = frame {
      title: "At the top",
      width: 720px,
      height: 80px,
      fill: rgb(85.098%, 85.098%, 85.098%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: navAPills,

      navAPills = frame : home.page.nav {
        left: 48px,
        top: 4px,
        transform: [0.5, 0, 0, 0, 0.5, 0]
      }
    }

    navB = frame {
      title: "Scrolled",
      caption: "Links fade 150ms, pill eases 300ms",
      width: 720px,
      height: 80px,
      fill: rgb(98.0392%, 98.0392%, 98.0392%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: navBPills,

      navBPills = frame : home.page.nav {
        left: 48px,
        top: 4px,
        transform: [0.5, 0, 0, 0, 0.5, 0],

        navLeft {
          overrides: [insert(navMore, after = home.page.nav.navLeft.brand)],

          navLinks {
            display: .none
          }
        }

        navMore = text {
          fill: rgb(11.76%, 11.76%, 11.76%),
          contents: "⋮",
          font-size: 20,
          font-family: "Inter Variable",
          font-style: "SemiBold"
        }
      }
    }
  }

  // 3. Shared elements: the statement's inline pieces grow into the desktop window.
  rowFlip = frame {
    title: "Statement → window · scrubbed over ~900px",
    width: .auto,
    height: .auto,
    layout: {stack: {item-gap: 40px}},
    children: [flipA, flipB, flipC],

    flipA = frame {
      title: "Words read",
      caption: "Words resolve left to right, blur and tint to ink",
      width: 720px,
      height: 450px,
      fill: rgb(98.0392%, 98.0392%, 98.0392%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: flipAStatement,

      flipAStatement = frame : home.page.statement {
        left: 0px,
        top: -10px,
        width: 1440px,
        transform: [0.5, 0, 0, 0, 0.5, 0],

        lineTwo {
          lineTwoB {
            filter[0].type: .gaussian-blur,
            fill[0].linear-gradient.from: [0%, 50%],
            fill[0].linear-gradient.stops[2].position: 100%,
            fill[0].linear-gradient.stops[1].position: 40%,
            fill[0].linear-gradient.stops[0].position: 0%,
            filter[0].radius: 4px,
            fill[0].linear-gradient.to: [100%, 50%],
            fill[0].linear-gradient.stops[2].color: rgb(49.8%, 82.7451%, 96.0784%),
            fill[0].linear-gradient.stops[1].color: rgb(60.78%, 54.9%, 92.1569%),
            fill[0].linear-gradient.stops[0].color: rgb(5.88%, 5.88%, 5.88%)
          }
        }
      }
    }

    flipB = frame {
      title: "+450px",
      caption: "Pieces scale up and travel; the window rises from 0.92",
      width: 720px,
      height: 450px,
      fill: rgb(98.0392%, 98.0392%, 98.0392%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: [flipBWindow, flipBSend, flipBHost],

      flipBWindow = frame : home.page.desktop {
        left: 50px,
        top: 150px,
        opacity: 0.85,
        transform: [0.46, 0, 0, 0, 0.46, 0]
      }

      flipBSend = frame : home.page.statement.lineOne.inlineSend {
        left: 520px,
        top: 250px,
        transform: [0.8, 0, 0, 0, 0.8, 0]
      }

      flipBHost = frame : home.page.statement.lineTwo.inlineHost {
        left: 150px,
        top: 300px,
        transform: [0.8, 0, 0, 0, 0.8, 0]
      }
    }

    flipC = frame {
      title: "+900px",
      caption: "Landed in the composer; the turn starts playing",
      width: 720px,
      height: 450px,
      fill: rgb(98.0392%, 98.0392%, 98.0392%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: flipCWindow,

      flipCWindow = frame : home.page.desktop {
        left: 32px,
        top: 70px,
        transform: [0.5, 0, 0, 0, 0.5, 0]
      }
    }
  }

  // 4. Pin: where the host runs, stepped by scroll progress.
  rowPin = frame {
    title: "Where the host runs · pinned for ~1200px",
    width: .auto,
    height: .auto,
    layout: {stack: {item-gap: 40px}},
    children: [pinA, pinB, pinC],

    pinA = frame {
      title: "0–33%",
      width: 720px,
      height: 450px,
      fill: rgb(98.0392%, 98.0392%, 98.0392%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: pinADeploy,

      pinADeploy = frame : home.page.deploy {
        left: 32px,
        top: -60px,
        transform: [0.5, 0, 0, 0, 0.5, 0],

        deployCopy {
          deployServer {
            fill[0].color: rgb(5.88%, 5.88%, 5.88%, 30.1961%)
          }

          deployMac {
            fill[0].color: rgb(5.88%, 5.88%, 5.88%)
          }

          deployServerBody {
            contents: "SQLite on your Mac. The desktop app and the terminal share it."
          }
        }

        deployCard {
          hostServer {
            border[0].color: rgb(21.96%, 51.76%, 82.35%, 0%),
            opacity: 0.6
          }

          hostMac {
            border[0].color: rgb(21.96%, 51.76%, 82.35%),
            border[0].width: 2px,
            opacity: 1
          }
        }
      }
    }

    pinB = frame {
      title: "33–66%",
      width: 720px,
      height: 450px,
      fill: rgb(98.0392%, 98.0392%, 98.0392%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: pinBDeploy,

      pinBDeploy = frame : home.page.deploy {
        left: 32px,
        top: -60px,
        transform: [0.5, 0, 0, 0, 0.5, 0]
      }
    }

    pinC = frame {
      title: "66–100%",
      width: 720px,
      height: 450px,
      fill: rgb(98.0392%, 98.0392%, 98.0392%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: pinCDeploy,

      pinCDeploy = frame : home.page.deploy {
        left: 32px,
        top: -60px,
        transform: [0.5, 0, 0, 0, 0.5, 0],

        deployCopy {
          deployCloud {
            fill[0].color: rgb(5.88%, 5.88%, 5.88%)
          }

          deployServer {
            fill[0].color: rgb(5.88%, 5.88%, 5.88%, 30.1961%)
          }

          deployServerBody {
            contents: "Vercel runs each busy branch as a durable workflow."
          }
        }

        deployCard {
          hostCloud {
            border[0].color: rgb(21.96%, 51.76%, 82.35%),
            border[0].width: 2px,
            opacity: 1
          }

          hostServer {
            border[0].color: rgb(21.96%, 51.76%, 82.35%, 0%),
            opacity: 0.6
          }
        }
      }
    }
  }

  // 5. Curtain: the page panel scrolls up off the fixed footer.
  rowCurtain = frame {
    title: "Footer curtain",
    width: .auto,
    height: .auto,
    layout: {stack: {item-gap: 40px}},
    children: [curtainA, curtainB],

    curtainA = frame {
      title: "Panel over the footer",
      width: 720px,
      height: 450px,
      fill: rgb(92.549%, 92.549%, 92.549%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: [curtainAFooter, curtainAPanel],

      curtainAFooter = frame : home.footer {
        left: 0px,
        top: 60px,
        width: 1440px,
        transform: [0.5, 0, 0, 0, 0.5, 0]
      }

      curtainAPanel = frame {
        left: 0px,
        top: -40px,
        width: 720px,
        height: 360px,
        fill: rgb(98.0392%, 98.0392%, 98.0392%),
        shadow: {
          drop-shadow: {
            color: rgb(5.88%, 5.88%, 5.88%, 7.84%),
            offset: point(0px, 10px),
            blur-radius: 30px
          }
        },
        corner-radius: [0px, 0px, 24px, 24px]
      }
    }

    curtainB = frame {
      title: "Panel gone",
      caption: "The glow drifts under the wordmark",
      width: 720px,
      height: 450px,
      fill: rgb(92.549%, 92.549%, 92.549%),
      border: rgb(5.88%, 5.88%, 5.88%, 7.84%),
      corner-radius: 12px,
      overflow: .clip,
      children: curtainBFooter,

      curtainBFooter = frame : home.footer {
        left: 0px,
        top: -80px,
        width: 1440px,
        transform: [0.5, 0, 0, 0, 0.5, 0]
      }
    }
  }
}

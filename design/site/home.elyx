                    stack: {
                      justify-content: .space-between,
                      align-items: .center
                    }
                  },
                  border: {color: c.role.stroke-quaternary, sides: .bottom},
                  padding: [0px, 8px, 0px, 10px],
                  children: [shellHeadLead, shellHeadActions],

                  shellHeadLead = frame {
                    width: .auto,
                    height: .auto,
                    layout: {stack: {align-items: .center, item-gap: 8px}},

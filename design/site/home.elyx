            railChanges = frame {
              width: 100%,
              height: 28px,
              layout: {stack: {align-items: .center, item-gap: 8px}},
              padding: [0px, 6px],
              children: [railChangesIcon, railChangesText],

              railChangesIcon = asset {
                width: 14px,
                height: 14px,
                fill: c.role.content-secondary,
                contents: iconBranch
              }

              railChangesText = text {
                fill: c.role.content-secondary,
                subrange: [
                  {range: [9, 11], fill: intent.success.content-tertiary},

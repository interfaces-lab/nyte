            forkChatCMeta = text {
              fill: c.role.content-tertiary,
              contents: "3h",
              font-size: 11,
              font-family: "Inter Variable"
            }
          }
        }
      }

      forkCopy = frame {
        width: 500px,
        height: .auto,
        layout: {stack: {direction: .column, item-gap: 26px}},
        children: [forkEyebrow, forkTitle, forkBody],

        forkEyebrow = text {

            railNewTerminal = frame {
              width: 100%,
              height: 28px,
              layout: {stack: {align-items: .center, item-gap: 8px}},
              padding: [0px, 6px],
              children: [railNewTerminalIcon, railNewTerminalText],

              railNewTerminalIcon = asset {
                width: 14px,
                height: 14px,
                fill: c.role.content-secondary,
                contents: iconConsole
              }

              railNewTerminalText = text {
                fill: c.role.content-secondary,
                contents: "New Terminal",
                font-size: 13,
                font-family: "Inter Variable"
              }
            }
          }
        }
      }
    }

    // Forking, as the desktop shows it: the fork action under a reply, and the fork nested under its chat.
    fork = frame {
      doc: "Motion: the left card is sticky while the copy scrolls past. Lines reveal (translateY 0.6em→0, opacity 0→1, scrubbed over ~300px, 100px apart). At 50% progress the fork button takes its hover fill, the tooltip fades up 4px (150ms), and 'Try a fake timer' slides into the Chats list (height 0→28px, 250ms cubic-bezier(0.16,1,0.3,1)) already selected.",
      width: 1310px,
      height: .auto,
      layout: {stack: {align-items: .center, item-gap: 136px}},
      padding-top: 210px,
      children: [forkCard, forkCopy],

      forkCard = frame {
        width: 640px,
        height: 460px,
        fill: rgb(92.94%, 92.94%, 92.94%),
        corner-radius: 32px,
        overflow: .clip,
        children: [forkReply, forkChats, forkTooltip],

        forkReply = frame {
          left: 48px,
          top: 52px,
          width: 470px,
          height: .auto,
          layout: {stack: {direction: .column, item-gap: 12px}},
          fill: c.role.bg-base,
          shadow: {
            drop-shadow: {
              color: rgb(5.88%, 5.88%, 5.88%, 7.84%),
              offset: point(0px, 14px),
              blur-radius: 32px
            }
          },
          corner-radius: 16px,
          padding: [16px, 18px, 14px],
          children: [forkReplyBubble, forkReplyText, forkReplyActions],

          forkReplyBubble = frame {
            width: 100%,
            height: .auto,
            layout: {stack: {direction: .column}},
            border: c.role.stroke-tertiary,
            corner-radius: 12px,
            padding: [9px, 12px],
            children: forkReplyBubbleText,

            forkReplyBubbleText = text {
              fill: c.role.content-primary,
              contents: "fix the flaky checkout test",
              font-size: 15,
              font-family: "Inter Variable"
            }
          }

          forkReplyText = text {
            width: 100%,
            fill: c.role.content-primary,
            contents: "The test sleeps 50 ms and races the cart total.",
            font-size: 15,
            font-family: "Inter Variable",
            line-height: 1.6
          }

          forkReplyActions = frame {
            width: .auto,
            height: 28px,
            layout: {stack: {align-items: .center, item-gap: 8px}},
            children: [forkActionCopy, forkActionFork, forkActionTime],

            forkActionCopy = frame {
              width: 28px,
              height: 28px,
              layout: {stack: {justify-content: .center, align-items: .center}},
              children: forkActionCopyIcon,

              forkActionCopyIcon = asset {
                width: 14px,
                height: 14px,
                fill: c.role.content-tertiary,
                contents: iconCopy
              }
            }

            forkActionFork = frame {
              width: 28px,
              height: 28px,
              layout: {stack: {justify-content: .center, align-items: .center}},
              fill: c.role.fill-tertiary,
              corner-radius: 8px,
              children: forkActionForkIcon,

              forkActionForkIcon = asset {
                width: 14px,
                height: 14px,
                fill: c.role.content-primary,
                contents: iconFork
              }
            }

            forkActionTime = text {
              fill: c.role.content-tertiary,
              contents: "4m ago",
              font-size: 13,
              font-family: "Inter Variable"
            }
          }
        }

        forkTooltip = frame {
          left: 64px,
          top: 184px,
          width: .auto,
          height: 26px,
          layout: {stack: {align-items: .center}},
          fill: c.role.content-primary,
          shadow: {
            drop-shadow: {
              color: rgb(5.88%, 5.88%, 5.88%, 16.0784%),
              offset: point(0px, 4px),
              blur-radius: 10px
            }
          },
          corner-radius: 6px,
          padding: [0px, 8px],
          children: forkTooltipText,

          forkTooltipText = text {
            fill: c.role.bg-base,
            contents: "Fork from here",

            }

            // The composer dock: a 40px pill with attach, the model picker and send, and the host under it.
            dock = frame {
              width: 100%,
              height: .auto,
              layout: {stack: {direction: .column, item-gap: 6px}},
              children: [composer, hostPicker],

              composer = frame {
                width: 100%,
                height: 44px,
                layout: {
                  stack: {justify-content: .space-between, align-items: .center}
                },
                fill: c.role.bg-elevated,
                border: c.role.stroke-tertiary,
                shadow: {
                  drop-shadow: {
                    color: rgb(5.88%, 5.88%, 5.88%, 3.92%),
                    offset: point(0px, 2px),
                    blur-radius: 8px
                  }
                },
                corner-radius: 22px,
                padding: [0px, 6px],
                children: [composerLead, composerTrail],

                composerLead = frame {
                  width: .auto,
                  height: .auto,
                  layout: {stack: {align-items: .center, item-gap: 10px}},
                  children: [composerAttach, composerPlaceholder],

                  composerAttach = frame {
                    width: 32px,
                    height: 32px,
                    layout: {
                      stack: {justify-content: .center, align-items: .center}
                    },
                    fill: c.role.fill-tertiary,
                    corner-radius: 16px,
                    children: composerAttachIcon,

                    composerAttachIcon = asset {
                      width: 14px,
                      height: 14px,
                      fill: c.role.content-secondary,
                      contents: iconPlus
                    }
                  }

                  composerPlaceholder = text {
                    fill: c.role.content-tertiary,
                    contents: "Add a follow-up",
                    font-size: 15,
                    font-family: "Inter Variable"
                  }
                }

                composerTrail = frame {
                  width: .auto,
                  height: .auto,
                  layout: {stack: {align-items: .center, item-gap: 14px}},
                  children: [modelPicker, sendButton],

                  modelPicker = frame {
                    width: .auto,
                    height: .auto,
                    layout: {stack: {align-items: .center, item-gap: 5px}},
                    children: [modelName, modelChevron],

                    modelName = text {
                      fill: c.role.content-secondary,
                      contents: "Claude Opus",
                      font-size: 14,
                      font-family: "Inter Variable"
                    }

                    modelChevron = asset {
                      width: 11px,
                      height: 11px,
                      fill: c.role.content-tertiary,
                      contents: iconChevronDown
                    }
                  }

                  sendButton = frame {
                    width: 32px,
                    height: 32px,
                    layout: {
                      stack: {justify-content: .center, align-items: .center}
                    },
                    fill: intent.primary.button-fill,
                    corner-radius: 16px,
                    children: sendIcon,

                    sendIcon = asset {
                      width: 15px,
                      height: 15px,
                      fill: .white,
                      contents: iconArrowUp
                    }
                  }
                }
              }

              hostPicker = frame {
                width: .auto,
                height: 22px,
                layout: {stack: {align-items: .center, item-gap: 6px}},
                padding-left: 10px,
                children: [hostPickerIcon, hostPickerLabel, hostPickerChevron],

                hostPickerIcon = asset {
                  width: 14px,
                  height: 14px,
                  fill: c.role.content-secondary,
                  contents: iconLaptop
                }

                hostPickerLabel = text {
                  fill: c.role.content-secondary,
                  contents: "This Mac",
                  font-size: 13,
                  font-family: "Inter Variable"
                }

                hostPickerChevron = asset {
                  width: 10px,
                  height: 10px,
                  fill: c.role.content-tertiary,
                  contents: iconChevronDown
                }
              }
            }
          }

          // The context rail: usage, then what's open and what's on this host.
          rail = frame {
            width: 246px,
            height: 100%,
            layout: {stack: {direction: .column, item-gap: 2px}},
            padding: [12px, 16px, 16px],
            children: [
              railCost,
              railUsage,
              railGap,
              railOpen,
              railTerminal,
              railGapB,
              railHome,
              railEditor,
              railChanges,
              railNewTerminal
            ],

            railCost = frame {
              width: 100%,
              height: 28px,
              layout: {stack: {align-items: .center, item-gap: 8px}},
              padding: [0px, 6px],
              children: [railCostIcon, railCostText],

              railCostIcon = asset {
                width: 14px,
                height: 14px,
                fill: c.role.content-secondary,
                contents: iconSpeed
              }

              railCostText = text {
                fill: c.role.content-primary,
                contents: "$0.04",
                font-size: 13,
                font-family: "Inter Variable"
              }
            }

            railUsage = frame {
              width: 100%,
              height: 28px,
              layout: {stack: {align-items: .center, item-gap: 8px}},
              padding: [0px, 6px],
              children: [railUsageIcon, railUsageText],

              railUsageIcon = asset {
                width: 14px,
                height: 14px,
                fill: c.role.content-secondary,
                contents: iconRuler
              }

              railUsageText = text {
                fill: c.role.content-primary,
                subrange: {range: [10, 20], fill: c.role.content-tertiary},
                contents: "4% used  8.1K / 200K",
                font-size: 13,
                font-family: "Inter Variable"
              }
            }

            railGap = frame {
              width: 10px,
              height: 14px
            }

            railOpen = text {
              fill: c.role.content-tertiary,
              contents: "Open Tabs",
              font-size: 13,
              font-family: "Inter Variable"
            }

            railTerminal = frame {
              width: 100%,
              height: 28px,
              layout: {stack: {align-items: .center, item-gap: 8px}},
              padding: [0px, 6px],
              children: [railTerminalIcon, railTerminalText],

              railTerminalIcon = asset {
                width: 14px,
                height: 14px,
                fill: c.role.content-secondary,
                contents: iconConsole
              }

              railTerminalText = text {
                fill: c.role.content-secondary,
                contents: "Terminal",
                font-size: 13,
                font-family: "Inter Variable"
              }
            }

            railGapB = frame {
              width: 10px,
              height: 14px
            }

            railHome = text {
              fill: c.role.content-tertiary,
              contents: "On This Mac",
              font-size: 13,
              font-family: "Inter Variable"
            }

            railEditor = frame {

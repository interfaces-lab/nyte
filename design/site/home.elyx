              chatE = frame {
                width: 100%,
                height: 28px,
                layout: {
                  stack: {justify-content: .space-between, align-items: .center}
                },
                corner-radius: 8px,
                padding: [0px, 6px],
                children: [chatELead, chatEMeta],

                chatELead = frame {
                  width: .auto,
                  height: .auto,

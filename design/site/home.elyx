                contents: "Fixed. The test now waits for the cart instead of a timer, and passed 42 of 42 runs.",
                font-size: 15,
                font-family: "Inter Variable",
                line-height: 1.6
              }

              actions = frame {
                width: .auto,
                height: 24px,
                layout: {stack: {align-items: .center, item-gap: 14px}},
                padding-left: 4px,
                children: [actionCopy, actionFork, actionTime],

                actionCopy = asset {

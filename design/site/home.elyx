            titleSplitDown = asset {
              width: 16px,
              height: 16px,
              fill: c.role.content-secondary,
              contents: iconSplitDown
            }

            titleBell = asset {
              width: 16px,
              height: 16px,
              fill: c.role.content-secondary,
              contents: iconBell
            }

            titlePanelRight = asset {
              width: 16px,
              height: 16px,
              fill: c.role.content-secondary,
              contents: iconPanelRight
            }
          }
        }

        body = frame {
          width: 100%,
          height: 640px,
          layout: {stack: {}},
          children: [conversation, rail],

          conversation = frame {
            width: 808px,
            height: 100%,
            layout: {
              stack: {direction: .column, justify-content: .space-between}
            },
            padding: [12px, 16px, 16px],
            children: [turn, dock],

            turn = frame {
              width: 100%,
              height: .auto,
              layout: {stack: {direction: .column, item-gap: 14px}},
              children: [
                userBubble,
                prose,
                explored,
                toolRead,
                toolEdit,
                shellCard,
                answer,
                actions
              ],

              userBubble = frame {
                width: 100%,
                height: .auto,
                layout: {stack: {direction: .column}},
                fill: c.role.bg-elevated,
                border: c.role.stroke-tertiary,
                corner-radius: 12px,
                padding: [10px, 12px],
                children: userBubbleText,

                userBubbleText = text {
                  fill: c.role.content-primary,
                  contents: "fix the flaky checkout test",
                  font-size: 15,
                  font-family: "Inter Variable",
                  line-height: 1.4
                }
              }

              prose = text {
                width: 100%,
                fill: c.role.content-primary,
                contents: "The test sleeps 50 ms and races the cart total. I'll wait for the cart to settle instead.",
                font-size: 15,
                font-family: "Inter Variable",
                line-height: 1.6
              }

              explored = frame {
                width: .auto,
                height: 22px,
                layout: {stack: {align-items: .center, item-gap: 4px}},
                children: [exploredText, exploredChevron],

                exploredText = text {
                  fill: c.role.content-secondary,
                  contents: "Explored checkout.test.ts, ran 2 tools",
                  font-size: 15,
                  font-family: "Inter Variable"
                }

                exploredChevron = asset {
                  width: 12px,
                  height: 12px,
                  fill: c.role.content-tertiary,
                  contents: iconChevronDown
                }
              }

              toolRead = text {
                fill: c.role.content-secondary,
                subrange: {range: [5, 21], fill: c.role.content-tertiary},
                contents: "Read checkout.test.ts",
                font-size: 15,
                font-family: "Inter Variable"
              }

              toolEdit = text {
                fill: c.role.content-secondary,
                subrange: [
                  {range: [7, 18], fill: c.role.content-tertiary},
                  {range: [20, 22], fill: intent.success.content-tertiary},
                  {range: [23, 25], fill: intent.danger.content-tertiary}
                ],
                contents: "Edited checkout.ts  +4 −2",
                font-size: 15,
                font-family: "Inter Variable"
              }

              shellCard = frame {
                width: 100%,
                height: .auto,
                layout: {stack: {direction: .column}},

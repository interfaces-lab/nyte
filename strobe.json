{
  "$schema": "packages/desktop/node_modules/@hona/strobe/schema/strobe.v1.json",
  "apps": {
    "nyte": {
      "exe": {
        "macos": "${PWD}/packages/desktop/dist/mac-arm64/Nyte Bench.app/Contents/MacOS/Nyte Bench"
      },
      "args": ["--user-data-dir={home}/user-data"],
      "unset": ["NYTE_*"],
      "env": { "NYTE_HOME": "{home}/.nyte", "NYTE_OFFLINE": "1" },
      "files": { ".nyte/settings.json": { "autoUpdate": false } }
    }
  }
}

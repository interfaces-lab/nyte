{
  "name": "nyte",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build --filter=@nyte-ai/tui --filter=@nyte-ai/desktop",
    "build:tui": "turbo build --filter=@nyte-ai/tui",
    "build:desktop": "turbo build --filter=@nyte-ai/desktop",
    "package": "turbo package --filter=@nyte-ai/tui --filter=@nyte-ai/desktop",
    "package:tui": "turbo package --filter=@nyte-ai/tui",
    "package:desktop": "turbo package --filter=@nyte-ai/desktop",
    "package:desktop:dev": "pnpm --dir packages/desktop package:dev",
    "clean": "turbo clean",
    "dev:tui": "pnpm --filter @nyte-ai/tui dev",
    "dev:desktop": "pnpm --filter @nyte-ai/desktop dev",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "knip": "pnpm dlx knip@6.41.0",
    "cycles": "node scripts/check-cycles.mjs",
    "models:generate": "turbo models:generate --filter=@nyte-ai/ai",
    "docs:dep": "node scripts/dependency-docs.mjs",
    "docs:dep:test": "node --test scripts/dependency-docs.test.mjs",
    "bench:desktop": "pnpm --dir packages/desktop bench",
    "e2e": "pnpm --dir packages/app e2e",
    "e2e:desktop": "pnpm --dir packages/desktop e2e",
    "typecheck": "turbo typecheck",
    "sdk:check": "bun scripts/sdk-packages.mjs check",
    "sdk:pack": "bun scripts/sdk-packages.mjs pack",
    "sdk:verify": "bun scripts/verify-sdk-packages.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.87.0",
    "@shadcn/lint": "0.2.1",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "turbo": "^2.11.7",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.11.2",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}

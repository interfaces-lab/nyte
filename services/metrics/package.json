{
  "name": "@nyte-ai/metrics",
  "private": true,
  "description": "A Cloudflare Worker over D1 that counts anonymous Nyte installs and opt-in daily usage, and serves the aggregate stats as public JSON.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules .turbo .wrangler dist",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply nyte-metrics --remote"
  },
  "dependencies": {
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^26.6.6",
    "wrangler": "^4.163.0"
  }
}

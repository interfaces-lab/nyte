+/**
+ * What this client knows about its own messages between Enter and the watch.
+ *
+ * The outbox holds a message as `sending` until the store's receipt names its
+ * change; the watch then shows that change as pending, and later landed or
+ * cancelled. The two arrive in either order, so the receipt is remembered by
+ * identity, the change, and never matched on content. A remembered message is
+ * drawn until the watch shows it, so a row cannot blink out between the reply
+ * and the fold; and it lends the fold's item the key that named it while
+ * sending, so one block carries the message across the receipt.
+ */
+import type { Oid, PendingItem, SendReceipt } from "@nyte-ai/core";
+import type { OutboxEntry } from "./outbox.ts";
+import { gutterRows } from "./pending-gutter.ts";
+import type { GutterRow } from "./pending-gutter.ts";
+
+interface SentMessage {
+  /** The key that named the message while it was sending. */
+  readonly key: string;
+  readonly item: PendingItem;
+}
+
+export class SentMessages {
+  /** By the change the receipt named. An entry leaves with its change: landed, cancelled, or absent from a snapshot. */
+  private readonly sent = new Map<Oid, SentMessage>();
+  /**
+   * Changes the watch settled while a send was still in flight. A receipt
+   * that arrives after its change landed or was cancelled draws nothing.
+   * Cleared when the outbox drains, so it holds at most what settled during
+   * one send.
+   */
+  private readonly settledInFlight = new Set<Oid>();
+  /**
+   * Keys whose send spanned a snapshot. The snapshot may hold what their
+   * receipts name, or have landed it with no event to say so; the receipt
+   * draws nothing and the watch shows the message.
+   */
+  private readonly spannedSnapshot = new Set<string>();
+
+  /** The store answered a send. `duplicate` answers a retry whose first attempt reached the store; it is as durable as `queued`. */
+  receipt(entry: OutboxEntry, receipt: SendReceipt): void {
+    if (this.spannedSnapshot.delete(entry.key)) return;
+    if (this.settledInFlight.has(receipt.change)) return;
+    this.sent.set(receipt.change, {
+      key: entry.key,
+      item: { change: receipt.change, lane: entry.lane, at: entry.at, content: entry.content },
+    });
+  }
+
+  /** The watch landed or cancelled the change; a receipt still in flight must not draw it again. */
+  settled(change: Oid, sending: readonly OutboxEntry[]): void {
+    this.sent.delete(change);
+    if (sending.length > 0) this.settledInFlight.add(change);
+  }
+
+  /** A snapshot replaced the fold: what it does not hold as pending is gone, and events before it were never seen. */
+  snapshot(pending: readonly PendingItem[], sending: readonly OutboxEntry[]): void {
+    for (const change of this.sent.keys()) {
+      if (!pending.some((item) => item.change === change)) this.sent.delete(change);
+    }
+    this.settledInFlight.clear();
+    for (const entry of sending) this.spannedSnapshot.add(entry.key);
+  }
+
+  /** The set of sending messages changed. */
+  sending(entries: readonly OutboxEntry[]): void {
+    if (entries.length === 0) {
+      this.settledInFlight.clear();
+      this.spannedSnapshot.clear();
+      return;
+    }
+    for (const key of this.spannedSnapshot) {
+      if (!entries.some((entry) => entry.key === key)) this.spannedSnapshot.delete(key);
+    }
+  }
+
+  /** The fold's pending items, then receipts the fold has not caught up with, then what is still sending. */
+  rows(pending: readonly PendingItem[], sending: readonly OutboxEntry[]): GutterRow[] {
+    const arriving = [...this.sent.values()]
+      .filter((sent) => !pending.some((item) => item.change === sent.item.change))
+      .map((sent) => sent.item);
+    return gutterRows([...pending, ...arriving], sending, (change) => this.sent.get(change)?.key);
+  }
+}

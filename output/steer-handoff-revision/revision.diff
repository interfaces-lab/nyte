+    };
+    root.onMouseDragEnd = (event) => {
+      const drag = this.drag;
+      this.drag = undefined;
+      if (drag === undefined || !drag.moving) return;
+      const index = this.blocks.findIndex(
+        (block) => event.y >= block.root.y && event.y < block.root.y + block.root.height,
+      );

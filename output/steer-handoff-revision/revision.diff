+import { describe, expect, test } from "bun:test";
+import type { PendingItem, SendReceipt } from "@nyte-ai/core";
+import { Outbox } from "./outbox.ts";
+import { SentMessages } from "./sent-messages.ts";
+
+/** Waits for the outbox's own continuations after an answer or a failure. */
+const flush = () => new Promise<void>((resolve) => setTimeout(resolve, 0));
+
+/**
+ * An outbox whose store answers when the test says, so the receipt and the
+ * watch can arrive in either order.
+ */
+function harness() {
+  const sent = new SentMessages();
+  const answers: PromiseWithResolvers<SendReceipt>[] = [];
+  const keys = ["key-1", "key-2", "key-3"];
+  const outbox = new Outbox({
+    send: () => {
+      const answer = Promise.withResolvers<SendReceipt>();
+      answers.push(answer);
+      return answer.promise;
+    },
+    sleep: () => Promise.resolve(),
+    now: () => 1_000,
+    mintKey: () => keys.shift() ?? "key-late",
+    onReceipt: (entry, receipt) => sent.receipt(entry, receipt),
+    onChange: (entries) => sent.sending(entries),
+  });
+  const rows = (pending: readonly PendingItem[]) =>
+    sent
+      .rows(pending, outbox.entries)
+      .map((row) =>
+        row.kind === "sending"
+          ? `sending:${row.entry.key}`
+          : `pending:${row.item.change}${row.key === undefined ? "" : `@${row.key}`}`,
+      );
+  return { sent, outbox, answers, rows };

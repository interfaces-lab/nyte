# Keep this block the same in .gitignore and .vercelignore.

# Dependencies, builds and caches
node_modules/
dist/
out/
out-e2e/
.turbo/
.next/
.output/
.nitro/
.source/
.tanstack/
.wrangler/
.vercel
.pnpm-store/
.cache/
*.tsbuildinfo
*.log
*.log.[0-9]*
playwright-report/
test-results/
__pycache__/
*.pyc
.DS_Store

# Secrets
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# Anything personal or machine-specific lives in a .local folder
.local/

# Written by scripts
*.generated*
/packages/*/LICENSE
/packages/*/THIRD-PARTY-NOTICES.md

# Git only: the lab stays on your machine, and `vercel deploy` still uploads it.
/packages/lab/

# The brand kit and what `pnpm brand` draws stay on your machine
/scripts/brand/
/output/brand/

# The Good Nyte pages stay on your machine
/services/web/src/components/good-nyte/
/services/web/src/lib/visitor.ts
/services/web/src/routes/good-nyte.tsx
/services/web/src/routes/_site/_landing/good-nyte-3.tsx
/services/web/src/styles/good-nyte.css

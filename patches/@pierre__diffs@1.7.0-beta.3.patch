+import { SearchPanelMode } from "./index.js";
+//#region src/search/headlessSearch.d.ts
+interface CodeViewSearchQuery {
+  readonly text: string;
+  readonly caseSensitive: boolean;
+  readonly wholeWord: boolean;
+  readonly regex: boolean;
+}
+interface CodeViewSearchSnapshot {
+  readonly total: number;
+  /** Index of the focused match in `total`, or undefined before navigation. */
+  readonly current: number | undefined;
+  /** A regex query that does not compile. */
+  readonly invalid: boolean;
+  /** `find` whenever the scope has no edit-mode item to replace in. */
+  readonly mode: SearchPanelMode;
+  readonly canReplace: boolean;
+  readonly defaultQuery: string;
+  /** Bumped each time the search is reopened, so the host can refocus its input. */
+  readonly openRevision: number;
+  /** False once the CodeView closed the search, e.g. on Escape. */
+  readonly open: boolean;
+}
+interface CodeViewSearch {
+  readonly getSnapshot: () => CodeViewSearchSnapshot;
+  readonly subscribe: (listener: () => void) => () => void;
+  setQuery(query: CodeViewSearchQuery | undefined): void;
+  next(): void;
+  previous(): void;
+  setReplaceText(text: string): void;
+  replace(): void;
+  replaceAll(): void;
+  setMode(mode: SearchPanelMode): void;
+  close(): void;
+}

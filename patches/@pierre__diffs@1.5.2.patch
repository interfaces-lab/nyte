+//#region src/components/CodeViewSearch.d.ts
+interface CodeViewSearchQuery {
+  text: string;
+  caseSensitive?: boolean;
+  wholeWord?: boolean;
+  regex?: boolean;
+}
+interface CodeViewSearchSnapshot {
+  /** The active query, or undefined when no search is running. */
+  readonly query: CodeViewSearchQuery | undefined;
+  readonly total: number;
+  /** Index of the current match in `0..total`, or undefined when none is current. */
+  readonly current: number | undefined;
+  /** The search stopped at its match limit, so `total` is a lower bound. */
+  readonly capped: boolean;
+  /** `regex` is set and `text` is not a valid pattern. */
+  readonly invalid: boolean;
+}
+/**
+ * Headless find-in-diff for a CodeView. It searches every diff item's lines,
+ * including virtualized rows and collapsed items, paints matches with the CSS
+ * Custom Highlight API (`::highlight(diffs-search-match)` and
+ * `::highlight(diffs-search-focus)`, coloured by `--diffs-search-match-bg` and
+ * `--diffs-search-focus-bg`), and reveals the current match. The host renders
+ * its own find UI from `getSnapshot` and `subscribe`.
+ */
+declare class CodeViewSearch {
+  readonly getSnapshot: () => CodeViewSearchSnapshot;
+  readonly subscribe: (listener: () => void) => () => void;
+  setQuery(query: CodeViewSearchQuery | undefined): void;
+  next(): void;
+  previous(): void;
+  goTo(index: number): void;
+  clear(): void;
+}
+//#endregion
+export { CodeViewSearch, CodeViewSearchQuery, CodeViewSearchSnapshot };

@@ -0,0 +1,94 @@
+import type { LineAnnotation, RenderRange } from "../types.js";
+interface SourceLineSpan {
+  readonly startLine: number;
+  readonly endLine: number;
+}
+interface HiddenFileRows extends SourceLineSpan {
+  readonly headerLine: number;
+}
+interface FileAnnotationBlock {
+  readonly kind: "annotation";
+  readonly id: string;
+  readonly afterLine: number;
+  readonly slotNames: readonly string[];
+}
+interface FileRemovedBlock {
+  readonly kind: "removed";
+  readonly id: string;
+  readonly afterLine: number;
+  readonly oldStartLine: number;
+  readonly lines: readonly string[];
+}
+type FileRowBlock = (FileAnnotationBlock & {
+  readonly lifetime: "persistent" | "transient";
+  readonly height: number;
+  readonly precision?: "estimated" | "measured";
+}) | (FileRemovedBlock & { readonly heights?: ReadonlyMap<number, number> });
+type FileViewBlock = FileRemovedBlock | FileAnnotationBlock;
+interface FileRowPresentation<LAnnotation = undefined> {
+  readonly contents: string;
+  readonly hidden?: readonly HiddenFileRows[];
+  readonly blocks?: readonly FileViewBlock[];
+  readonly added?: readonly SourceLineSpan[];
+  readonly annotations?: readonly LineAnnotation<LAnnotation>[];
+}
+interface FileRowLayoutInput {
+  readonly lineCount: number;
+  readonly lineHeight: number;
+  readonly heights?: ReadonlyMap<number, number>;
+  readonly hidden?: readonly HiddenFileRows[];
+  readonly blocks?: readonly FileRowBlock[];
+}
+interface FileRowMeasurements {
+  readonly source?: readonly { readonly lineNumber: number; readonly height: number }[];
+  readonly removed?: readonly { readonly id: string; readonly oldLineNumber: number; readonly height: number }[];
+  readonly annotations?: readonly { readonly id: string; readonly height: number }[];
+}
+interface FileRowGeometry {
+  readonly top: number;
+  readonly height: number;
+  readonly precision: "estimated" | "measured";
+  readonly layoutRevision: number;
+}
+type FileRowHit = FileRowGeometry & (
+  | { readonly kind: "source"; readonly lineNumber: number }
+  | { readonly kind: "removed"; readonly id: string; readonly ownerLine: number; readonly oldLineNumber: number }
+  | { readonly kind: "annotation"; readonly id: string; readonly ownerLine: number }
+);
+type FileRenderSlice = FileRowGeometry & (
+  | { readonly kind: "source"; readonly startLine: number; readonly endLine: number }
+  | { readonly kind: "removed"; readonly id: string; readonly ownerLine: number; readonly oldStartLine: number; readonly oldEndLine: number }
+  | { readonly kind: "annotation"; readonly id: string; readonly ownerLine: number; readonly afterLine: number }
+);
+declare class FileRowLayout {
+  readonly lineCount: number;
+  readonly height: number;
+  readonly revision: number;
+  private segments;
+  private sourceSegments;
+  private blockSegments;
+  private pixels;
+  constructor(input: FileRowLayoutInput);
+  rebuild(input: FileRowLayoutInput): void;
+  updateMeasurements(measurements: FileRowMeasurements): boolean;
+  private findSource;
+  isLineRenderable(lineNumber: number): boolean;
+  getNearestRenderableLine(lineNumber: number, direction: "up" | "down"): number | undefined;
+  getHiddenHeader(lineNumber: number): number | undefined;
+  resolveRenderableLine(line: number, direction: "up" | "down"): number | undefined;
+  getLinePosition(lineNumber: number): FileRowGeometry | undefined;
+  rowAt(y: number): FileRowHit | undefined;
+  window(top: number, bottom: number): FileRenderSlice[];
+  renderRange(top: number, bottom: number): RenderRange & { readonly fileRows: readonly FileRenderSlice[] };
+}
+declare function createFileAnnotationBlocks<Annotation extends { readonly lineNumber: number }>(input: {
